    1749/    24F4 :                     ; ---------------------------------------------------------------------------
    1750/    24F4 :                     ; Subroutine to wait for VBlank routines to complete
    1751/    24F4 :                     ; ---------------------------------------------------------------------------
    1752/    24F4 :                     
    1753/    24F4 :                     ; DelayProgram: <--- old misnomer
    1754/    24F4 :                     ; WaitForVBla: <--- old name
    1755/    24F4 :                     WaitForVBlank:
    1756/    24F4 : (MACRO)              		enable_ints					; enable interrupts so vertical interrupts can occur
    1756/    24F4 : 46FC 2300                           move.w  #$2300,sr
    1757/    24F8 :                     
    1758/    24F8 : 4AB8 F680           		tst.l	(v_plc_buffer).w			; are any PLC jobs queued?
    1759/    24FC : 6716                		beq.s	.wait					; if not, branch
    1760/    24FE : 4A38 F6FB           		tst.b	(v_plc_Busy).w				; has PLC DMA missed the previous frame?
    1761/    2502 : 6610                		bne.s	.wait					; if yes, don't advance PLC this frame
    1762/    2504 : 6100 F4B4           		bsr.w	ExecutePLC				; decompress the next PLC entry and queue it for DMA
    1763/    2508 : 4A38 F62A           		tst.b	(v_vblank_routine).w			; has VBlank interrupt occurred while PLC was running?
    1764/    250C : 6606                		bne.s	.wait					; if not, branch
    1765/    250E : 50F8 F6FB           		st.b	(v_plc_Busy).w				; otherwise, set flag that next frame should skip PLC (flush DMA)
    1766/    2512 : 4E75                		rts
    1767/    2514 :                     .wait:
    1768/    2514 : 4A38 F62A           		tst.b	(v_vblank_routine).w			; has VBlank routine finished?
    1769/    2518 : 66FA                		bne.s	.wait					; if not, loop until it has
    1770/    251A :                     
    1771/    251A : 51F8 F6FB           		sf.b	(v_plc_Busy).w				; clear DMA busy flag
    1772/    251E : 4E75                		rts						; resume normal operation
    1773/    2520 :                     ; End of function WaitForVBlank
