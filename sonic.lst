    4461/   11D5A :                     ; ===========================================================================
    4462/   11D5A :                     ; >>> Object-to-object touch response handler for Sonic
    4463/   11D5A :                     		include	"_incObj/Sonic ReactToItem.asm"
(1)    1/   11D5A :                     ; ===========================================================================
(1)    2/   11D5A :                     ; ---------------------------------------------------------------------------
(1)    3/   11D5A :                     ; Subroutine to collide Sonic with objects using obColType(a0)
(1)    4/   11D5A :                     ; 
(1)    5/   11D5A :                     ; input:
(1)    6/   11D5A :                     ;	a0 = address of OST of Sonic
(1)    7/   11D5A :                     ; 
(1)    8/   11D5A :                     ; output:
(1)    9/   11D5A :                     ;	d0.l = (unused) -1 if Sonic touches an enemy or harmful object while invincible, or is hurt/killed
(1)   10/   11D5A :                     ;	a2 = address of OST of object hurting/killing Sonic
(1)   11/   11D5A :                     ; ---------------------------------------------------------------------------
(1)   12/   11D5A :                     
(1)   13/   11D5A :                     ReactToItem:
(1)   14/   11D5A : 4EB9 0000 92E6      		jsr	(Touch_Rings).l				; allow Sonic to collect S3K Rings Manager rings
(1)   15/   11D60 : 3428 0008           		move.w	obX(a0),d2				; load Sonic's x-axis position
(1)   16/   11D64 : 3628 000C           		move.w	obY(a0),d3				; load Sonic's y-axis position
(1)   17/   11D68 : 5142                		subq.w	#sonic_react_width,d2			; d2 = X-position of Sonic's left edge
(1)   18/   11D6A :                     
(1)   19/   11D6A : 7A00                		moveq	#0,d5					; clear d5
(1)   20/   11D6C : 1A28 0016           		move.b	obHeight(a0),d5				; load Sonic's height
(1)   21/   11D70 : 5705                		subq.b	#3,d5					; shrink by 3px
(1)   22/   11D72 : 9645                		sub.w	d5,d3					; d3 = Y-position of Sonic's top edge
(1)   23/   11D74 :                     
(1)   25/   11D74 : 0C28 0008 001C      		cmpi.b	#id_Duck,obAnim(a0)			; is Sonic in his ducking animation?
(1)   36/   11D7A : 6606                		bne.s	.notducking				; if not, branch
(1)   37/   11D7C : 0643 000C           		addi.w	#((sonic_height-3)-sonic_duck_height)*2,d3 ; adjust Y-position of Sonic's top edge when ducking
(1)   38/   11D80 : 7A0A                		moveq	#sonic_duck_height,d5			; use alternate hitbox extent
(1)   39/   11D82 :                     	.notducking:
(1)   40/   11D82 :                     
(1)   41/   11D82 : 383C 0010           		move.w	#sonic_react_width*2,d4			; d4 = Sonic's hitbox width
(1)   42/   11D86 : DA45                		add.w	d5,d5					; d5 = Sonic's hitbox height
(1)   43/   11D88 :                     
