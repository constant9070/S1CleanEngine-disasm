(2)   30/    9810 :                     Anim_SetFrameAndFlipFlags:
(2)   31/    9810 : 1200                		move.b	d0,d1				; copy new frame ID
(2)   32/    9812 : 0200 001F           		andi.b	#$1F,d0				; limit possible frame IDs to $20 (other bits are occupied by flags)
(2)   33/    9816 : 1140 001A           		move.b	d0,obFrame(a0)			; write new frame ID to object
(2)   34/    981A :                     
(2)   35/    981A :                     		; Handle aniXFlip and aniYFlip flags if specified in animation scripts.
(2)   36/    981A :                     		; This part is the main reason why non-Sonic objects are limited to only $20 frames,
(2)   37/    981A :                     		; and in later games this limitation was removed (flipping was instead exclusively
(2)   38/    981A :                     		; handled through separate, flipped sprite mappings sets, rather than animation flags).
(2)   39/    981A : 1028 0022           		move.b	obStatus(a0),d0			; get object's current status flags
(2)   40/    981E : E719                		rol.b	#3,d1				; shift aniXFlip and aniYFlip into low bits to match obStatus format
(2)   41/    9820 : B101                		eor.b	d0,d1				; xor with existing flip state of object
(2)   42/    9822 : 0201 0003           		andi.b	#sprite_xflip|sprite_yflip,d1	; limit result to only X and Y flip state
(2)   43/    9826 : 0228 00FC 0001      		andi.b	#~(sprite_xflip|sprite_yflip),obRender(a0) ; clear previous X and Y flip states of objects
(2)   44/    982C : 8328 0001           		or.b	d1,obRender(a0)			; set new X and Y flip states for object
(2)   45/    9830 :                     
(2)   46/    9830 : 5228 001B           		addq.b	#1,obAniFrame(a0)		; advance animation script to next index
