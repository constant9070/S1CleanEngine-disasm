(2)  907/   4B9B8 :                     ; Voices - Total Level
(2)  908/   4B9B8 :                     ; The original SMPS2ASM decides TL high bits automatically,
(2)  909/   4B9B8 :                     ; but later versions leave it up to the user.
(2)  910/   4B9B8 :                     ; Alternatively, if we're converting an SMPS 68k song to SMPS Z80,
(2)  911/   4B9B8 :                     ; then we *want* the TL bits to match the algorithm, because SMPS 68k
(2)  912/   4B9B8 :                     ; prefers the algorithm over the TL bits, ignoring the latter, while
(2)  913/   4B9B8 :                     ; SMPS Z80 does the opposite.
(2)  914/   4B9B8 :                     ; Unfortunately, there's nothing we can do if we're trying to convert
(2)  915/   4B9B8 :                     ; an SMPS Z80 song to SMPS 68k. It will ignore the bits no matter
(2)  916/   4B9B8 :                     ; what we do, so we just print a warning.
(2)  917/   4B9B8 :                     smpsVcTotalLevel macro op1,op2,op3,op4
(2)  918/   4B9B8 :                     	eval vcTL1,op1
(2)  919/   4B9B8 :                     	eval vcTL2,op2
(2)  920/   4B9B8 :                     	eval vcTL3,op3
(2)  921/   4B9B8 :                     	eval vcTL4,op4
(2)  922/   4B9B8 :                     	smpsDcb	(vcUnusedBits<<6)+(vcFeedback<<3)+vcAlgorithm
(2)  923/   4B9B8 :                     ;   0     1     2     3     4     5     6     7
(2)  924/   4B9B8 :                     ;%1000,%1000,%1000,%1000,%1010,%1110,%1110,%1111
(2)  925/   4B9B8 :                     	if SourceSMPS2ASM==0
(2)  926/   4B9B8 :                     		eval vcTLMask4,((vcAlgorithm==7)<<7)
(2)  927/   4B9B8 :                     		eval vcTLMask3,((vcAlgorithm>=4)<<7)
(2)  928/   4B9B8 :                     		eval vcTLMask2,((vcAlgorithm>=5)<<7)
(2)  929/   4B9B8 :                     		eval vcTLMask1,128
(2)  930/   4B9B8 :                     	else
(2)  931/   4B9B8 :                     		eval vcTLMask4,0
(2)  932/   4B9B8 :                     		eval vcTLMask3,0
(2)  933/   4B9B8 :                     		eval vcTLMask2,0
(2)  934/   4B9B8 :                     		eval vcTLMask1,0
(2)  935/   4B9B8 :                     	endif
(2)  936/   4B9B8 :                     
(2)  937/   4B9B8 :                     	if (SonicDriverVer>=3)&&(SourceDriver<3)
(2)  938/   4B9B8 :                     		eval vcTLMask4,((vcAlgorithm==7)<<7)
(2)  939/   4B9B8 :                     		eval vcTLMask3,((vcAlgorithm>=4)<<7)
(2)  940/   4B9B8 :                     		eval vcTLMask2,((vcAlgorithm>=5)<<7)
(2)  941/   4B9B8 :                     		eval vcTLMask1,128
(2)  942/   4B9B8 :                     		eval vcTL1,vcTL1&127
(2)  943/   4B9B8 :                     		eval vcTL2,vcTL2&127
(2)  944/   4B9B8 :                     		eval vcTL3,vcTL3&127
(2)  945/   4B9B8 :                     		eval vcTL4,vcTL4&127
(2)  946/   4B9B8 :                     	elseif (SonicDriverVer<3)&&(SourceDriver>=3)&&((((vcTL1|vcTLMask1)&128)<>128)||(((vcTL2|vcTLMask2)&128)<>((vcAlgorithm>=5)<<7))||(((vcTL3|vcTLMask3)&128)<>((vcAlgorithm>=4)<<7))||(((vcTL4|vcTLMask4)&128)<>((vcAlgorithm==7)<<7)))
(2)  947/   4B9B8 :                     		if MOMPASS=1
(2)  948/   4B9B8 :                     			message "Voice at 0x\{*} has TL bits that do not match its algorithm setting. This voice will not work in S1/S2 drivers."
(2)  949/   4B9B8 :                     		endif
(2)  950/   4B9B8 :                     	endif
(2)  951/   4B9B8 :                     
(2)  952/   4B9B8 :                     	if SonicDriverVer==2
(2)  953/   4B9B8 :                     		smpsDcb	(vcDT4<<4)+vcCF4       ,(vcDT2<<4)+vcCF2       ,(vcDT3<<4)+vcCF3       ,(vcDT1<<4)+vcCF1
(2)  954/   4B9B8 :                     		smpsDcb	(vcRS4<<6)+vcAR4       ,(vcRS2<<6)+vcAR2       ,(vcRS3<<6)+vcAR3       ,(vcRS1<<6)+vcAR1
(2)  955/   4B9B8 :                     		smpsDcb	vcAM4|vcD1R4|vcD1R4Unk ,vcAM2|vcD1R2|vcD1R2Unk ,vcAM3|vcD1R3|vcD1R3Unk ,vcAM1|vcD1R1|vcD1R1Unk
(2)  956/   4B9B8 :                     		smpsDcb	vcD2R4                 ,vcD2R2                 ,vcD2R3                 ,vcD2R1
(2)  957/   4B9B8 :                     		smpsDcb	(vcDL4<<4)+vcRR4       ,(vcDL2<<4)+vcRR2       ,(vcDL3<<4)+vcRR3       ,(vcDL1<<4)+vcRR1
(2)  958/   4B9B8 :                     		smpsDcb	vcTL4|vcTLMask4        ,vcTL2|vcTLMask2        ,vcTL3|vcTLMask3        ,vcTL1|vcTLMask1
(2)  959/   4B9B8 :                     	else
(2)  960/   4B9B8 :                     		smpsDcb	(vcDT4<<4)+vcCF4       ,(vcDT3<<4)+vcCF3       ,(vcDT2<<4)+vcCF2       ,(vcDT1<<4)+vcCF1
(2)  961/   4B9B8 :                     		smpsDcb	(vcRS4<<6)+vcAR4       ,(vcRS3<<6)+vcAR3       ,(vcRS2<<6)+vcAR2       ,(vcRS1<<6)+vcAR1
(2)  962/   4B9B8 :                     		smpsDcb	vcAM4|vcD1R4|vcD1R4Unk ,vcAM3|vcD1R3|vcD1R3Unk ,vcAM2|vcD1R2|vcD1R2Unk ,vcAM1|vcD1R1|vcD1R1Unk
(2)  963/   4B9B8 :                     		smpsDcb	vcD2R4                 ,vcD2R3                 ,vcD2R2                 ,vcD2R1
(2)  964/   4B9B8 :                     		smpsDcb	(vcDL4<<4)+vcRR4       ,(vcDL3<<4)+vcRR3       ,(vcDL2<<4)+vcRR2       ,(vcDL1<<4)+vcRR1
(2)  965/   4B9B8 :                     		smpsDcb	vcTL4|vcTLMask4        ,vcTL3|vcTLMask3        ,vcTL2|vcTLMask2        ,vcTL1|vcTLMask1
(2)  966/   4B9B8 :                     	endif
(2)  967/   4B9B8 :                     	endm
