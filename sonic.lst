(2)   11/       0 :                     	listing purecode
(2)   12/       0 :                     
(2)   13/       0 : =1FFCH               z80_stack:	equ 1FFCh
(2)   14/       0 : =1FFDH               zDAC_Status:	equ 1FFDh	; Bit 7 set if the driver is not accepting new samples, it is clear otherwise
(2)   15/       0 : =1FFFH               zDAC_Sample:	equ 1FFFh	; Sample to play, the 68k will move into this location whatever sample that's supposed to be played.
(2)   16/       0 :                     
(2)   17/       0 : =4000H               zYM2612_A0:	equ 4000h
(2)   18/       0 : =6000H               zBankRegister:	equ 6000h
(2)   19/       0 : =8000H               zROMWindow:	equ 8000h
(2)   20/       0 :                     
(2)   21/       0 :                     zmake68kPtr  function addr,zROMWindow+(addr&7FFFh)
(2)   22/       0 :                     zmake68kBank function addr,(((addr&0FF8000h)/zROMWindow))
(2)   23/       0 :                     
(2)   24/       0 :                     ; function to decide whether an offset's full range won't fit in one byte
(2)   25/       0 :                     offsetover1byte function from,maxsize, ((from&0FFh)>(100h-maxsize))
(2)   26/       0 :                     
(2)   27/       0 :                     ; macro to make sure that ($ & 0FF00h) == (($+maxsize) & 0FF00h)
(2)   28/       0 :                     ensure1byteoffset macro maxsize
(2)   29/       0 :                     	if offsetover1byte($,maxsize)
(2)   30/       0 :                     startpad := $
(2)   31/       0 :                     		align 100h
(2)   32/       0 :                     	    if MOMPASS=1
(2)   33/       0 :                     endpad := $
(2)   34/       0 :                     		if endpad-startpad>=1h
(2)   35/       0 :                     			; warn because otherwise you'd have no clue why you're running out of space so fast
(2)   36/       0 :                     			message "had to insert \{endpad-startpad}h   bytes of padding before improperly located data at 0\{startpad}h in Z80 code"
(2)   37/       0 :                     		endif
(2)   38/       0 :                     	    endif
(2)   39/       0 :                     	endif
(2)   40/       0 :                         endm
(2)   41/       0 :                     
(2)   42/       0 :                     ;Z80Driver_Start:
(2)   43/       0 : F3                  	di					; Disable interrupts. Interrupts will never be re-enabled
(2)   44/       1 : F3                  	di					; for the z80, so that no code will be executed on V-Int.
(2)   45/       2 : F3                  	di					; This means that the sample loop is all the z80 does.
(2)   46/       3 : 31 FC 1F            	ld	sp,z80_stack			; Initialize the stack pointer (unused throughout the driver)
(2)   47/       6 : DD 21 00 40         	ld	ix,zYM2612_A0			; ix = Pointer to memory-mapped communication register with YM2612
(2)   48/       A : AF                  	xor	a				; a=0
(2)   49/       B :                     
(2)   50/       B :                     zBankSwitchLoop:
(2)   51/       B : 32 00 60            	ld	(zBankRegister),a		; Latch another bit to bank register.
(2)   52/       E : 0F                  	rrca					; Move next bit into position
(2)   53/       F : 10 FA               	djnz	zBankSwitchLoop			; decrement and loop if not zero
(2)   54/      11 :                     
(2)   55/      11 : 18 10               	jr	zCheckForSamples
(2)   56/      13 :                     
(2)   57/      13 :                     ; ===========================================================================
(2)   58/      13 :                     ; JMan2050's DAC decode lookup table
(2)   59/      13 :                     ; ===========================================================================
(2)   60/      13 : (MACRO)              	ensure1byteoffset 10h
(2)   61/      13 :                     zDACDecodeTbl:
(2)   62/      13 :                     	binclude "sound/dac/dpcm/deltas.bin"
(2)   63/      23 :                     
(2)   64/      23 :                     zCheckForSamples:
(2)   65/      23 : 21 FF 1F            	ld	hl,zDAC_Sample			; Load the address of next sample.
(2)   66/      26 :                     
(2)   67/      26 :                     zWaitDACLoop:
(2)   68/      26 : 7E                  	ld	a,(hl)				; a = next sample to play.
(2)   69/      27 : B7                  	or	a				; Do we have a valid sample?
(2)   70/      28 : F2 26 00            	jp	p,zWaitDACLoop			; Loop until we do
(2)   71/      2B :                     
(2)   72/      2B : D6 81               	sub	81h				; Make 0-based index
(2)   73/      2D : 77                  	ld	(hl),a				; Store it back into sample index (i.e., mark it as being played)
(2)   74/      2E :                     
(2)   75/      2E : 11 00 00            	ld	de,0				; de = 0
(2)   76/      31 : FD 21 A6 00         	ld	iy,zPCM_Table			; iy = pointer to PCM Table
(2)   77/      35 :                     
(2)   78/      35 :                     	; Each entry on PCM table has 8 bytes in size, so multiply a by 8
(2)   79/      35 :                     	; Warning: do NOT play samples 84h-86h!
(2)   80/      35 : CB 27               	sla	a
(2)   81/      37 : CB 27               	sla	a
(2)   82/      39 : CB 27               	sla	a
(2)   83/      3B : 06 00               	ld	b,0				; b = 0
(2)   84/      3D : 4F                  	ld	c,a				; c = a
(2)   85/      3E : FD 09               	add	iy,bc				; iy = pointer to DAC sample entry
(2)   86/      40 : FD 5E 00            	ld	e,(iy+0)			; e = low byte of sample location
(2)   87/      43 : FD 56 01            	ld	d,(iy+1)			; de = pointer location of DAC sample
(2)   88/      46 : FD 4E 02            	ld	c,(iy+2)			; c = low byte of sample size
(2)   89/      49 : FD 46 03            	ld	b,(iy+3)			; bc = size of the DAC sample
(2)   90/      4C : D9                  	exx					; bc' = size of sample, de' = location of sample, hl' = pointer to zDAC_Sample
(2)   91/      4D : 16 80               	ld	d,80h				; d = is an accumulator; this initializes it to 80h
(2)   92/      4F : 21 FD 1F            	ld	hl,zDAC_Status			; hl = pointer to zDAC_Status
(2)   93/      52 : 72                  	ld	(hl),d				; Set flag to not accept driver input
(2)   94/      53 : DD 36 00 2B         	ld	(ix+0),2Bh			; Select enable/disable DAC register
(2)   95/      57 : 1E 2A               	ld	e,2Ah				; Command to select DAC output register
(2)   96/      59 : FD 4E 04            	ld	c,(iy+4)			; c = pitch of the DAC sample
(2)   97/      5C : DD 72 01            	ld	(ix+1),d			; Enable DAC
(2)   98/      5F : 36 00               	ld	(hl),0				; Set flag to accept driver input
(2)   99/      61 :                     	; After the following exx, we have:
(2)  100/      61 :                     	; bc = size of sample, de = location of sample, hl = pointer to zDAC_Sample,
(2)  101/      61 :                     	; c' = pitch of sample, d' = PCM accumulator,
(2)  102/      61 :                     	; e' = command to select DAC output register, hl' = pointer to DAC status
(2)  103/      61 : D9                  	exx
(2)  104/      62 : 26 00               	ld	h,(zDACDecodeTbl&0FF00h)>>8	; We set low byte of pointer below
(2)  105/      64 :                     
(2)  106/      64 :                     zPlayPCMLoop:
(2)  107/      64 : 1A                  	ld	a,(de)			; 7	; a = byte from DAC sample
(2)  108/      65 : E6 F0               	and	0F0h			; 7	; Get upper nibble
(2)  109/      67 :                     	; Shift-right 4 times to rotate the nibble into place
(2)  110/      67 : 0F                  	rrca				; 4
(2)  111/      68 : 0F                  	rrca				; 4
(2)  112/      69 : 0F                  	rrca				; 4
(2)  113/      6A : 0F                  	rrca				; 4
(2)  114/      6B : C6 13               	add	a,zDACDecodeTbl&0FFh	; 7	; Add in low byte of offset into decode table
(2)  115/      6D : 6F                  	ld	l,a			; 4	; hl = pointer to nibble entry in JMan2050 table
(2)  116/      6E : 7E                  	ld	a,(hl)			; 7	; a = JMan2050 entry for current nibble
(2)  117/      6F :                     	; After the following exx, we have:
(2)  118/      6F :                     	; bc' = size of sample, de' = location of sample, hl' = pointer to nibble entry in JMan2050 table,
(2)  119/      6F :                     	; c = pitch of sample, d = PCM accumulator,
(2)  120/      6F :                     	; e = command to select DAC output register, hl = pointer to DAC status
(2)  121/      6F : D9                  	exx				; 4
(2)  122/      70 : 82                  	add	a,d			; 4	; Add accumulator value...
(2)  123/      71 : 57                  	ld	d,a			; 4	; ... then store value back into accumulator
(2)  124/      72 : 75                  	ld	(hl),l			; 7	; Set flag to not accept driver input (l = FFh)
(2)  125/      73 : DD 73 00            	ld	(ix+0),e		; 19	; Select DAC output register
(2)  126/      76 : DD 72 01            	ld	(ix+1),d		; 19	; Send current data
(2)  127/      79 : 74                  	ld	(hl),h			; 7	; Set flag to accept driver input (h = 1Fh)
(2)  128/      7A :                     
(2)  129/      7A : 41                  	ld	b,c			; 4	; b = sample pitch
(2)  130/      7B : 10 FE               	djnz	$			; 8	; Pitch loop
(2)  131/      7D :                     
(2)  132/      7D :                     	; After the following exx, we have:
(2)  133/      7D :                     	; bc = size of sample, de = location of sample, hl = pointer to nibble entry in JMan2050 table,
(2)  134/      7D :                     	; c' = pitch of sample, d' = PCM accumulator,
(2)  135/      7D :                     	; e' = command to select DAC output register, hl' = pointer to DAC status
(2)  136/      7D : D9                  	exx				; 4
(2)  137/      7E : 1A                  	ld	a,(de)			; 7	; a = byte from DAC sample
(2)  138/      7F : E6 0F               	and	0Fh			; 7	; Want only lower nibble now
(2)  139/      81 : C6 13               	add	a,zDACDecodeTbl&0FFh	; 7	; Add in low byte of offset into decode table
(2)  140/      83 : 6F                  	ld	l,a			; 4	; hl = pointer to nibble entry in JMan2050 table
(2)  141/      84 : 7E                  	ld	a,(hl)			; 7	; a = JMan2050 entry for current nibble
(2)  142/      85 :                     	; After the following exx, we have:
(2)  143/      85 :                     	; bc' = size of sample, de' = location of sample, hl' = pointer to nibble entry in JMan2050 table,
(2)  144/      85 :                     	; c = pitch of sample, d = PCM accumulator,
(2)  145/      85 :                     	; e = command to select DAC output register, hl = pointer to DAC status
(2)  146/      85 : D9                  	exx				; 4
(2)  147/      86 : 82                  	add	a,d			; 4	; Add accumulator value...
(2)  148/      87 : 57                  	ld	d,a			; 4	; ... then store value back into accumulator
(2)  149/      88 : 75                  	ld	(hl),l			; 7	; Set flag to not accept driver input (l = FFh)
(2)  150/      89 : DD 73 00            	ld	(ix+0),e		; 19	; Select DAC output register
(2)  151/      8C : DD 72 01            	ld	(ix+1),d		; 19	; Send current data
(2)  152/      8F : 74                  	ld	(hl),h			; 7	; Set flag to accept driver input (h = 1Fh)
(2)  153/      90 :                     
(2)  154/      90 : 41                  	ld	b,c			; 4	; b = sample pitch
(2)  155/      91 : 10 FE               	djnz	$			; 8	; Pitch loop
(2)  156/      93 :                     
(2)  157/      93 :                     	; After the following exx, we have:
(2)  158/      93 :                     	; bc = size of sample, de = location of sample, hl = pointer to nibble entry in JMan2050 table,
(2)  159/      93 :                     	; c' = pitch of sample, d' = PCM accumulator,
(2)  160/      93 :                     	; e' = command to select DAC output register, hl' = pointer to DAC status
(2)  161/      93 : D9                  	exx				; 4
(2)  162/      94 : 3A FF 1F            	ld	a,(zDAC_Sample)		; 13	; a = sample we're playing (minus 81h)
(2)  163/      97 : CB 7F               	bit	7,a			; 8	; Test bit 7 of register a
(2)  164/      99 : C2 23 00            	jp	nz,zCheckForSamples	; 10	; If it is set, we need to get a new sample
(2)  165/      9C :                     
(2)  166/      9C : 13                  	inc	de			; 6	; Point to next byte of DAC sample
(2)  167/      9D : 0B                  	dec	bc			; 6	; Decrement remaining bytes on DAC sample
(2)  168/      9E : 79                  	ld	a,c			; 4	; a = low byte of remaining bytes
(2)  169/      9F : B0                  	or	b			; 4	; Are there any bytes left?
(2)  170/      A0 : C2 64 00            	jp	nz,zPlayPCMLoop		; 10	; If yes, keep playing sample
(2)  171/      A3 :                     					; 301 in total
(2)  172/      A3 : C3 23 00            	jp	zCheckForSamples		; Sample is done; wait for new samples
