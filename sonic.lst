(1)    1/   12718 :                     ; ===========================================================================
(1)    2/   12718 :                     ; ---------------------------------------------------------------------------
(1)    3/   12718 :                     ; Subroutine to add points to the score counter.
(1)    4/   12718 :                     ; 
(1)    5/   12718 :                     ; Input:
(1)    6/   12718 :                     ;	d0 = points to add / 10 (rightmost digit in HUD is a fake 0)
(1)    7/   12718 :                     ; ---------------------------------------------------------------------------
(1)    8/   12718 :                     ; - In REV00, a copy of the score is kept in a separate RAM value, and it's
(1)    9/   12718 :                     ;   coded so that it only updates when the current score is higher. This is
(1)   10/   12718 :                     ;   never used anywhere in the game, but probably once was intended as some
(1)   11/   12718 :                     ;   sort of high-score system, as it stays in memory after a soft reset.
(1)   12/   12718 :                     ; - In REV01, this value has been repurposed so that it awards an extra life
(1)   13/   12718 :                     ;   for every multiple of 50000 points acquired, but ONLY if the region is
(1)   14/   12718 :                     ;   set to Japanese. Overseas regions will update the requirement, but they
(1)   15/   12718 :                     ;   won't award the extra life under any circumstances.
(1)   16/   12718 :                     ; ---------------------------------------------------------------------------
(1)   17/   12718 :                     
(1)   18/   12718 :                     AddPoints:
(1)   19/   12718 : 11FC 0001 FE1F      		move.b	#1,(f_scorecount).w		; set score counter to update
(1)   20/   1271E :                     
(1)   38/   1271E :                     
(1)   39/   1271E : 47F8 FE26           		lea	(v_score).w,a3			; load current score count
(1)   40/   12722 : D193                		add.l	d0,(a3)				; add d0*10 to the score
(1)   41/   12724 : 223C 000F 423F      		move.l	#999999,d1			; set maximum score count to 9999990
(1)   42/   1272A : B293                		cmp.l	(a3),d1				; has score exceeded the maximum?
(1)   43/   1272C : 6202                		bhi.s	.belowmax			; if not, branch
(1)   44/   1272E : 2681                		move.l	d1,(a3)				; cap score to 9999990
(1)   45/   12730 :                     
(1)   46/   12730 :                     .belowmax:
(1)   47/   12730 : 2013                		move.l	(a3),d0				; get new score count
(1)   48/   12732 : B0B8 FFC0           		cmp.l	(v_scorelife).w,d0		; is new score count exceeding the next multiple of 50000?
(1)   49/   12736 : 6520                		blo.s	.return				; if not, branch
(1)   50/   12738 :                     
(1)   51/   12738 : 06B8 0000 1388      		addi.l	#5000,(v_scorelife).w		; increase requirement for next score extra life by 50000
            1273E : FFC0             
