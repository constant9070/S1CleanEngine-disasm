    2434/    2FBC :                     ; Subroutine to load level select text
    2435/    2FBC :                     ; ---------------------------------------------------------------------------
    2436/    2FBC :                     
    2437/    2FBC : =$4                  levsel_line_count:	equ 4	; total number of lines
    2438/    2FBC : =$18                 levsel_line_length:	equ 24	; characters per line
    2439/    2FBC : =$3                  levsel_sndtest_row:	equ levsel_line_count-1  ; row index of the sound test
    2440/    2FBC : =$10                 levsel_sndtest_col:	equ levsel_line_length-8 ; column offset for the sound test number 
    2441/    2FBC :                     
    2442/    2FBC : =$C                  levsel_start_row:	equ 12	; top tile offset for start position
    2443/    2FBC : =$8                  levsel_start_col:	equ 8	; left tile offset for start position
    2444/    2FBC : =$E610               levsel_vram_main:	equ vram_bg+(levsel_start_row<<7)+(levsel_start_col<<1)	; nametable address in VRAM
    2445/    2FBC : =$E7B0               levsel_vram_sndtestnum:	equ levsel_vram_main+(levsel_sndtest_row<<7)+(levsel_sndtest_col<<1) ; nametable address for sound test numbers
    2446/    2FBC :                     
    2447/    2FBC : =$E680               levsel_white:		equ ArtTile_Level_Select_Font|Tile_Pal4|Tile_Prio ; VRAM setting for white text (non-selected lines)
    2448/    2FBC : =$C680               levsel_yellow:		equ ArtTile_Level_Select_Font|Tile_Pal3|Tile_Prio ; VRAM setting for yellow text (selected line)
