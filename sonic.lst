(1)  140/    B37E :                     ; ===========================================================================
(1)  141/    B37E :                     ; ---------------------------------------------------------------------------
(1)  142/    B37E :                     ; Macro for all BuildSpr_Draw functions, to visualize the differences between them.
(1)  143/    B37E :                     ; All four variants work on the same basic principle, only coming with
(1)  144/    B37E :                     ; modifications for the flipping.
(1)  145/    B37E :                     ; 
(1)  146/    B37E :                     ; input:
(1)  147/    B37E :                     ;	d1 = number of sprite pieces in mapping minus 1
(1)  148/    B37E :                     ;	d2 = base Y-position
(1)  149/    B37E :                     ;	d3 = base X-position
(1)  150/    B37E :                     ;	d5 = total rendered sprites so far (max 80)
(1)  151/    B37E :                     ;	a1 = pointer to starting sprite piece in sprite mappings (see breakdown above)
(1)  152/    B37E :                     ;	a2 = pointer to sprite link buffer (v_spritetablebuffer)
(1)  153/    B37E :                     ;	a3 = art tile / VRAM setting (obGfx)
(1)  154/    B37E :                     ;
(1)  155/    B37E :                     ; 	uses d0.w, d4.w
(1)  156/    B37E :                     ;
(1)  157/    B37E :                     ; Each sprite piece is exactly 5 bytes. See here for a breakdown:
(1)  158/    B37E :                     ; https://info.sonicretro.org/SCHG:Sonic_the_Hedgehog_(16-bit)/Object_Editing#Mappings_editing
(1)  159/    B37E :                     ; ---------------------------------------------------------------------------
(1)  160/    B37E :                     
(1)  161/    B37E :                     buildsprite:	macro xflip,yflip
(1)  162/    B37E :                     
(1)  163/    B37E :                     .loopSpritePieces:
(1)  164/    B37E :                     	; --- Sprite limit check ---
(1)  165/    B37E :                     		cmpi.b	#sprites_max,d5			; check sprite limit
(1)  166/    B37E :                     		beq.s	.return				; if all sprite slots are taken up, abort process
(1)  167/    B37E :                     
(1)  168/    B37E :                     	; --- Y-position ---
(1)  169/    B37E :                     		move.b	(a1)+,d0			; get relative Y-offset
(1)  170/    B37E :                     		if yflip
(1)  171/    B37E :                     			move.b	(a1),d4			; get dimensions of sprite piece
(1)  172/    B37E :                     			ext.w	d0
(1)  173/    B37E :                     			neg.w	d0
(1)  174/    B37E :                     			lsl.b	#3,d4
(1)  175/    B37E :                     			andi.w	#%11000,d4
(1)  176/    B37E :                     			addq.w	#8,d4
(1)  177/    B37E :                     			sub.w	d4,d0			; d0 = flipped Y-position
(1)  178/    B37E :                     		else
(1)  179/    B37E :                     			ext.w	d0
(1)  180/    B37E :                     		endif
(1)  181/    B37E :                     		add.w	d2,d0				; add base Y-position
(1)  182/    B37E :                     		move.w	d0,(a2)+			; write Y-position to buffer
(1)  183/    B37E :                     
(1)  184/    B37E :                     	; --- Sprite width/height ---
(1)  185/    B37E :                     		if xflip
(1)  186/    B37E :                     			move.b	(a1)+,d4		; get dimensions of sprite piece (WWHH) (backup for later)
(1)  187/    B37E :                     			move.b	d4,(a2)+		; write sprite width to buffer
(1)  188/    B37E :                     		else
(1)  189/    B37E :                     			move.b	(a1)+,(a2)+		; write sprite width to buffer
(1)  190/    B37E :                     		endif
(1)  191/    B37E :                     
(1)  192/    B37E :                     	; --- Sprite link ---
(1)  193/    B37E :                     		addq.b	#1,d5				; increase total sprites counter
(1)  194/    B37E :                     		move.b	d5,(a2)+			; write sprite link to buffer
(1)  195/    B37E :                     
(1)  196/    B37E :                     	; --- VRAM settings / art tile / flipping ---
(1)  197/    B37E :                     		move.b	(a1)+,d0			; get first half of VRAM settings
(1)  198/    B37E :                     		lsl.w	#8,d0
(1)  199/    B37E :                     		move.b	(a1)+,d0			; get second half of VRAM settings
(1)  200/    B37E :                     		add.w	a3,d0				; add base art tile offset of object
(1)  201/    B37E :                     		if xflip|yflip
(1)  202/    B37E :                     			eori.w	#xflip<<11|yflip<<12,d0	; toggle X-flip ($800) and/or Y-flip ($1000) in VDP
(1)  203/    B37E :                     		endif
(1)  204/    B37E :                     		move.w	d0,(a2)+			; write VRAM settings to buffer
(1)  205/    B37E :                     
(1)  206/    B37E :                     	; --- X-position ---
(1)  207/    B37E :                     		move.b	(a1)+,d0			; get relative X-offset
(1)  208/    B37E :                     		ext.w	d0
(1)  209/    B37E :                     		if xflip
(1)  210/    B37E :                     			neg.w	d0
(1)  211/    B37E :                     			add.b	d4,d4
(1)  212/    B37E :                     			andi.w	#%11000,d4
(1)  213/    B37E :                     			addq.w	#8,d4
(1)  214/    B37E :                     			sub.w	d4,d0			; d0 = flipped X-position
(1)  215/    B37E :                     		endif
(1)  216/    B37E :                     		add.w	d3,d0				; add X-position
(1)  217/    B37E :                     		andi.w	#$1FF,d0			; keep within 512px (screen wrap)
(1)  218/    B37E :                     		bne.s	.x				; if non-zero, branch
(1)  219/    B37E :                     		addq.w	#1,d0				; force zero X-position to non-zero (avoid unwanted sprite masking)
(1)  220/    B37E :                     	.x:	move.w	d0,(a2)+			; write X-position to buffer
(1)  221/    B37E :                     
(1)  222/    B37E :                     	; --- Loop for all pieces in mapping ---
(1)  223/    B37E :                     		dbf	d1,.loopSpritePieces
(1)  224/    B37E :                     
(1)  225/    B37E :                     	.return:
(1)  226/    B37E :                     		rts
(1)  227/    B37E :                     
(1)  228/    B37E :                     	endm
(1)  229/    B37E :                     
