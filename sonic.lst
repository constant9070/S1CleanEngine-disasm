(1)  266/   12B0E :                     
(1)  267/   12B0E :                     		; Turn VRAM address into VDP command
(1)  268/   12B0E : 0640 8000           		addi.w	#ArtTile_Giant_Ring*tile_size,d0	; advance to starting VRAM address of giant ring
(1)  269/   12B12 : E588                		lsl.l	#2,d0					; push upper address bits into upper word
(1)  270/   12B14 : E448                		lsr.w	#2,d0					; send rest back
(1)  271/   12B16 : 0040 4000           		ori.w	#$4000,d0				; set VDP mode bits (VRAM write mode)
(1)  272/   12B1A : 4840                		swap	d0					; align for VDP in order
(1)  273/   12B1C : 2D40 0004           		move.l	d0,4(a6)				; send VDP command (write to VRAM at address contained in v_gfxbigring)
(1)  274/   12B20 :                     
