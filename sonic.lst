(1)   17/   10120 : 010A                		dc.w Cat_Head-Cat_Index		; 2 - head
(1)   18/   10122 : 02B4                		dc.w Cat_BodySeg1-Cat_Index	; 4 - 1st body segment
(1)   19/   10124 : 0282                		dc.w Cat_BodySeg2-Cat_Index	; 6 - 2nd body segment
(1)   20/   10126 : 02B4                		dc.w Cat_BodySeg1-Cat_Index	; 8 - 3rd body segment
(1)   21/   10128 : 018E                		dc.w Cat_Delete-Cat_Index	; A - delete head or segment
