(1)   19/   12CF2 :                     
(1)   20/   12CF2 :                     .chkrings:
(1)   21/   12CF2 : 4A38 FE1D           		tst.b	(f_ringcount).w			; does the ring counter need updating?
(1)   22/   12CF6 : 671A                		beq.s	.chktime			; if not, branch
(1)   23/   12CF8 : 6A04                		bpl.s	.notzero			; should leading digits get reset (flag >= $80)? if not, branch
(1)   24/   12CFA : 6100 012C           		bsr.w	Hud_ResetRings			; reset rings to 0 and clear leading digits (Sonic got hit)
(1)   25/   12CFE :                     	.notzero:
(1)   26/   12CFE : 4238 FE1D           		clr.b	(f_ringcount).w			; clear update flag
(1)   27/   12D02 :                     
(1)   28/   12D02 : (MACRO)              		locVRAM	(ArtTile_HUDRings)*tile_size,d0	; set VRAM address
(1)   28/   12D02 : 203C 5F40 0003                      move.l  #($40000000+((((ArtTile_HUDRings)*tile_size)&$3FFF)<<16)+((((ArtTile_HUDRings)*tile_size)&$C000)>>14)),d0
(1)   29/   12D08 : 7200                		moveq	#0,d1				; clear d1
(1)   30/   12D0A : 3238 FE20           		move.w	(v_rings).w,d1			; load number of rings
(1)   31/   12D0E : 6100 01DA           		bsr.w	Hud_Rings			; write rings digits 
