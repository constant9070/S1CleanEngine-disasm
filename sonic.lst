(2)   23/    9800 : 1151 001E           		move.b	(a1),obTimeFrame(a0)		; load frame duration (always the first byte)
(2)   24/    9804 : 7200                		moveq	#0,d1				; clear d1
(2)   25/    9806 : 1228 001B           		move.b	obAniFrame(a0),d1		; load current frame index number
(2)   26/    980A : 1031 1001           		move.b	1(a1,d1.w),d0			; read next frame ID from script
(2)   27/    980E : 6B26                		bmi.s	Anim_End_FF			; if ID is negative, this is a special flag, branch
