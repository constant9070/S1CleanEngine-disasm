(1)  197/    16EA :                     
(1)  198/    16EA :                     ; the Nemesis decompressor uses prefix-free codes (no valid code is a prefix of a longer code)
(1)  199/    16EA :                     ; e.g. if 10 is a valid 2-bit code, 110 is a valid 3-bit code but 100 isn't
(1)  200/    16EA :                     ; also, when the actual compressed data is processed the high bit of each code is in bit position 7
(1)  201/    16EA :                     ; so the code needs to be bit-shifted appropriately over here before being used as a code table index
(1)  202/    16EA :                     ; additionally, the code needs multiple entries in the table because no masking is done during compressed data processing
(1)  203/    16EA :                     ; so if 11000 is a valid code then all indices of the form 11000XXX need to have the same entry
(1)  204/    16EA :                     NemBCT_ShortCode:
(1)  205/    16EA : 1018                		move.b	(a0)+,d0	; get code
(1)  206/    16EC : E368                		lsl.w	d1,d0	; get index into code table
(1)  207/    16EE : D040                		add.w	d0,d0	; shift so that high bit is in bit position 7
(1)  208/    16F0 : 7A01                		moveq	#1,d5
(1)  209/    16F2 : E36D                		lsl.w	d1,d5
(1)  210/    16F4 : 5345                		subq.w	#1,d5	; d5 = 2^d1 - 1
(1)  211/    16F6 :                     
(1)  212/    16F6 :                     NemBCT_ShortCode_Loop:
(1)  213/    16F6 : 3387 0000           		move.w	d7,(a1,d0.w)	; store entry
(1)  214/    16FA : 5440                		addq.w	#2,d0	; increment index
(1)  215/    16FC : 51CD FFF8           		dbf	d5,NemBCT_ShortCode_Loop	; repeat for required number of entries
(1)  216/    1700 : 60BA                		bra.s	NemBCT_Loop
