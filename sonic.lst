(1)  282/       0 :                     		andi.w	#$FF80,d1
(1)  283/       0 :                     		sub.w	d1,d0		; approx distance between object and screen
(1)  284/       0 :                     	if ("bmicheck"<>"")
(1)  285/       0 :                     		; This bmi is in a few out_of_range calls (albeit redundant)
(1)  286/       0 :                     		bmi.w	exit
(1)  287/       0 :                     	endif
(1)  288/       0 :                     		cmpi.w	#128+320+192,d0
(1)  289/       0 :                     		bhi.ATTRIBUTE	exit
(1)  290/       0 :                     		endm
