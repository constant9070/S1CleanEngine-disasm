    3524/    4996 :                     
    3525/    4996 : (MACRO)              		disable_ints				; disable interrupts
    3525/    4996 : 46FC 2700                           move.w  #$2700,sr
    3526/    499A : (MACRO)              		disable_display				; disable screen output
    3526/    499A : 3038 F60C                           move.w  (v_vdp_buffer1).w,d0            ; get buffered copy of VDP register $81
    3526/    499E : 0200 00BF                           andi.b  #%10111111,d0                   ; clear bit 6 (disable display; fill with background color)
    3526/    49A2 : 33C0 00C0 0004                      move.w  d0,(vdp_control_port).l         ; write to VDP
    3527/    49A8 : 6100 CC0A           		bsr.w	ClearScreen			; wipe the screen
    3528/    49AC : 4DF9 00C0 0004      		lea	(vdp_control_port).l,a6		; load VDP control port
    3529/    49B2 : 3CBC 8B03           		move.w	#$8B03,(a6)			; line scroll mode (per-row horizontally, full-screen vertically)
    3530/    49B6 : 3CBC 8230           		move.w	#$8200+(vram_fg>>10),(a6)	; set foreground nametable address
    3531/    49BA : 3CBC 8407           		move.w	#$8400+(vram_bg>>13),(a6)	; set background nametable address
    3532/    49BE : 3CBC 857C           		move.w	#$8500+(vram_sprites>>9),(a6)	; set sprite table address
    3533/    49C2 : 3CBC 9001           		move.w	#$9001,(a6)			; 64-cell hscroll size
    3534/    49C6 : 3CBC 8004           		move.w	#$8004,(a6)			; 8-colour mode
    3535/    49CA : 3CBC 8720           		move.w	#$8720,(a6)			; set background colour (line 3; colour 0)
    3536/    49CE : 31FC 8ADF F624      		move.w	#$8A00+223,(v_hblank_hreg).w	; set palette change position (for water)
    3537/    49D4 : 3CB8 F624           		move.w	(v_hblank_hreg).w,(a6)		; write to VDP
    3538/    49D8 : 31FC 001E FE14      		move.w	#30,(v_air).w			; replenish air
    3539/    49DE :                     
    3540/    49DE : 31FC 0600 FE10      		move.w	#id_EndZ_good,(v_zone_act).w	; set to good ending by default (level number 600, extra flowers)
    3541/    49E4 : 0C38 0006 FE57      		cmpi.b	#ss_emeralds_num,(v_emeralds).w	; do you have all 6 emeralds?
    3542/    49EA : 6706                		beq.s	End_LoadData			; if yes, use good ending
    3543/    49EC : 31FC 0601 FE10      		move.w	#id_EndZ_bad,(v_zone_act).w	; otherwise, set to bad ending (level number 601, no extra flowers)
    3544/    49F2 :                     
    3545/    49F2 :                     End_LoadData:
    3546/    49F2 : 700C                		moveq	#plcid_Ending,d0		; load ending sequence patterns (GHZ art, animals, etc.)
    3547/    49F4 : 6100 CFA8           		bsr.w	QuickPLC			; execute PLCs immediately (no queue)
    3548/    49F8 : 4EB9 0001 28C4      		jsr	(Hud_Base).l			; load basic HUD graphics (only in levels, not in the ending demos)
    3549/    49FE : 6100 0C18           		bsr.w	LevelSizeLoad			; load level size and set default level boundaries
    3550/    4A02 : 6100 0E62           		bsr.w	DeformLayers			; initialize background deformation
    3551/    4A06 : 08F8 0002 F754      		bset	#2,(v_fg_scroll_flags).w	; draw an extra column at the left side of the screen during level start
    3552/    4A0C : 6100 19E0           		bsr.w	LevelDataLoad			; load block mappings and palettes
    3553/    4A10 : 6100 1898           		bsr.w	LoadTilesFromStart		; fully draw the foreground and background once before fade-in
    3554/    4A14 : 41F9 0003 EC42      		lea	(Col_GHZ_1).l,a0		; MJ: Set first collision for ending
    3555/    4A1A : 43F8 9000           		lea	(v_collision1).w,a1
    3556/    4A1E : 6100 CE8C           		bsr.w	KosDec
    3557/    4A22 : 41F9 0003 ED22      		lea	(Col_GHZ_2).l,a0		; MJ: Set second collision for ending
    3558/    4A28 : 43F8 9300           		lea	(v_collision2).w,a1
    3559/    4A2C : 6100 CE7E           		bsr.w	KosDec
    3560/    4A30 : (MACRO)              		enable_ints				; enable interrupts
    3560/    4A30 : 46FC 2300                           move.w  #$2300,sr
    3561/    4A34 : 41F9 0003 BB94      		lea	(Kos_EndFlowers).l,a0		; load extra flower patterns
    3562/    4A3A : 43F9 00FF 1000      		lea	(v_128x128+$20*chunk_size_128).l,a1 ; RAM address to buffer the patterns (overwriting unused chunk RAM)
    3563/    4A40 : 6100 CE6A           		bsr.w	KosDec				; decompress Kosinski-compressed chunks mappings to buffer
    3564/    4A44 : 7003                		moveq	#palid_Sonic,d0			; load Sonic's palette...
    3565/    4A46 : 6100 D418           		bsr.w	PalLoad_Fade			; ...to fade-in buffer
    3566/    4A4A : 303C 000B           		move.w	#bgm_Ending,d0			; play ending sequence music
    3567/    4A4E : 6100 CC34           		bsr.w	QueueSound1			; play it
    3568/    4A52 :                     
    3570/    4A52 :                     		; Fix being able to enable debug mode without having entered the cheat code for it
