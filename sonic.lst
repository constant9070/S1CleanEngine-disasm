(1)  218/    1186 :                     	cmpa.w	#VDP_Command_Buffer_Slot,a1
(1)  219/    1186 :                     	beq.s	.done												; Return if there's no more room in the buffer
(1)  220/    1186 :                     	move.b	#(dmaLength(length)>>8)&$FF,DMAEntry.SizeH(a1)		; Write top byte of size/2
(1)  221/    1186 :                     	move.l	#((dmaLength(length)&$FF)<<24)|dmaSource(src),d0	; Set d0 to bottom byte of size/2 and the low 3 bytes of source/2
