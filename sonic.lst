     800/     C84 :                     
     801/     C84 :                     		; The following code handles an awkward visual glitch for the LZ water surface.
     802/     C84 :                     		; If the surface is near the top of the screen (within 96 pixels), the VDP would not have
     803/     C84 :                     		; enough time to do all the transfers in VBlank_UpdateScreen before the palette needs to get
     804/     C84 :                     		; changed for the water. Without this special check, the water surface would violently flicker
     805/     C84 :                     		; whenever it's near the top of the screen. It's a rather dirty workaround, but it works.
     806/     C84 : 0C38 0060 F625      		cmpi.b	#96,(v_hblank_line).w		; is LZ water surface within 96 pixels of the top of the screen?
     807/     C8A : 640C                		bhs.s	VBlank_UpdateScreen		; if not, do screen updates now
     808/     C8C : 11FC 0001 F64F      		move.b	#1,(f_doupdatesinhblank).w	; otherwise, we don't have enough time to do them now before HBlank hits, defer updates to then
     809/     C92 : 588F                		addq.l	#4,sp				; skip return address (i.e. postpone updating the sound driver as well)
     810/     C94 : 6000 FE3C           		bra.w	VBlank_Exit			; go straight back to to the VBlank exit
