(1)    3/    B4AC :                     ; Subroutine to check if an object is off screen
(1)    4/    B4AC :                     ;
(1)    5/    B4AC :                     ; output:
(1)    6/    B4AC :                     ;	d0 = 0 if on screen, 1 if off screen
(1)    7/    B4AC :                     ; ---------------------------------------------------------------------------
(1)    8/    B4AC :                     
(1)    9/    B4AC :                     ChkObjectVisible:
(1)   10/    B4AC : 3028 0008           		move.w	obX(a0),d0			; get object x-position
(1)   11/    B4B0 : 9078 F700           		sub.w	(v_screenposx).w,d0		; subtract screen x-position
(1)   12/    B4B4 : 6B1A                		bmi.s	.offscreen			; branch if object is off screen to the left
(1)   13/    B4B6 : 0C40 0140           		cmpi.w	#320,d0				; is object on screen?
(1)   14/    B4BA : 6C14                		bge.s	.offscreen			; if not, object is off screen to the right
(1)   15/    B4BC :                     
(1)   16/    B4BC : 3228 000C           		move.w	obY(a0),d1			; get object y-position
(1)   17/    B4C0 : 9278 F704           		sub.w	(v_screenposy).w,d1		; subtract screen y-position
(1)   18/    B4C4 : 6B0A                		bmi.s	.offscreen			; branch if object is off screen to the top
(1)   19/    B4C6 : 0C41 00E0           		cmpi.w	#224,d1				; is object on screen?
(1)   20/    B4CA : 6C04                		bge.s	.offscreen			; if not, object is off screen to the bottom
(1)   21/    B4CC :                     
(1)   22/    B4CC : 7000                		moveq	#0,d0				; set Z-flag (object on screen)
(1)   23/    B4CE : 4E75                		rts
