(1)  236/   11854 :                     ; ---------------------------------------------------------------------------
(1)  237/   11854 :                     ; Palette cycle data for square blocks in Special Stages.
(1)  238/   11854 :                     ; - Four sets for the four wall types. Each set has same blinking pattern:
(1)  239/   11854 :                     ;   nBnnnnnB twice (n = normal palette, B = blinking palette)
(1)  240/   11854 :                     ; - Blinking palette line is the one before the normal one (i.e. -1)
(1)  241/   11854 :                     ; - All values are technically complete VRAM settings with the art tile,
(1)  242/   11854 :                     ;   but the only difference between each value is the palette line
(1)  243/   11854 :                     ; ---------------------------------------------------------------------------
(1)  244/   11854 :                     
(1)  245/   11854 :                     sswallpal: macro paletteline
(1)  246/   11854 :                     	set normal, ArtTile_SS_Wall|(paletteline<<13)
(1)  247/   11854 :                     	set blink,  ArtTile_SS_Wall|(((paletteline-1)&3)<<13)
(1)  248/   11854 :                     	rept 2
(1)  249/   11854 :                     		dc.w normal,  blink, normal, normal
(1)  250/   11854 :                     		dc.w normal, normal, normal,  blink
(1)  251/   11854 :                     	endr
(1)  252/   11854 :                     	endm
(1)  253/   11854 :                     
