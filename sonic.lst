(1)   84/    1B96 :                     ; ===========================================================================
(1)   85/    1B96 :                     
(1)   86/    1B96 :                     ; The fade-in logic increases one RGB value at a time until the target color
(1)   87/    1B96 :                     ; has been reached. Sonic 1 fades blue first, then green, then red, resulting
(1)   88/    1B96 :                     ; in the characteristic blue-tinted fade seen throughout the entire game.
(1)   89/    1B96 :                     ; A simultaneous RGB fade would appear more natural, but would also complete
(1)   90/    1B96 :                     ; much faster. This staggered approach may have been chosen to extend
(1)   91/    1B96 :                     ; the fade duration while giving it a distinct visual style.
(1)   92/    1B96 :                     
(1)   93/    1B96 :                     FadeIn_AddColor:
(1)   94/    1B96 : 3419                		move.w	(a1)+,d2				; get current target color (and advance index for next color)
(1)   95/    1B98 : 3610                		move.w	(a0),d3					; get current active color
(1)   96/    1B9A : B642                		cmp.w	d2,d3					; has active color already reached its target level?
(1)   97/    1B9C : 6720                		beq.s	.nextColor				; if yes, fade is done for this color
(1)   98/    1B9E :                     
(1)   99/    1B9E :                     	.addBlue:
(1)  100/    1B9E : 3203                		move.w	d3,d1					; get current active color
(1)  101/    1BA0 : 0641 0200           		addi.w	#$200,d1				; increase blue value by one step
(1)  102/    1BA4 : B242                		cmp.w	d2,d1					; has blue exceeded target level?
(1)  103/    1BA6 : 6204                		bhi.s	.addGreen				; if yes, start fading in green
(1)  104/    1BA8 : 30C1                		move.w	d1,(a0)+				; update active color
(1)  105/    1BAA : 4E75                		rts						; do not update green or red values until blue is done
