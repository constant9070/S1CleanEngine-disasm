(1) 2997/    EFC0 : 6522                		blo.s	.SetPanVal		; If not, branch
(1) 2998/    EFC2 : 323C 0100           		move.w	#((320+ExtraWidth)/2)+64,d1		; Cap the camera's position
(1) 2999/    EFC6 : 601C                		bra.s	.SetPanVal
