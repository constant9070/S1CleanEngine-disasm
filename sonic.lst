    1456/    1A08 :                     
    1457/    1A08 : 6100 FEA2           		bsr.w	PLC_Decompressor			; decompress module to buffer using the specified decompressor
    1458/    1A0C :                     
    1460/    1A0C :                     		; Regular Kosinski-Moduled compression has a unique quirk not found in any other moduled compression:
    1461/    1A0C :                     		; "[...] all modules but the last are padded out to a size which is a multiple of $10 bytes."
    1462/    1A0C :                     		; Because of this, we need to manually adjust the compressed art pointer to account for it.
    1463/    1A0C : 2038 F6F6           		move.l	(v_plc_ArtPtr).w,d0			; get base compressed art offset before decompression began
    1464/    1A10 : 9088                		sub.l	a0,d0					; subtract by actual end of pointer after compression
    1465/    1A12 : 0280 0000 000F      		andi.l	#$F,d0					; default limit is a maximum of 16 KosM padding bytes
    1466/    1A18 : D1C0                		adda.l	d0,a0					; adjust final art pointer to account for KosM padding
    1468/    1A1A : 21C8 F6F6           		move.l	a0,(v_plc_ArtPtr).w			; remember compressed art pointer
    1469/    1A1E :                     
