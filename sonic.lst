    4011/    5618 :                     ; >>> Level rendering, loading, and updating
    4012/    5618 :                     		include	"_inc/LevelSizeLoad & BgScrollSpeed.asm" ; merged with "LevelSizeLoad & BgScrollSpeed (JP1).asm"
(1)    1/    5618 :                     ; ===========================================================================
