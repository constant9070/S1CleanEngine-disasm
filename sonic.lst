(1)    4/    2A8A :                     
(1)    5/    2A8A :                     RandomNumber:
(1)    6/    2A8A : 2238 F636           		move.l	(v_random).w,d1			; load current pseudo random number
(1)    7/    2A8E : 6606                		bne.s	.scramble			; if it's not 0, branch
(1)    8/    2A90 : 223C 2A6D 365A      		move.l	#$2A6D365A,d1			; set initial/starting seed
(1)    9/    2A96 :                     
(1)   10/    2A96 :                     .scramble:
(1)   11/    2A96 : 2001                		move.l	d1,d0				; copy to d0
(1)   12/    2A98 : E581                		asl.l	#2,d1				; shift left two bits
(1)   13/    2A9A : D280                		add.l	d0,d1				; add original to shifted
(1)   14/    2A9C : E781                		asl.l	#3,d1				; shift left three more bits
(1)   15/    2A9E : D280                		add.l	d0,d1				; add original again
(1)   16/    2AA0 : 3001                		move.w	d1,d0				; load lower word of shifted to original
(1)   17/    2AA2 : 4841                		swap	d1				; get upper word
(1)   18/    2AA4 : D041                		add.w	d1,d0				; add upper to lower
(1)   19/    2AA6 : 3200                		move.w	d0,d1				; save back to d1
(1)   20/    2AA8 : 4841                		swap	d1				; swap upper and lower back
(1)   21/    2AAA : 21C1 F636           		move.l	d1,(v_random).w			; save result for next time
(1)   22/    2AAE : 4E75                		rts					; return (d0 contains pseudo-random number)
(1)   23/    2AB0 :                     ; End of function RandomNumber
