(1)   48/    B4E6 : D241                		add.w	d1,d1				; double width for undoing above addition and right-side check
(1)   49/    B4E8 : 9041                		sub.w	d1,d0				; sub object display width
(1)   50/    B4EA : 0C40 0140           		cmpi.w	#320,d0				; is object on screen?
(1)   51/    B4EE : 6C20                		bge.s	.offscreen			; if not, object is off screen to the right
(1)   52/    B4F0 :                     
