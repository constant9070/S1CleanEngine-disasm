    3447/    4160 : 6710                		beq.s	.return				; if yes, branch
    3448/    4162 : B278 F728           		cmp.w	(v_limitleft2).w,d1		; has left boundary already been locked?
    3449/    4166 : 670A                		beq.s	.return				; if yes, branch
    3450/    4168 : 31C1 F728           		move.w	d1,(v_limitleft2).w		; lock left level boundary to current screen position
