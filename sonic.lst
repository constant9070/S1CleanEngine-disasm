(1)  286/   118EA :                     ; ===========================================================================
(1)  287/   118EA :                     ; ---------------------------------------------------------------------------
(1)  288/   118EA :                     ; Subroutine to animate special stage items when you touch them.
(1)  289/   118EA :                     ; This system uses a buffer of animation events that are added through the
(1)  290/   118EA :                     ; above SS_FindFreeAnimationSlot subroutine.
(1)  291/   118EA :                     ; 
(1)  292/   118EA :                     ; Each slot is 8 bytes in size, broken down like so:
(1)  293/   118EA :                     ;	0   - animation ID (1-based; zero implies empty slot)
(1)  294/   118EA :                     ;	1   - (unused)
(1)  295/   118EA :                     ;	2   - frame delay between animation advancements
(1)  296/   118EA :                     ;	3   - current index ID in animation script
(1)  297/   118EA :                     ;	4-7 - RAM location of target block in stage layout
(1)  298/   118EA :                     ; ---------------------------------------------------------------------------
(1)  299/   118EA : =$0                  ss_ani_id:	equ 0
(1)  300/   118EA : =$2                  ss_ani_delay:	equ 2
(1)  301/   118EA : =$3                  ss_ani_frame:	equ 3
(1)  302/   118EA : =$4                  ss_ani_block:	equ 4
(1)  303/   118EA :                     ; ---------------------------------------------------------------------------
(1)  304/   118EA :                     
(1)  305/   118EA :                     ; SS_AniItems:
(1)  306/   118EA :                     SS_ExecuteAnimationQueue:
(1)  307/   118EA : 41F9 00FF 4400      		lea	(v_ss_animations).l,a0			; load start address of animation event buffer
(1)  308/   118F0 : 3E3C 001F           		move.w	#(v_ss_animations_end-v_ss_animations)/8-1,d7 ; set to iterate through all slots
(1)  309/   118F4 :                     
(1)  310/   118F4 :                     	.loop:
(1)  311/   118F4 : 7000                		moveq	#0,d0					; clear d0
(1)  312/   118F6 : 1010                		move.b	ss_ani_id(a0),d0			; get potential animation event
(1)  313/   118F8 : 6708                		beq.s	.nextslot				; if slot has none, branch
(1)  314/   118FA : E548                		lsl.w	#2,d0					; multiply ID by 4 for long-based indexing
(1)  315/   118FC : 227B 0008           		movea.l	SS_AniIndex-4(pc,d0.w),a1		; get animation entry in jump table (-4 because these IDs are 1-based)
(1)  316/   11900 : 4E91                		jsr	(a1)					; execute animation and return
(1)  317/   11902 :                     
(1)  318/   11902 :                     	.nextslot:
(1)  319/   11902 : 5048                		addq.w	#8,a0					; go to next animation event slot
(1)  320/   11904 : 51CF FFEE           		dbf	d7,.loop				; loop until all event slots were checked
(1)  321/   11908 : 4E75                		rts						; return
