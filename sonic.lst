(1)    2/    3D96 :                     ; Water data
(1)    3/    3D96 :                     ; One entry per zone and act, in zone order (4 acts per zone, 8 bytes each).
(1)    4/    3D96 :                     ;
(1)    5/    3D96 :                     ;	byte 0:	water flag (0 = this zone/act has no water, 1 = it has water)
(1)    6/    3D96 :                     ;	byte 1:	palette ID loaded for the level underwater
(1)    7/    3D96 :                     ;	byte 2:	palette ID loaded for Sonic underwater
(1)    8/    3D96 :                     ;	byte 3:	dynamic water routine number (0 = none, 1 = first entry of DynWater_Index, ...)
(1)    9/    3D96 :                     ;	word 4:	starting water height
(1)   10/    3D96 :                     ;	word 6:	unused (padding to 8 bytes)
(1)   11/    3D96 :                     ;
(1)   12/    3D96 :                     ; The water flag is also the water's speed in pixels per frame, so keep it at 1.
(1)   13/    3D96 :                     ;
(1)   14/    3D96 :                     ; To give another zone/act water, change its entry here. Nothing else in
(1)   15/    3D96 :                     ; GM_Level needs to know which zones have water.
(1)   16/    3D96 :                     ; ---------------------------------------------------------------------------
