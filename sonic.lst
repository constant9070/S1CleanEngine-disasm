    4441/   107C4 :                     		include "_inc/ConvertCollisionArray (Unused).asm"
(1)    1/   107C4 :                     ; ===========================================================================
(1)    2/   107C4 :                     ; ---------------------------------------------------------------------------
(1)    3/   107C4 :                     ; Unused/dead subroutine that was likely used during development.
(1)    4/   107C4 :                     
(1)    5/   107C4 :                     ; This subroutine takes 'raw' bitmap-like collision block data as input and
(1)    6/   107C4 :                     ; converts it into the proper collision arrays (ColArray and ColArray2).
(1)    7/   107C4 :                     ; Pointers to said raw data are dummied out.
(1)    8/   107C4 :                     ; Curiously, an example of the original 'raw' data that this was intended
(1)    9/   107C4 :                     ; to process can be found in the J2ME version, in a file called 'blkcol.bct'.
(1)   10/   107C4 :                     ; ---------------------------------------------------------------------------
(1)   11/   107C4 : =$49CCC              RawColBlocks		equ CollArray1
(1)   12/   107C4 : =$49CCC              ConvRowColBlocks	equ CollArray1
(1)   13/   107C4 :                     ; ---------------------------------------------------------------------------
(1)   14/   107C4 :                     
(1)   15/   107C4 :                     ConvertCollisionArray:
(1)   16/   107C4 : 4E75                		rts
(1)   17/   107C6 :                     ; ---------------------------------------------------------------------------
(1)   18/   107C6 :                     
(1)   19/   107C6 :                     		; The raw format stores the collision data column by column for the normal collision array.
(1)   20/   107C6 :                     		; This makes a copy of the data, but stored row by row, for the rotated collision array.
(1)   21/   107C6 : 43F9 0004 9CCC      		lea	(RawColBlocks).l,a1	; Source location of raw collision block data
(1)   22/   107CC : 45F9 0004 9CCC      		lea	(ConvRowColBlocks).l,a2	; Destination location for row-converted collision block data
