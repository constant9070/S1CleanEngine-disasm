(1)  265/    119C :                     		; Detect if transfer crosses 128KB boundary
(1)  266/    119C :                     		; Using sub+sub instead of move+add handles the following edge cases:
(1)  267/    119C :                     		; (1) d3.w == 0 => 128kB transfer
(1)  268/    119C :                     		;   (a) d1.w == 0 => no carry, don't split the DMA
(1)  269/    119C :                     		;   (b) d1.w != 0 => carry, need to split the DMA
(1)  270/    119C :                     		; (2) d3.w != 0
(1)  271/    119C :                     		;   (a) if there is carry on d1.w + d3.w
(1)  272/    119C :                     		;     (* ) if d1.w + d3.w == 0 => transfer comes entirely from current 128kB block, don't split the DMA
(1)  273/    119C :                     		;     (**) if d1.w + d3.w != 0 => need to split the DMA
(1)  274/    119C :                     		;   (b) if there is no carry on d1.w + d3.w => don't split the DMA
(1)  275/    119C :                     		; The reason this works is that carry on d1.w + d3.w means that
(1)  276/    119C :                     		; d1.w + d3.w >= $10000, whereas carry on (-d3.w) - (d1.w) means that
(1)  277/    119C :                     		; d1.w + d3.w > $10000.
