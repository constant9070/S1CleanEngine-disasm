     570/     540 :                     ErrorWaitForC:
     571/     540 :                     		; Let the game's own VBlank handler run the sound driver (and so MegaPCM)
     572/     540 :                     		; exactly like it does during normal play. With no VBlank routine set it
     573/     540 :                     		; takes the "lag frame" path, which only updates the music.
     574/     540 : 4238 F62A           		clr.b	(v_vblank_routine).w		; every frame is treated as a lag frame
     575/     544 : 4238 F64C           		clr.b	(f_water).w			; stop the LZ lag path from touching the palette
     576/     548 : (MACRO)              		enable_ints				; allow VBlank to fire again
     576/     548 : 46FC 2300                           move.w  #$2300,sr
     577/     54C :                     
     578/     54C :                     .waitforC:
     579/     54C : 6100 0B18           		bsr.w	ReadJoypads			; keep reading joypads
     580/     550 : 0C38 0020 F605      		cmpi.b	#btnC,(v_jpadpress1).w		; has button C been pressed?
     581/     556 : 66F4                		bne.s	.waitforC			; if not, keep looping
     582/     558 :                     
     583/     558 : (MACRO)              		disable_ints				; back to normal before trying to recover
     583/     558 : 46FC 2700                           move.w  #$2700,sr
     584/     55C : 4E75                		rts					; return to try recovering execution
     585/     55E :                     ; End of function ErrorWaitForC
