(1)  521/   125FC :                     SS_FindUnbeatenStage:
(1)  522/   125FC :                     		; Skip special stages whose emerald has already been collected. The game cycles through stage IDs
(1)  523/   125FC :                     		; using v_lastspecial: If the selected stage matches an entry in v_emldlist, execution branches
(1)  524/   125FC :                     		; back to SS_Load and the next stage is selected. This repeats until an unbeaten stage is found.
(1)  525/   125FC : 0C38 0006 FE57      		cmpi.b	#ss_emeralds_num,(v_emeralds).w		; do you already have all emeralds?
(1)  526/   12602 : 671A                		beq.s	SS_LoadData				; if yes, load stage anyway (should not happen, probably a failsafe)
(1)  527/   12604 : 7200                		moveq	#0,d1					; clear d1
(1)  528/   12606 : 1238 FE57           		move.b	(v_emeralds).w,d1			; get number of already collected emeralds
(1)  529/   1260A : 5301                		subq.b	#1,d1					; subtract 1 for dbf
(1)  530/   1260C : 6510                		blo.s	SS_LoadData				; if it underflowed, no emeralds have been collected so far
(1)  531/   1260E : 47F8 FE58           		lea	(v_emldlist).w,a3			; load array of already collected emeralds
(1)  532/   12612 :                     	.chkEmldLoop:
(1)  533/   12612 : B033 1000           		cmp.b	(a3,d1.w),d0				; does this collected emerald belong to the selected stage?
(1)  534/   12616 : 6602                		bne.s	.chkNext				; if not, check the next entry
(1)  535/   12618 : 60CA                		bra.s	SS_Load					; repeat SS_Load, increase v_lastspecial, try another stage
(1)  536/   1261A :                     	.chkNext:
(1)  537/   1261A : 51C9 FFF6           		dbf	d1,.chkEmldLoop				; check all collected emeralds
