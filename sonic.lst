(2)   40/   4B9B8 : =$B1..$B6            	nextenum	nC4=nBs3,nCs4,nDb4=nCs4,nD4,nDs4,nEb4=nDs4,nE4,nFb4=nE4,nEs4,nF4=nEs4
(2)   41/   4B9B8 : =$B7..$BD            	nextenum	nFs4,nGb4=nFs4,nG4,nGs4,nAb4=nGs4,nA4,nAs4,nBb4=nAs4,nB4,nCb5=nB4,nBs4
(2)   42/   4B9B8 : =$BD..$C2            	nextenum	nC5=nBs4,nCs5,nDb5=nCs5,nD5,nDs5,nEb5=nDs5,nE5,nFb5=nE5,nEs5,nF5=nEs5
(2)   43/   4B9B8 : =$C3..$C9            	nextenum	nFs5,nGb5=nFs5,nG5,nGs5,nAb5=nGs5,nA5,nAs5,nBb5=nAs5,nB5,nCb6=nB5,nBs5
(2)   44/   4B9B8 : =$C9..$CE            	nextenum	nC6=nBs5,nCs6,nDb6=nCs6,nD6,nDs6,nEb6=nDs6,nE6,nFb6=nE6,nEs6,nF6=nEs6
(2)   45/   4B9B8 : =$CF..$D5            	nextenum	nFs6,nGb6=nFs6,nG6,nGs6,nAb6=nGs6,nA6,nAs6,nBb6=nAs6,nB6,nCb7=nB6,nBs6
(2)   46/   4B9B8 : =$D5..$DA            	nextenum	nC7=nBs6,nCs7,nDb7=nCs7,nD7,nDs7,nEb7=nDs7,nE7,nFb7=nE7,nEs7,nF7=nEs7
(2)   47/   4B9B8 : =$DB..$DF            	nextenum	nFs7,nGb7=nFs7,nG7,nGs7,nAb7=nGs7,nA7,nAs7,nBb7=nAs7
(2)   48/   4B9B8 :                     ; SMPS2ASM uses nMaxPSG for songs from S1/S2 drivers.
(2)   49/   4B9B8 :                     ; nMaxPSG1 and nMaxPSG2 are used only for songs from S3/S&K/S3D drivers.
(2)   50/   4B9B8 :                     ; The use of psgdelta is intended to undo the effects of PSGPitchConvert
(2)   51/   4B9B8 :                     ; and ensure that the ending note is indeed the maximum PSG frequency.
(2)   53/   4B9B8 : =$C6                 nMaxPSG				EQU nA5
(2)   54/   4B9B8 : =$D2                 nMaxPSG1			EQU nA5+psgdelta
(2)   55/   4B9B8 : =$D2                 nMaxPSG2			EQU nA5+psgdelta
(2)   61/   4B9B8 :                     ; ---------------------------------------------------------------------------
(2)   62/   4B9B8 :                     ; PSG volume envelope equates
(2)   65/   4B9B8 : =$1..$6              			enum		fTone_01=$01,fTone_02,fTone_03,fTone_04,fTone_05,fTone_06
(2)   66/   4B9B8 : =$7..$9              			nextenum	fTone_07,fTone_08,fTone_09
(2)   86/   4B9B8 :                     ; ---------------------------------------------------------------------------
(2)   87/   4B9B8 :                     ; DAC Equates
(2)   90/   4B9B8 : =$81..$83            			enum		dKick=$81,dSnare,dTimpani
(2)   91/   4B9B8 : =$88..$8B            			enum		dHiTimpani=$88,dMidTimpani,dLowTimpani,dVLowTimpani
(2)  169/   4B9B8 :                     ; ---------------------------------------------------------------------------
(2)  170/   4B9B8 :                     ; Channel IDs for SFX
(2)  171/   4B9B8 : =$80                 cPSG1				EQU $80
(2)  172/   4B9B8 : =$A0                 cPSG2				EQU $A0
(2)  173/   4B9B8 : =$C0                 cPSG3				EQU $C0
(2)  174/   4B9B8 : =$E0                 cNoise				EQU $E0	; Not for use in S3/S&K/S3D
(2)  175/   4B9B8 : =$2                  cFM3				EQU $02
(2)  176/   4B9B8 : =$4                  cFM4				EQU $04
(2)  177/   4B9B8 : =$5                  cFM5				EQU $05
(2)  178/   4B9B8 : =$6                  cFM6				EQU $06	; Only in S3/S&K/S3D, overrides DAC
(2)  179/   4B9B8 :                     ; ---------------------------------------------------------------------------
(2)  180/   4B9B8 :                     ; Conversion macros and functions
(2)  181/   4B9B8 :                     
(2)  182/   4B9B8 :                     conv0To256  function n,((n==0)<<8)|n
(2)  183/   4B9B8 :                     s2TempotoS1 function n,(((768-n)>>1)/(256-n))&$FF
(2)  184/   4B9B8 :                     s2TempotoS3 function n,($100-((n==0)|n))&$FF
(2)  185/   4B9B8 :                     s1TempotoS2 function n,((((conv0To256(n)-1)<<8)+(conv0To256(n)>>1))/conv0To256(n))&$FF
(2)  186/   4B9B8 :                     s1TempotoS3 function n,s2TempotoS3(s1TempotoS2(n))
(2)  187/   4B9B8 :                     s3TempotoS1 function n,s2TempotoS1(s2TempotoS3(n))
(2)  188/   4B9B8 :                     s3TempotoS2 function n,s2TempotoS3(n)
(2)  189/   4B9B8 :                     
(2)  190/   4B9B8 :                     convertMainTempoMod macro mod
(2)  191/   4B9B8 :                     	if ((SourceDriver>=3)&&(SonicDriverVer>=3))||(SonicDriverVer==SourceDriver)
(2)  192/   4B9B8 :                     		dc.b	mod
(2)  193/   4B9B8 :                     	elseif SourceDriver==1
(2)  194/   4B9B8 :                     		if mod==1
(2)  195/   4B9B8 :                     			fatal "Invalid main tempo of 1 in song from Sonic 1"
(2)  196/   4B9B8 :                     		endif
(2)  197/   4B9B8 :                     		if SonicDriverVer==2
(2)  198/   4B9B8 :                     			dc.b	s1TempotoS2(mod)
(2)  199/   4B9B8 :                     		else;if SonicDriverVer>=3
(2)  200/   4B9B8 :                     			dc.b	s1TempotoS3(mod)
(2)  201/   4B9B8 :                     		endif
(2)  202/   4B9B8 :                     	elseif SourceDriver==2
(2)  203/   4B9B8 :                     		if mod==0
(2)  204/   4B9B8 :                     			fatal "Invalid main tempo of 0 in song from Sonic 2"
(2)  205/   4B9B8 :                     		endif
(2)  206/   4B9B8 :                     		if SonicDriverVer==1
(2)  207/   4B9B8 :                     			dc.b	s2TempotoS1(mod)
(2)  208/   4B9B8 :                     		else;if SonicDriverVer>=3
(2)  209/   4B9B8 :                     			dc.b	s2TempotoS3(mod)
(2)  210/   4B9B8 :                     		endif
(2)  211/   4B9B8 :                     	else;if SourceDriver>=3
(2)  212/   4B9B8 :                     		if mod==0
(2)  213/   4B9B8 :                     			message "Performing approximate conversion of Sonic 3 main tempo modifier of 0"
(2)  214/   4B9B8 :                     		endif
(2)  215/   4B9B8 :                     		if SonicDriverVer==1
(2)  216/   4B9B8 :                     			dc.b	s3TempotoS1(mod)
(2)  217/   4B9B8 :                     		else;if SonicDriverVer==2
(2)  218/   4B9B8 :                     			dc.b	s3TempotoS2(mod)
(2)  219/   4B9B8 :                     		endif
(2)  220/   4B9B8 :                     	endif
(2)  221/   4B9B8 :                     	endm
(2)  222/   4B9B8 :                     
(2)  223/   4B9B8 :                     ; PSG conversion to S3/S&K/S3D drivers require a tone shift of 12 semi-tones.
(2)  224/   4B9B8 :                     PSGPitchConvert macro pitch
(2)  225/   4B9B8 :                     	if (SonicDriverVer>=3)&&(SourceDriver<3)
(2)  226/   4B9B8 :                     		dc.b	(pitch+psgdelta)&$FF
(2)  227/   4B9B8 :                     	elseif (SonicDriverVer<3)&&(SourceDriver>=3)
(2)  228/   4B9B8 :                     		dc.b	(pitch-psgdelta)&$FF
(2)  229/   4B9B8 :                     	else
(2)  230/   4B9B8 :                     		dc.b	pitch
(2)  231/   4B9B8 :                     	endif
(2)  232/   4B9B8 :                     	endm
(2)  233/   4B9B8 :                     
(2)  234/   4B9B8 :                     CheckedChannelPointer macro loc
(2)  235/   4B9B8 :                     	if SonicDriverVer<>1
(2)  236/   4B9B8 :                     		dc.w	z80_ptr(loc)
(2)  237/   4B9B8 :                     	else
(2)  238/   4B9B8 :                     		if (MOMPASS=1)&&(DEFINED(loc))
(2)  239/   4B9B8 :                     			fatal "Tracks for Sonic 1 songs must come after the start of the song"
(2)  240/   4B9B8 :                     		endif
(2)  241/   4B9B8 :                     		dc.w	loc-songStart
(2)  242/   4B9B8 :                     	endif
(2)  243/   4B9B8 :                     	endm
(2)  244/   4B9B8 :                     ; ---------------------------------------------------------------------------
(2)  245/   4B9B8 :                     ; Header Macros
(2)  246/   4B9B8 :                     smpsHeaderStartSong macro ver, sourcesmps2asmver
(2)  247/   4B9B8 :                     
(2)  248/   4B9B8 :                     SourceDriver set ver
(2)  249/   4B9B8 :                     
(2)  250/   4B9B8 :                     	if ("sourcesmps2asmver"<>"")
(2)  251/   4B9B8 :                     		set SourceSMPS2ASM,sourcesmps2asmver
(2)  252/   4B9B8 :                     	else
(2)  253/   4B9B8 :                     		set SourceSMPS2ASM,0
(2)  254/   4B9B8 :                     	endif
(2)  255/   4B9B8 :                     
(2)  256/   4B9B8 :                     songStart set *
(2)  257/   4B9B8 :                     
(2)  258/   4B9B8 :                     	if MOMPASS=1
(2)  259/   4B9B8 :                     		if SMPS2ASMVer < SourceSMPS2ASM
(2)  260/   4B9B8 :                     			message "Song at 0x\{songStart} was made for a newer version of SMPS2ASM (this is version \{SMPS2ASMVer}, but song wants at least version \{SourceSMPS2ASM})."
(2)  261/   4B9B8 :                     		endif
(2)  262/   4B9B8 :                     	endif
(2)  263/   4B9B8 :                     
(2)  264/   4B9B8 :                     	endm
(2)  265/   4B9B8 :                     
(2)  266/   4B9B8 :                     smpsHeaderVoiceNull macro
(2)  267/   4B9B8 :                     	if songStart<>*
(2)  268/   4B9B8 :                     		fatal "Missing smpsHeaderStartSong"
(2)  269/   4B9B8 :                     	endif
(2)  270/   4B9B8 :                     	dc.w	$0000
(2)  271/   4B9B8 :                     	endm
(2)  272/   4B9B8 :                     
(2)  273/   4B9B8 :                     ; Header - Set up Voice Location
(2)  274/   4B9B8 :                     ; Common to music and SFX
(2)  275/   4B9B8 :                     smpsHeaderVoice macro loc
(2)  276/   4B9B8 :                     	if songStart<>*
(2)  277/   4B9B8 :                     		fatal "Missing smpsHeaderStartSong"
(2)  278/   4B9B8 :                     	endif
(2)  279/   4B9B8 :                     	if SonicDriverVer<>1
(2)  280/   4B9B8 :                     		dc.w	z80_ptr(loc)
(2)  281/   4B9B8 :                     	else
(2)  282/   4B9B8 :                     		if (MOMPASS=1)&&(DEFINED(loc))
(2)  283/   4B9B8 :                     			fatal "Voice banks for Sonic 1 songs must come after the start of the song"
(2)  284/   4B9B8 :                     		endif
(2)  285/   4B9B8 :                     		dc.w	loc-songStart
(2)  286/   4B9B8 :                     	endif
(2)  287/   4B9B8 :                     	endm
(2)  288/   4B9B8 :                     
(2)  289/   4B9B8 :                     ; Header - Set up Voice Location as S3's Universal Voice Bank
(2)  290/   4B9B8 :                     ; Common to music and SFX
(2)  291/   4B9B8 :                     smpsHeaderVoiceUVB macro
(2)  292/   4B9B8 :                     	if songStart<>*
(2)  293/   4B9B8 :                     		fatal "Missing smpsHeaderStartSong"
(2)  294/   4B9B8 :                     	endif
(2)  295/   4B9B8 :                     	if SonicDriverVer>=5
(2)  296/   4B9B8 :                     		dc.w	z80_ptr(z80_UniVoiceBank)
(2)  297/   4B9B8 :                     	elseif SonicDriverVer>=3
(2)  298/   4B9B8 :                     		dc.w	little_endian(z80_UniVoiceBank)
(2)  299/   4B9B8 :                     	else
(2)  300/   4B9B8 :                     		fatal "Universal Voice Bank does not exist in Sonic 1 or Sonic 2 drivers"
(2)  301/   4B9B8 :                     	endif
(2)  302/   4B9B8 :                     	endm
(2)  303/   4B9B8 :                     
(2)  304/   4B9B8 :                     ; Header macros for music (not for SFX)
(2)  305/   4B9B8 :                     ; Header - Set up Channel Usage
(2)  306/   4B9B8 :                     smpsHeaderChan macro fm,psg
(2)  307/   4B9B8 :                     	dc.b	fm,psg
(2)  308/   4B9B8 :                     	endm
(2)  309/   4B9B8 :                     
(2)  310/   4B9B8 :                     ; Header - Set up Tempo
(2)  311/   4B9B8 :                     smpsHeaderTempo macro div,mod
(2)  312/   4B9B8 :                     	dc.b	div
(2)  313/   4B9B8 :                     	convertMainTempoMod mod
(2)  314/   4B9B8 :                     	endm
(2)  315/   4B9B8 :                     
(2)  316/   4B9B8 :                     ; Header - Set up DAC Channel
(2)  317/   4B9B8 :                     smpsHeaderDAC macro loc,pitch,vol
(2)  318/   4B9B8 :                     	CheckedChannelPointer loc
(2)  319/   4B9B8 :                     	if ("pitch"<>"")
(2)  320/   4B9B8 :                     		dc.b	pitch
(2)  321/   4B9B8 :                     		if ("vol"<>"")
(2)  322/   4B9B8 :                     			dc.b	vol
(2)  323/   4B9B8 :                     		else
(2)  324/   4B9B8 :                     			dc.b	$00
(2)  325/   4B9B8 :                     		endif
(2)  326/   4B9B8 :                     	else
(2)  327/   4B9B8 :                     		dc.w	$00
(2)  328/   4B9B8 :                     	endif
(2)  329/   4B9B8 :                     	endm
(2)  330/   4B9B8 :                     
(2)  331/   4B9B8 :                     ; Header - Set up FM Channel
(2)  332/   4B9B8 :                     smpsHeaderFM macro loc,pitch,vol
(2)  333/   4B9B8 :                     	CheckedChannelPointer loc
(2)  334/   4B9B8 :                     	dc.b	pitch,vol
(2)  335/   4B9B8 :                     	endm
(2)  336/   4B9B8 :                     
(2)  337/   4B9B8 :                     ; Header - Set up PSG Channel
(2)  338/   4B9B8 :                     smpsHeaderPSG macro loc,pitch,vol,mod,voice
(2)  339/   4B9B8 :                     	CheckedChannelPointer loc
(2)  340/   4B9B8 :                     	PSGPitchConvert pitch
(2)  341/   4B9B8 :                     	dc.b	vol
(2)  342/   4B9B8 :                     	; Frequency envelope
(2)  343/   4B9B8 :                     	if (SonicDriverVer>=3) && (SourceDriver<3)
(2)  344/   4B9B8 :                     		; In SMPS 68k Type 1, this byte is skipped and can contain garbage.
(2)  345/   4B9B8 :                     		; Sonic 2's Oil Ocean Zone and Ending themes set this byte to a non-zero value which
(2)  346/   4B9B8 :                     		; other drivers may try to process as valid data, so manually force it to 0 here.
(2)  347/   4B9B8 :                     		dc.b	0
(2)  348/   4B9B8 :                     	else
(2)  349/   4B9B8 :                     		if (MOMPASS==1) && (SonicDriverVer<3) && (SourceDriver>=3) && (mod<>0)
(2)  350/   4B9B8 :                     			message "This track header specifies a frequency envelope, but this driver does not support them."			
(2)  351/   4B9B8 :                     		endif
(2)  352/   4B9B8 :                     		dc.b	mod
(2)  353/   4B9B8 :                     	endif
(2)  354/   4B9B8 :                     	; Volume envelope
(2)  355/   4B9B8 :                     	dc.b	voice
(2)  356/   4B9B8 :                     	endm
(2)  357/   4B9B8 :                     
(2)  358/   4B9B8 :                     ; Header macros for SFX (not for music)
(2)  359/   4B9B8 :                     ; Header - Set up Tempo
(2)  360/   4B9B8 :                     smpsHeaderTempoSFX macro div
(2)  361/   4B9B8 :                     	dc.b	div
(2)  362/   4B9B8 :                     	endm
(2)  363/   4B9B8 :                     
(2)  364/   4B9B8 :                     ; Header - Set up Channel Usage
(2)  365/   4B9B8 :                     smpsHeaderChanSFX macro chan
(2)  366/   4B9B8 :                     	dc.b	chan
(2)  367/   4B9B8 :                     	endm
(2)  368/   4B9B8 :                     
(2)  369/   4B9B8 :                     ; Header - Set up FM Channel
(2)  370/   4B9B8 :                     smpsHeaderSFXChannel macro chanid,loc,pitch,vol
(2)  371/   4B9B8 :                     	if (SonicDriverVer>=3)&&(chanid==cNoise)
(2)  372/   4B9B8 :                     		fatal "Using channel ID of cNoise ($E0) in Sonic 3 driver is dangerous. Fix the song so that it turns into a noise channel instead."
(2)  373/   4B9B8 :                     	elseif (SonicDriverVer<3)&&(chanid==cFM6)
(2)  374/   4B9B8 :                     		fatal "Using channel ID of FM6 ($06) in Sonic 1 or Sonic 2 drivers is unsupported. Change it to another channel."
(2)  375/   4B9B8 :                     	endif
(2)  376/   4B9B8 :                     	dc.b	$80,chanid
(2)  377/   4B9B8 :                     	CheckedChannelPointer loc
(2)  378/   4B9B8 :                     	if (chanid&$80)<>0
(2)  379/   4B9B8 :                     		PSGPitchConvert pitch
(2)  380/   4B9B8 :                     	else
(2)  381/   4B9B8 :                     		dc.b	pitch
(2)  382/   4B9B8 :                     	endif
(2)  383/   4B9B8 :                     	dc.b	vol
(2)  384/   4B9B8 :                     	endm
(2)  385/   4B9B8 :                     ; ---------------------------------------------------------------------------
(2)  386/   4B9B8 :                     ; Co-ord Flag Macros and Equates
(2)  387/   4B9B8 :                     ; E0xx - Panning, AMS, FMS
(2)  388/   4B9B8 :                     smpsPan macro direction,amsfms
(2)  389/   4B9B8 :                     panNone set $00
(2)  390/   4B9B8 :                     panRight set $40
(2)  391/   4B9B8 :                     panLeft set $80
(2)  392/   4B9B8 :                     panCentre set $C0
(2)  393/   4B9B8 :                     panCenter set $C0 ; silly Americans :U
(2)  394/   4B9B8 :                     	dc.b $E0,direction+amsfms
(2)  395/   4B9B8 :                     	endm
(2)  396/   4B9B8 :                     
(2)  397/   4B9B8 :                     ; E1xx - Set channel detune to val
(2)  398/   4B9B8 :                     smpsDetune macro val
(2)  399/   4B9B8 :                     	dc.b	$E1,val
(2)  400/   4B9B8 :                     	endm
(2)  401/   4B9B8 :                     
(2)  402/   4B9B8 :                     ; E2xx - Used for setting a variable which can be read by the game, for synchronisation. Ristar does this.
(2)  403/   4B9B8 :                     smpsNop macro val
(2)  404/   4B9B8 :                     	if (SonicDriverVer>=3) && ((val==$FF) || (val==$29))
(2)  405/   4B9B8 :                     		warning "Values $FF and $29 are reserved in S3K's driver; use a different value or remove this command."
(2)  406/   4B9B8 :                     	endif
(2)  407/   4B9B8 :                     	dc.b	$E2,val
(2)  408/   4B9B8 :                     	endm
(2)  409/   4B9B8 :                     
(2)  410/   4B9B8 :                     ; Return (used after smpsCall)
(2)  411/   4B9B8 :                     smpsReturn macro val
(2)  412/   4B9B8 :                     	if SonicDriverVer>=3
(2)  413/   4B9B8 :                     		dc.b	$F9
(2)  414/   4B9B8 :                     	else
(2)  415/   4B9B8 :                     		dc.b	$E3
(2)  416/   4B9B8 :                     	endif
(2)  417/   4B9B8 :                     	endm
(2)  418/   4B9B8 :                     
(2)  419/   4B9B8 :                     ; Fade in previous song (ie. 1-Up)
(2)  420/   4B9B8 :                     smpsFade macro val
(2)  421/   4B9B8 :                     	if SonicDriverVer>=3
(2)  422/   4B9B8 :                     		dc.b	$E2
(2)  423/   4B9B8 :                     		if ("val"<>"")
(2)  424/   4B9B8 :                     			dc.b	val
(2)  425/   4B9B8 :                     		else
(2)  426/   4B9B8 :                     			dc.b	$FF
(2)  427/   4B9B8 :                     		endif
(2)  428/   4B9B8 :                     		if SourceDriver<3
(2)  429/   4B9B8 :                     			smpsStop
(2)  430/   4B9B8 :                     		endif
(2)  431/   4B9B8 :                     	elseif (SourceDriver>=3) && ("val"<>"") && ("val"<>"$FF")
(2)  432/   4B9B8 :                     		; This is actually a communication byte, not a fade.
(2)  433/   4B9B8 :                     		smpsNop	val
(2)  434/   4B9B8 :                     	else
(2)  435/   4B9B8 :                     		dc.b	$E4
(2)  436/   4B9B8 :                     	endif
(2)  437/   4B9B8 :                     	endm
(2)  438/   4B9B8 :                     
(2)  439/   4B9B8 :                     ; E5xx - Set channel tempo divider to xx
(2)  440/   4B9B8 :                     smpsChanTempoDiv macro val
(2)  441/   4B9B8 :                     	if SonicDriverVer>=5
(2)  442/   4B9B8 :                     		; New flag unique to Flamewing's modified S&K driver
(2)  443/   4B9B8 :                     		dc.b	$FF,$08,val
(2)  444/   4B9B8 :                     	elseif SonicDriverVer==3
(2)  445/   4B9B8 :                     		fatal "Coord. Flag to set tempo divider of a single channel does not exist in S3 driver. Use Flamewing's modified S&K sound driver instead."
(2)  446/   4B9B8 :                     	else
(2)  447/   4B9B8 :                     		dc.b	$E5,val
(2)  448/   4B9B8 :                     	endif
(2)  449/   4B9B8 :                     	endm
(2)  450/   4B9B8 :                     
(2)  451/   4B9B8 :                     ; E6xx - Alter Volume by xx
(2)  452/   4B9B8 :                     smpsAlterVol macro val
(2)  453/   4B9B8 :                     	dc.b	$E6,val
(2)  454/   4B9B8 :                     	endm
(2)  455/   4B9B8 :                     
(2)  456/   4B9B8 :                     ; E7 - Prevent attack of next note
(2)  457/   4B9B8 : =$E7                 smpsNoAttack	EQU $E7
(2)  458/   4B9B8 :                     
(2)  459/   4B9B8 :                     ; E8xx - Set note fill to xx
(2)  460/   4B9B8 :                     smpsNoteFill macro val
(2)  461/   4B9B8 :                     	if (SonicDriverVer>=5)&&(SourceDriver<3)
(2)  462/   4B9B8 :                     		; Unique to Flamewing's modified driver
(2)  463/   4B9B8 :                     		dc.b	$FF,$0A,val
(2)  464/   4B9B8 :                     	else
(2)  465/   4B9B8 :                     		if (SonicDriverVer>=3)&&(SourceDriver<3)
(2)  466/   4B9B8 :                     			message "Note fill will not work as intended unless you divide the fill value by the tempo divider or complain to Flamewing to add an appropriate coordination flag for it."
(2)  467/   4B9B8 :                     		elseif (SonicDriverVer<3)&&(SourceDriver>=3)
(2)  468/   4B9B8 :                     			message "Note fill will not work as intended unless you multiply the fill value by the tempo divider or complain to Flamewing to add an appropriate coordination flag for it."
(2)  469/   4B9B8 :                     		endif
(2)  470/   4B9B8 :                     		dc.b	$E8,val
(2)  471/   4B9B8 :                     	endif
(2)  472/   4B9B8 :                     	endm
(2)  473/   4B9B8 :                     
(2)  474/   4B9B8 :                     ; Add xx to channel pitch
(2)  475/   4B9B8 :                     smpsChangeTransposition macro val
(2)  476/   4B9B8 :                     	if SonicDriverVer>=3
(2)  477/   4B9B8 :                     		dc.b	$FB,val
(2)  478/   4B9B8 :                     	else
(2)  479/   4B9B8 :                     		dc.b	$E9,val
(2)  480/   4B9B8 :                     	endif
(2)  481/   4B9B8 :                     	endm
(2)  482/   4B9B8 :                     
(2)  483/   4B9B8 :                     ; Set music tempo modifier to xx
(2)  484/   4B9B8 :                     smpsSetTempoMod macro mod
(2)  485/   4B9B8 :                     	if SonicDriverVer>=3
(2)  486/   4B9B8 :                     		dc.b	$FF,$00
(2)  487/   4B9B8 :                     	else
(2)  488/   4B9B8 :                     		dc.b	$EA
(2)  489/   4B9B8 :                     	endif
(2)  490/   4B9B8 :                     	convertMainTempoMod mod
(2)  491/   4B9B8 :                     	endm
(2)  492/   4B9B8 :                     
(2)  493/   4B9B8 :                     ; Set music tempo divider to xx
(2)  494/   4B9B8 :                     smpsSetTempoDiv macro val
(2)  495/   4B9B8 :                     	if SonicDriverVer>=3
(2)  496/   4B9B8 :                     		dc.b	$FF,$04,val
(2)  497/   4B9B8 :                     	else
(2)  498/   4B9B8 :                     		dc.b	$EB,val
(2)  499/   4B9B8 :                     	endif
(2)  500/   4B9B8 :                     	endm
(2)  501/   4B9B8 :                     
(2)  502/   4B9B8 :                     ; ECxx - Set Volume to xx
(2)  503/   4B9B8 :                     smpsSetVol macro val
(2)  504/   4B9B8 :                     	if SonicDriverVer>=3
(2)  505/   4B9B8 :                     		dc.b	$E4,val
(2)  506/   4B9B8 :                     	else
(2)  507/   4B9B8 :                     		fatal "Coord. Flag to set volume (instead of volume attenuation) does not exist in S1 or S2 drivers. Complain to Flamewing to add it."
(2)  508/   4B9B8 :                     	endif
(2)  509/   4B9B8 :                     	endm
(2)  510/   4B9B8 :                     
(2)  511/   4B9B8 :                     ; Works on all drivers
(2)  512/   4B9B8 :                     smpsPSGAlterVol macro vol
(2)  513/   4B9B8 :                     	dc.b	$EC,vol
(2)  514/   4B9B8 :                     	endm
(2)  515/   4B9B8 :                     
(2)  516/   4B9B8 :                     smpsPSGAlterVolS2 macro vol
(2)  517/   4B9B8 :                     	; Sonic 2's driver allows the FM command to be used on PSG channels, but others do not.
(2)  518/   4B9B8 :                     	if SonicDriverVer==2
(2)  519/   4B9B8 :                     		smpsAlterVol vol
(2)  520/   4B9B8 :                     	else
(2)  521/   4B9B8 :                     		smpsPSGAlterVol vol
(2)  522/   4B9B8 :                     	endif
(2)  523/   4B9B8 :                     	endm
(2)  524/   4B9B8 :                     
(2)  525/   4B9B8 :                     ; Clears pushing sound flag in S1
(2)  526/   4B9B8 :                     smpsClearPush macro
(2)  527/   4B9B8 :                     	if SonicDriverVer==1
(2)  528/   4B9B8 :                     		dc.b	$ED
(2)  529/   4B9B8 :                     	else
(2)  530/   4B9B8 :                     		fatal "Coord. Flag to clear S1 push block flag does not exist in S2 or S3 drivers. Complain to Flamewing to add it."
(2)  531/   4B9B8 :                     	endif
(2)  532/   4B9B8 :                     	endm
(2)  533/   4B9B8 :                     
(2)  534/   4B9B8 :                     ; Stops special SFX (S1 only) and restarts overridden music track
(2)  535/   4B9B8 :                     smpsStopSpecial macro
(2)  536/   4B9B8 :                     	if SonicDriverVer==1
(2)  537/   4B9B8 :                     		dc.b	$EE
(2)  538/   4B9B8 :                     	else
(2)  539/   4B9B8 :                     		message "Coord. Flag to stop special SFX does not exist in S2 or S3 drivers. Complain to Flamewing to add it. With adequate caution, smpsStop can do this job."
(2)  540/   4B9B8 :                     		smpsStop
(2)  541/   4B9B8 :                     	endif
(2)  542/   4B9B8 :                     	endm
(2)  543/   4B9B8 :                     
(2)  544/   4B9B8 :                     ; EFxx[yy] - Set Voice of FM channel to xx; xx < 0 means yy present
(2)  545/   4B9B8 :                     smpsFMvoice macro voice,songID
(2)  546/   4B9B8 :                     	if (SonicDriverVer>=3)&&("songID"<>"")
(2)  547/   4B9B8 :                     		dc.b	$EF,voice|$80,songID+$81
(2)  548/   4B9B8 :                     	else
(2)  549/   4B9B8 :                     		dc.b	$EF,voice
(2)  550/   4B9B8 :                     	endif
(2)  551/   4B9B8 :                     	endm
(2)  552/   4B9B8 :                     
(2)  553/   4B9B8 :                     ; F0wwxxyyzz - Modulation - ww: wait time - xx: modulation speed - yy: change per step - zz: number of steps
(2)  554/   4B9B8 :                     smpsModSet macro wait,speed,change,step
(2)  555/   4B9B8 :                     	dc.b	$F0
(2)  556/   4B9B8 :                     	if (SonicDriverVer>=3)&&(SourceDriver<3)
(2)  557/   4B9B8 :                     		dc.b	wait+1,speed,change,((step+1) * speed) & $FF
(2)  558/   4B9B8 :                     	elseif (SonicDriverVer<3)&&(SourceDriver>=3)
(2)  559/   4B9B8 :                     		dc.b	wait-1,speed,change,conv0To256(step)/conv0To256(speed)-1
(2)  560/   4B9B8 :                     	else
(2)  561/   4B9B8 :                     		dc.b	wait,speed,change,step
(2)  562/   4B9B8 :                     	endif
(2)  563/   4B9B8 :                     	;dc.b	speed,change,step
(2)  564/   4B9B8 :                     	endm
(2)  565/   4B9B8 :                     
(2)  566/   4B9B8 :                     ; Turn on Modulation
(2)  567/   4B9B8 :                     smpsModOn macro type
(2)  568/   4B9B8 :                     	if SonicDriverVer>=3
(2)  569/   4B9B8 :                     		if "type"<>""
(2)  570/   4B9B8 :                     			dc.b	$F4,type
(2)  571/   4B9B8 :                     		else
(2)  572/   4B9B8 :                     			dc.b	$F4,$80
(2)  573/   4B9B8 :                     		endif
(2)  574/   4B9B8 :                     	else
(2)  575/   4B9B8 :                     		dc.b	$F1
(2)  576/   4B9B8 :                     	endif
(2)  577/   4B9B8 :                     	endm
(2)  578/   4B9B8 :                     
(2)  579/   4B9B8 :                     ; F2 - End of channel
(2)  580/   4B9B8 :                     smpsStop macro
(2)  581/   4B9B8 :                     	dc.b	$F2
(2)  582/   4B9B8 :                     	endm
(2)  583/   4B9B8 :                     
(2)  584/   4B9B8 :                     ; F3xx - PSG waveform to xx
(2)  585/   4B9B8 :                     smpsPSGform macro form
(2)  586/   4B9B8 :                     	dc.b	$F3,form
(2)  587/   4B9B8 :                     	endm
(2)  588/   4B9B8 :                     
(2)  589/   4B9B8 :                     ; Turn off Modulation
(2)  590/   4B9B8 :                     smpsModOff macro
(2)  591/   4B9B8 :                     	if SonicDriverVer>=3
(2)  592/   4B9B8 :                     		dc.b	$FA
(2)  593/   4B9B8 :                     	else
(2)  594/   4B9B8 :                     		dc.b	$F4
(2)  595/   4B9B8 :                     	endif
(2)  596/   4B9B8 :                     	endm
(2)  597/   4B9B8 :                     
(2)  598/   4B9B8 :                     ; F5xx - PSG voice to xx
(2)  599/   4B9B8 :                     smpsPSGvoice macro voice
(2)  600/   4B9B8 :                     	dc.b	$F5,voice
(2)  601/   4B9B8 :                     	endm
(2)  602/   4B9B8 :                     
(2)  603/   4B9B8 :                     ; F6xxxx - Jump to xxxx
(2)  604/   4B9B8 :                     smpsJump macro loc
(2)  605/   4B9B8 :                     	dc.b	$F6
(2)  606/   4B9B8 :                     	if SonicDriverVer<>1
(2)  607/   4B9B8 :                     		dc.w	z80_ptr(loc)
(2)  608/   4B9B8 :                     	else
(2)  609/   4B9B8 :                     		dc.w	loc-*-1
(2)  610/   4B9B8 :                     	endif
(2)  611/   4B9B8 :                     	endm
(2)  612/   4B9B8 :                     
(2)  613/   4B9B8 :                     ; F7xxyyzzzz - Loop back to zzzz yy times, xx being the loop index for loop recursion fixing
(2)  614/   4B9B8 :                     smpsLoop macro index,loops,loc
(2)  615/   4B9B8 :                     	dc.b	$F7
(2)  616/   4B9B8 :                     	dc.b	index,loops
(2)  617/   4B9B8 :                     	if SonicDriverVer<>1
(2)  618/   4B9B8 :                     		dc.w	z80_ptr(loc)
(2)  619/   4B9B8 :                     	else
(2)  620/   4B9B8 :                     		dc.w	loc-*-1
(2)  621/   4B9B8 :                     	endif
(2)  622/   4B9B8 :                     	endm
(2)  623/   4B9B8 :                     
(2)  624/   4B9B8 :                     ; F8xxxx - Call pattern at xxxx, saving return point
(2)  625/   4B9B8 :                     smpsCall macro loc
(2)  626/   4B9B8 :                     	dc.b	$F8
(2)  627/   4B9B8 :                     	if SonicDriverVer<>1
(2)  628/   4B9B8 :                     		dc.w	z80_ptr(loc)
(2)  629/   4B9B8 :                     	else
(2)  630/   4B9B8 :                     		dc.w	loc-*-1
(2)  631/   4B9B8 :                     	endif
(2)  632/   4B9B8 :                     	endm
(2)  633/   4B9B8 :                     ; ---------------------------------------------------------------------------
(2)  634/   4B9B8 :                     ; Alter Volume
(2)  635/   4B9B8 :                     smpsFMAlterVol macro val1,val2
(2)  636/   4B9B8 :                     	if ("val2"<>"")
(2)  637/   4B9B8 :                     		; S3K's nerfed 'PSG & FM volume' command with broken PSG support.
(2)  638/   4B9B8 :                     		; The first value is completely unused, while the second is for FM tracks.
(2)  639/   4B9B8 :                     		if (SonicDriverVer>=3)
(2)  640/   4B9B8 :                     			dc.b	$E5,val1,val2
(2)  641/   4B9B8 :                     		else
(2)  642/   4B9B8 :                     			dc.b	$E6,val2
(2)  643/   4B9B8 :                     		endif
(2)  644/   4B9B8 :                     	else
(2)  645/   4B9B8 :                     		; Normal, sane command.
(2)  646/   4B9B8 :                     		dc.b	$E6,val1
(2)  647/   4B9B8 :                     	endif
(2)  648/   4B9B8 :                     	endm
(2)  649/   4B9B8 :                     
(2)  650/   4B9B8 :                     ; S3/S&K/S3D-only coordination flags
(2)  755/   4B9B8 :                     ; ---------------------------------------------------------------------------
(2)  756/   4B9B8 :                     ; S1/S2 only coordination flag
