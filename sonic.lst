(1)  530/   11A8C : 6510                		blo.s	SS_LoadData				; if it underflowed, no emeralds have been collected so far
(1)  531/   11A8E : 47F8 FE58           		lea	(v_emldlist).w,a3			; load array of already collected emeralds
