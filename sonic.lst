    4405/    CA40 :                     		include	"_incObj/50 Badnik - Yadrin.asm"
(1)    1/    CA40 :                     ; ---------------------------------------------------------------------------
(1)    2/    CA40 :                     ; Subroutine to check whether the object has hit the left or right wall. 
(1)    3/    CA40 :                     ; In the prototype, this routine was shared between Splats (Obj4F) and Yadrin,
(1)    4/    CA40 :                     ; but since the former was deleted, it is only used by the latter. See here:
(1)    5/    CA40 :                     ; https://github.com/Totally-Not-Filter/s1-proto-disasm/blob/AS/obj/4F%20Splats.asm
(1)    6/    CA40 :                     ; ---------------------------------------------------------------------------
(1)    7/    CA40 :                      
(1)    8/    CA40 :                     ; Yad_ChkWall: 
(1)    9/    CA40 :                     ChkHitLeftRightWall:
(1)   10/    CA40 : 3038 FE04           		move.w	(v_framecount).w,d0		; get frame counter
(1)   11/    CA44 : D047                		add.w	d7,d0				; add object object enumerator from RAM
(1)   12/    CA46 : 0240 0003           		andi.w	#3,d0				; and by 3 (effectively makes it so it's only checked every 4 frames, presumably for performance reasons)
(1)   13/    CA4A : 6622                		bne.s	.noWallHit			; if outside a 4th frame, branch
(1)   14/    CA4C :                     
(1)   15/    CA4C : 7600                		moveq	#0,d3				; clear d3
(1)   16/    CA4E : 1628 0019           		move.b	obActWid(a0),d3			; load object width to d3 (input param for wall col detection subroutines)
(1)   17/    CA52 : 4A68 0010           		tst.w	obVelX(a0)			; is object moving to the left?
(1)   18/    CA56 : 6B0C                		bmi.s	.chkLeftWall			; if yes, branch
(1)   19/    CA58 : 6100 4064           		bsr.w	ObjHitWallRight			; get distance to nearest right wall
(1)   20/    CA5C : 4A41                		tst.w	d1				; did object hit wall?
(1)   21/    CA5E : 6A0E                		bpl.s	.noWallHit			; if not, branch
(1)   22/    CA60 :                      
(1)   23/    CA60 :                     	.wallHit:
(1)   24/    CA60 : 7001                		moveq	#1,d0				; clear Z-flag (wall touched)
(1)   25/    CA62 : 4E75                		rts
(1)   26/    CA64 :                     ; ---------------------------------------------------------------------------
(1)   27/    CA64 :                      
(1)   28/    CA64 :                     	.chkLeftWall:
(1)   29/    CA64 : 4643                		not.w	d3				; invert object width to make it work for left wall collision check
