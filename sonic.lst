(1)  403/    1576 :                     ; Load a Dynamic Pattern Load Cues request into the DMA queue.
(1)  404/    1576 :                     ; ---------------------------------------------------------------------------
(1)  405/    1576 :                     ; Input:
(1)  406/    1576 :                     ;	d0.b = frame number
(1)  407/    1576 :                     ;	d4.w = starting target VRAM tile address
(1)  408/    1576 :                     ;	d6.l = pointer to uncompressed art
(1)  409/    1576 :                     ;	a2   = pointer to DPLC table
(1)  410/    1576 :                     ; ---------------------------------------------------------------------------
(1)  411/    1576 :                     
(1)  412/    1576 :                     LoadDynPLC:
(1)  413/    1576 : 0240 00FF           		andi.w	#$FF,d0					; mask out anything except the input frame
(1)  414/    157A : D040                		add.w	d0,d0					; double ID (for word-based indexing)
(1)  415/    157C : D4F2 0000           		adda.w	(a2,d0.w),a2				; find current DPLC entry
(1)  416/    1580 : 7A00                		moveq	#0,d5					; clear d5
(1)  417/    1582 : 1A1A                		move.b	(a2)+,d5				; get number of tasks in this DPLC entry
(1)  418/    1584 : 5345                		subq.w	#1,d5					; subtract 1 from number of tasks (will be the loop count)
(1)  419/    1586 : 6B00 002A           		bmi.w	.end					; if it underflowed, this is an empty entry, nothing to do
(1)  420/    158A :                     		
(1)  421/    158A :                     	.loop:
(1)  422/    158A : 161A                		move.b	(a2)+,d3				; get first byte of DPLC task
(1)  423/    158C : 1F03                		move.b	d3,-(sp)				; move it to stack (bytes shift sp by 2)
(1)  424/    158E : 7200                		moveq	#0,d1					; clear d1
(1)  425/    1590 : 321F                		move.w	(sp)+,d1				; move it from stack to upper byte of d1
(1)  426/    1592 : 121A                		move.b	(a2)+,d1				; get second byte of DPLC task
(1)  427/    1594 : 0243 00F0           		andi.w	#$F0,d3					; only look at upper nybble of first byte
(1)  428/    1598 : 0643 0010           		addi.w	#$10,d3					; add 1 to that nybble
(1)  429/    159C : 0241 0FFF           		andi.w	#$FFF,d1				; mask out that nybble in the other part
(1)  430/    15A0 : EB89                		lsl.l	#5,d1					; multiply by $20 (tile_size)
(1)  431/    15A2 : D286                		add.l	d6,d1					; add art location
(1)  432/    15A4 : 3404                		move.w	d4,d2					; set target VRAM location
(1)  433/    15A6 : D843                		add.w	d3,d4					; advance VRAM pointer
(1)  434/    15A8 : D843                		add.w	d3,d4					; (twice, for word-based tiles)
(1)  435/    15AA : 6100 FD06           		bsr.w	QueueDMATransfer			; load DMA request into queue (also known as "DMA_68KtoVRAM")
(1)  436/    15AE : 51CD FFDA           		dbf	d5,.loop				; repeat for number of entries
(1)  437/    15B2 :                     		
(1)  438/    15B2 :                     	.end:
