(1)  194/    1186 :                     is68kRegister function expr,symtype(expr)==8
(1)  195/    1186 :                     ; Expects source address and DMA length in bytes. Also, expects source, size, and dest to be known
(1)  196/    1186 :                     ; at assembly time. Gives errors if DMA starts at an odd address, transfers
(1)  197/    1186 :                     ; crosses a 128kB boundary, or has size 0.
(1)  198/    1186 :                     QueueStaticDMA macro src,length,dest
(1)  199/    1186 :                     	if MOMPASS>1
