(1)  439/    955C : 6B48                		bmi.s	.no_collision			; if Sonic is to the left of the monitor, branch
(1)  440/    955E : 3601                		move.w	d1,d3				; copy collision width
(1)  441/    9560 : D643                		add.w	d3,d3				; double it 
