    1477/    1A36 : D778 F6F4           		add.w	d3,(v_plc_VRAMAddr).w			; adjust destination VRAM address
    1478/    1A3A : E24B                		lsr.w	#1,d3					; d3 = DMA transfer length (transfer size / 2)
    1479/    1A3C :                     
