(1)   69/    C8E4 :                     		; RememberState is included here and Moto_Action terminates in it (ends with an rts).
(1)   70/    C8E4 :                     		; The Motobug was likely the first object where that subroutine was introduced,
(1)   71/    C8E4 :                     		; and the developers never cleanly moved it elsewhere, despite it being heavily reused.
(1)   72/    C8E4 :                     
(1)   73/    C8E4 :                     		include	"_incObj/sub RememberState.asm"	; check if offscreen: display sprite if no, delete if yes
(2)    1/    C8E4 :                     ; ---------------------------------------------------------------------------
(2)    2/    C8E4 :                     ; Subroutine to check if an object has gone off screen:
(2)    3/    C8E4 :                     ; - If it hasn't, queue the sprite for display.
(2)    4/    C8E4 :                     ; - If it has, try to find the relevant entry in the respawn table to clear
(2)    5/    C8E4 :                     ;   the respawn block flag (i.e. remember its state), and delete the object.
(2)    6/    C8E4 :                     ; ---------------------------------------------------------------------------
(2)    7/    C8E4 :                     
(2)    8/    C8E4 :                     RememberState:
(2)    9/    C8E4 : (MACRO)              		out_of_range.w	.offscreen		; check if object is off-screen, branch if so
(2)    9/    C8E4 : 3028 0008                           move.w  obX(a0),d0                              ; get object position
(2)    9/    C8E8 : 0240 FF80                           andi.w  #$FF80,d0                               ; round down to nearest $80
(2)    9/    C8EC : 9078 A904                           sub.w   (Camera_X_Coarse_Back).w,d0             ; approx distance between object and screen
(2)    9/    C8F0 : 0C40 02C0                           cmpi.w  #128+320+192+ExtraWidth,d0
(2)    9/    C8F4 : 6312                                bls.s   .noOffscreenXDelete                     ; if object is still in range, don't do anything
(2)    9/    C8F6 :  (MACRO-2)                           respawn_entry.w .offscreen                    ; try to fetch this object's respawn entry, .offscreen if there is none
(2)    9/    C8F6 : 3028 0014                           move.w  respawn_index(a0),d0                    ; load object's respawn index
(2)    9/    C8FA : 6700 0010                           beq.w   .offscreen                            ; if it's zero, this object has no entry, branch
(2)    9/    C8FE : 3440                                movea.w d0,a2                                   ; load address to respawn table entry into a2
(2)    9/    C900 : 0892 0007                           bclr    #7,(a2)                                 ; clear respawn table entry, so object can be loaded again
(2)    9/    C904 : 6000 0006                           bra.w   .offscreen                            ; branch to .offscreen (to delete the object)
(2)    9/    C908 :                     .noOffscreenXDelete:
(2)   10/    C908 : 6000 ED90           		bra.w	DisplaySprite			; object is on-screen, display sprite
(2)   11/    C90C :                     ; ---------------------------------------------------------------------------
(2)   12/    C90C :                     
(2)   13/    C90C :                     .offscreen:
(2)   14/    C90C : (MACRO)              		respawn_entry.w	DeleteObject			; get respawn entry for this object; branch to DeleteObject if none exists
(2)   14/    C90C : 3028 0014                           move.w  respawn_index(a0),d0                    ; load object's respawn index
(2)   14/    C910 : 6700 EDD0                           beq.w   DeleteObject                            ; if it's zero, this object has no entry, branch
(2)   14/    C914 : 3440                                movea.w d0,a2                                   ; load address to respawn table entry into a2
(2)   15/    C916 : 0892 0007           		bclr	#7,(a2)	
(2)   16/    C91A :                     
(2)   17/    C91A :                     	.delete:
(2)   18/    C91A : 6000 EDC6           		bra.w	DeleteObject			; delete the object
(2)   19/    C91E :                     ; End of function RememberState
