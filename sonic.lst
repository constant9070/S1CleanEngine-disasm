(1)    2/    2546 :                     ; Subroutine calculate a sine and cosine
(1)    3/    2546 :                     
(1)    4/    2546 :                     ; input:
(1)    5/    2546 :                     ;	d0 = angle
(1)    6/    2546 :                     
(1)    7/    2546 :                     ; output:
(1)    8/    2546 :                     ;	d0 = sine
(1)    9/    2546 :                     ;	d1 = cosine
(1)   10/    2546 :                     ; ---------------------------------------------------------------------------
(1)   11/    2546 :                     
(1)   12/    2546 :                     CalcSine:
(1)   13/    2546 : 0240 00FF           		andi.w	#$FF,d0					; clear upper input byte
(1)   14/    254A : D040                		add.w	d0,d0					; multiply input for word-sized addressing
(1)   15/    254C : 0640 0080           		addi.w	#$80,d0					; advance to cosine value index
(1)   16/    2550 : 323B 000C           		move.w	Sine_Data(pc,d0.w),d1			; get cosine value
(1)   17/    2554 : 0440 0080           		subi.w	#$80,d0					; go back sine value index
(1)   18/    2558 : 303B 0004           		move.w	Sine_Data(pc,d0.w),d0			; get sine value
(1)   19/    255C : 4E75                		rts						; return
(1)   20/    255E :                     ; End of function CalcSine
