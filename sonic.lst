(1)  340/       0 :                     
(1)  341/       0 :                     range: macro first,last,step,repeat
(1)  342/       0 :                     	set .rep, 1
(1)  343/       0 :                     	if "repeat"<>""
(1)  344/       0 :                     		set .rep, repeat
(1)  345/       0 :                     	endif
(1)  346/       0 :                     
(1)  347/       0 :                     	set .val, first
(1)  348/       0 :                     	rept 1+(abs(first-last)/abs(step))
