(1)  265/   12454 :                     ; ---------------------------------------------------------------------------
(1)  266/   12454 :                     ; Subroutine to	find a free slot in the Special Stage sprite update list,
(1)  267/   12454 :                     ; used to animate blocks collected/touched by Sonic.
(1)  268/   12454 :                     ; ---------------------------------------------------------------------------
(1)  269/   12454 :                     
(1)  270/   12454 :                     ; SS_RemoveCollectedItem: <-- old misnomer
(1)  271/   12454 :                     SS_FindFreeAnimationSlot:
(1)  272/   12454 : 45F9 00FF 4400      		lea	(v_ss_animations).l,a2			; address of sprite update list
(1)  273/   1245A : 303C 001F           		move.w	#(v_ss_animations_end-v_ss_animations)/8-1,d0 ; up to $20 slots
(1)  274/   1245E :                     
(1)  275/   1245E :                     	.loop:
(1)  276/   1245E : 4A12                		tst.b	(a2)					; is slot free?
(1)  277/   12460 : 6706                		beq.s	.return					; if yes, exit with it
(1)  278/   12462 : 504A                		addq.w	#8,a2					; go to next slot
(1)  279/   12464 : 51C8 FFF8           		dbf	d0,.loop				; try again
(1)  280/   12468 :                     
(1)  281/   12468 :                     	.return:
(1)  282/   12468 : 4E75                		rts						; return with slot in a2
(1)  283/   1246A :                     ; End of function SS_FindFreeAnimationSlot
(1)  284/   1246A :                     
(1)  285/   1246A :                     
(1)  286/   1246A :                     ; ===========================================================================
(1)  287/   1246A :                     ; ---------------------------------------------------------------------------
(1)  288/   1246A :                     ; Subroutine to animate special stage items when you touch them.
(1)  289/   1246A :                     ; This system uses a buffer of animation events that are added through the
(1)  290/   1246A :                     ; above SS_FindFreeAnimationSlot subroutine.
(1)  291/   1246A :                     ; 
(1)  292/   1246A :                     ; Each slot is 8 bytes in size, broken down like so:
(1)  293/   1246A :                     ;	0   - animation ID (1-based; zero implies empty slot)
(1)  294/   1246A :                     ;	1   - (unused)
(1)  295/   1246A :                     ;	2   - frame delay between animation advancements
(1)  296/   1246A :                     ;	3   - current index ID in animation script
(1)  297/   1246A :                     ;	4-7 - RAM location of target block in stage layout
(1)  298/   1246A :                     ; ---------------------------------------------------------------------------
(1)  299/   1246A : =$0                  ss_ani_id:	equ 0
(1)  300/   1246A : =$2                  ss_ani_delay:	equ 2
(1)  301/   1246A : =$3                  ss_ani_frame:	equ 3
(1)  302/   1246A : =$4                  ss_ani_block:	equ 4
(1)  303/   1246A :                     ; ---------------------------------------------------------------------------
(1)  304/   1246A :                     
(1)  305/   1246A :                     ; SS_AniItems:
(1)  306/   1246A :                     SS_ExecuteAnimationQueue:
(1)  307/   1246A : 41F9 00FF 4400      		lea	(v_ss_animations).l,a0			; load start address of animation event buffer
(1)  308/   12470 : 3E3C 001F           		move.w	#(v_ss_animations_end-v_ss_animations)/8-1,d7 ; set to iterate through all slots
(1)  309/   12474 :                     
(1)  310/   12474 :                     	.loop:
(1)  311/   12474 : 7000                		moveq	#0,d0					; clear d0
(1)  312/   12476 : 1010                		move.b	ss_ani_id(a0),d0			; get potential animation event
(1)  313/   12478 : 6708                		beq.s	.nextslot				; if slot has none, branch
(1)  314/   1247A : E548                		lsl.w	#2,d0					; multiply ID by 4 for long-based indexing
(1)  315/   1247C : 227B 0008           		movea.l	SS_AniIndex-4(pc,d0.w),a1		; get animation entry in jump table (-4 because these IDs are 1-based)
(1)  316/   12480 : 4E91                		jsr	(a1)					; execute animation and return
(1)  317/   12482 :                     
(1)  318/   12482 :                     	.nextslot:
(1)  319/   12482 : 5048                		addq.w	#8,a0					; go to next animation event slot
(1)  320/   12484 : 51CF FFEE           		dbf	d7,.loop				; loop until all event slots were checked
(1)  321/   12488 : 4E75                		rts						; return
(1)  322/   1248A :                     
