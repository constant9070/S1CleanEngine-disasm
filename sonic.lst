    4485/   12C90 :                     		include	"_incObj/sub AddPoints.asm"
(1)    1/   12C90 :                     ; ===========================================================================
(1)    2/   12C90 :                     ; ---------------------------------------------------------------------------
(1)    3/   12C90 :                     ; Subroutine to add points to the score counter.
(1)    4/   12C90 :                     ; 
(1)    5/   12C90 :                     ; Input:
(1)    6/   12C90 :                     ;	d0 = points to add / 10 (rightmost digit in HUD is a fake 0)
(1)    7/   12C90 :                     ; ---------------------------------------------------------------------------
(1)    8/   12C90 :                     ; - In REV00, a copy of the score is kept in a separate RAM value, and it's
(1)    9/   12C90 :                     ;   coded so that it only updates when the current score is higher. This is
(1)   10/   12C90 :                     ;   never used anywhere in the game, but probably once was intended as some
(1)   11/   12C90 :                     ;   sort of high-score system, as it stays in memory after a soft reset.
(1)   12/   12C90 :                     ; - In REV01, this value has been repurposed so that it awards an extra life
(1)   13/   12C90 :                     ;   for every multiple of 50000 points acquired, but ONLY if the region is
(1)   14/   12C90 :                     ;   set to Japanese. Overseas regions will update the requirement, but they
(1)   15/   12C90 :                     ;   won't award the extra life under any circumstances.
(1)   16/   12C90 :                     ; ---------------------------------------------------------------------------
(1)   17/   12C90 :                     
(1)   18/   12C90 :                     AddPoints:
(1)   19/   12C90 : 11FC 0001 FE1F      		move.b	#1,(f_scorecount).w		; set score counter to update
(1)   20/   12C96 :                     
(1)   38/   12C96 :                     
(1)   39/   12C96 : 47F8 FE26           		lea	(v_score).w,a3			; load current score count
(1)   40/   12C9A : D193                		add.l	d0,(a3)				; add d0*10 to the score
(1)   41/   12C9C : 223C 000F 423F      		move.l	#999999,d1			; set maximum score count to 9999990
(1)   42/   12CA2 : B293                		cmp.l	(a3),d1				; has score exceeded the maximum?
(1)   43/   12CA4 : 6202                		bhi.s	.belowmax			; if not, branch
(1)   44/   12CA6 : 2681                		move.l	d1,(a3)				; cap score to 9999990
(1)   45/   12CA8 :                     
(1)   46/   12CA8 :                     .belowmax:
(1)   47/   12CA8 : 2013                		move.l	(a3),d0				; get new score count
(1)   48/   12CAA : B0B8 FFC0           		cmp.l	(v_scorelife).w,d0		; is new score count exceeding the next multiple of 50000?
(1)   49/   12CAE : 6520                		blo.s	.return				; if not, branch
(1)   50/   12CB0 :                     
(1)   51/   12CB0 : 06B8 0000 1388      		addi.l	#5000,(v_scorelife).w		; increase requirement for next score extra life by 50000
            12CB6 : FFC0             
(1)   52/   12CB8 : 4A38 FFF8           		tst.b	(v_megadrive).w			; is region set to Japanese?
(1)   53/   12CBC : 6B12                		bmi.s	.return				; if not (i.e. overseas), branch
(1)   54/   12CBE : 5238 FE12           		addq.b	#1,(v_lives).w			; award 1 extra life
(1)   55/   12CC2 : 5238 FE1C           		addq.b	#1,(f_lifecount).w		; update lives counter
(1)   56/   12CC6 : 303C 0008           		move.w	#bgm_ExtraLife,d0		; set extra life music
(1)   57/   12CCA : 4EF9 0000 1518      		jmp	(QueueSound1).l			; play it
(1)   59/   12CD0 :                     
(1)   60/   12CD0 :                     .return:
(1)   61/   12CD0 : 4E75                		rts					; return
(1)   62/   12CD2 :                     ; End of function AddPoints
(1)   63/   12CD2 :                     ; ===========================================================================
    4486/   12CD2 :                     		include	"_inc/HUD Update.asm"	; includes "ContScrCounter" subroutine
(1)    1/   12CD2 :                     ; ===========================================================================
(1)    2/   12CD2 :                     ; ---------------------------------------------------------------------------
(1)    3/   12CD2 :                     ; Subroutine to update the HUD numbers in VRAM (called from VBlank).
(1)    4/   12CD2 :                     ; ---------------------------------------------------------------------------
(1)    5/   12CD2 :                     
(1)    6/   12CD2 :                     HUD_Update:
(1)    7/   12CD2 : 4A78 FFFA           		tst.w	(f_debugmode).w			; is debug mode on?
