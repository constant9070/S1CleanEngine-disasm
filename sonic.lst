    1058/    1002 :                     ; Subroutine to initialize joypads and check if either port is using
    1059/    1002 :                     ; a 6-button controller. MSB is set in v_jpadhold_6btn/v_jpadhold_6btn_p2
    1060/    1002 :                     ; if one has been detected.
    1061/    1002 :                     ; For reference, see: https://www.plutiedev.com/controllers#6-button
    1062/    1002 :                     ; ---------------------------------------------------------------------------
    1063/    1002 :                     
    1064/    1002 :                     ; Small helper macro that toggles the TH line and adds the required delay
    1065/    1002 :                     ; so the controller can output the correct button states. Defined as a macro
    1066/    1002 :                     ; to avoid repeating the same move/nop sequence over and over.
    1067/    1002 :                     PollTH	macro	hiPoll
    1068/    1002 :                     		if hiPoll>0
    1069/    1002 :                     			move.b	#$40,(a1)		; read D-Pad, B, and C input (hi poll)
    1070/    1002 :                     		else
    1071/    1002 :                     			move.b	#0,(a1)			; read A and Start input (lo poll)
    1072/    1002 :                     		endif
    1073/    1002 :                     		nop					; wait a bit after polling
    1074/    1002 :                     		nop					; (bus synchronization)
    1075/    1002 :                     	endm
    1076/    1002 :                     
    1077/    1002 :                     ; ---------------------------------------------------------------------------
    1078/    1002 :                     
    1079/    1002 :                     JoypadInit:
    1080/    1002 :                     
    1081/    1002 : 7040                		moveq	#$40,d0				; set TH high
    1082/    1004 : 13C0 00A1 0009      		move.b	d0,(port_1_control).l		; init port 1 (joypad 1)
    1083/    100A : 13C0 00A1 000B      		move.b	d0,(port_2_control).l		; init port 2 (joypad 2)
    1084/    1010 : 13C0 00A1 000D      		move.b	d0,(expansion_control).l	; init port 3 (expansion/extra)
    1085/    1016 :                     
    1086/    1016 : 43F9 00A1 0003      		lea	(port_1_data).l,a1		; load address to read controller 1 data
    1087/    101C : 6112                		bsr.s	.check6btn			; check whether it's a 6-button controller
    1088/    101E : 56F8 F606           		sne.b	(v_jpadhold_6btn).w		; set P1 to 6-button controller flag if it is
    1089/    1022 :                     
    1090/    1022 : 43F9 00A1 0005      		lea	(port_2_data).l,a1		; load address to read controller 2 data
    1091/    1028 : 6106                		bsr.s	.check6btn			; check whether it's a 6-button controller
    1092/    102A : 56F8 F60A           		sne.b	(v_jpadhold_6btn_p2).w		; set P2 to 6-button controller flag if it is
    1093/    102E : 4E75                		rts					; return
    1094/    1030 :                     ; ---------------------------------------------------------------------------
    1095/    1030 :                     
    1096/    1030 :                     .check6btn:
    1097/    1030 : (MACRO)              		PollTH	1				; 1st TH poll (hi)
    1097/    1030 : 12BC 0040                                   move.b  #$40,(a1)               ; read D-Pad, B, and C input (hi poll)
    1097/    1034 : 4E71                                nop                                     ; wait a bit after polling
    1097/    1036 : 4E71                                nop                                     ; (bus synchronization)
    1098/    1038 : (MACRO)              		PollTH	0				; 2nd TH poll (lo)
    1098/    1038 : 12BC 0000                                   move.b  #0,(a1)                 ; read A and Start input (lo poll)
    1098/    103C : 4E71                                nop                                     ; wait a bit after polling
    1098/    103E : 4E71                                nop                                     ; (bus synchronization)
    1099/    1040 : (MACRO)              		PollTH	1				; 3rd TH poll (hi)
    1099/    1040 : 12BC 0040                                   move.b  #$40,(a1)               ; read D-Pad, B, and C input (hi poll)
    1099/    1044 : 4E71                                nop                                     ; wait a bit after polling
    1099/    1046 : 4E71                                nop                                     ; (bus synchronization)
    1100/    1048 : (MACRO)              		PollTH	0				; 4th TH poll (lo)
    1100/    1048 : 12BC 0000                                   move.b  #0,(a1)                 ; read A and Start input (lo poll)
    1100/    104C : 4E71                                nop                                     ; wait a bit after polling
    1100/    104E : 4E71                                nop                                     ; (bus synchronization)
    1101/    1050 : (MACRO)              		PollTH	1				; 5th TH poll (hi)
    1101/    1050 : 12BC 0040                                   move.b  #$40,(a1)               ; read D-Pad, B, and C input (hi poll)
    1101/    1054 : 4E71                                nop                                     ; wait a bit after polling
    1101/    1056 : 4E71                                nop                                     ; (bus synchronization)
    1102/    1058 : (MACRO)              		PollTH	0				; 6th TH poll (lo)
    1102/    1058 : 12BC 0000                                   move.b  #0,(a1)                 ; read A and Start input (lo poll)
    1102/    105C : 4E71                                nop                                     ; wait a bit after polling
    1102/    105E : 4E71                                nop                                     ; (bus synchronization)
    1103/    1060 : 0C11 0033           		cmpi.b	#%00110011,(a1)			; check if 6th TH poll returned 3-button controller data
    1104/    1064 : 4E75                		rts					; CCR check is done after the return
    1105/    1066 :                     ; End of function JoypadInit
