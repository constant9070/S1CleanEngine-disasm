    4608/   46B76 :                     
    4609/   46B76 :                     	; ObjPos_Index starts at $6B000 in all revisions, which amounts
    4610/   46B76 :                     	; to $9C bytes of padding for rev00 and $DC for rev01/rev02.
    4611/   46B76 :                     	; From a technical standpoint, this padding serves no purpose.
