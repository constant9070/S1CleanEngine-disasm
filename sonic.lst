    5017/   54A6A :                     
    5018/   54A6A :                     		include	"_inc/Title Cards Extended.asm"
(1)    1/   54A6A :                     ; --- Extended Sonic 1 Title Cards System (AS Version) ---
(1)    2/   54A6A :                     ; * Created by Selbi
(1)    3/   54A6A :                     ; * AS port and Level/SS result screens extension by RobiWanKenobi
(1)    4/   54A6A :                     ; * Lowercase letters taken from "Yuu Yuu Hakusho: Makyou Toitsusen"
(1)    5/   54A6A :                     ; * Missing uppercase letter graphics "JQVWX" by SameyTheHedgie
(1)    6/   54A6A :                     ; * Titlecase "Act" and fixed lowercase "a" graphics by MDTravis
(1)    7/   54A6A :                     ; * Act "4" number graphics by Cinossu
(1)    8/   54A6A :                     ; See also: https://www.deviantart.com/sameythehedgie/art/s1cardext-846313458
(1)    9/   54A6A :                     
(1)   10/   54A6A :                     ; ===========================================================================
(1)   11/   54A6A :                     ; ---------------------------------------------------------------------------
(1)   12/   54A6A :                     ; Zone title card definitions. Stipulations:
(1)   13/   54A6A :                     ; - All letters from the English alphabet are supported
(1)   14/   54A6A :                     ; - Uppercase AND lowercase letters are supported
(1)   15/   54A6A :                     ; - Maximum length 20 characters
(1)   16/   54A6A :                     ; - ZONE text must be 5 characters or less
(1)   17/   54A6A :                     ; - Sonic Has & Passed Text Combined must 20 or fewer characters
(1)   18/   54A6A :                     ; - Special Stage Results Text must only be 20 characters or less
(1)   19/   54A6A :                     ; ---------------------------------------------------------------------------
(1)   20/   54A6A :                     
(1)   21/   54A6A : ="Green Hill"        TitleCard_GHZ1:	equ "Green Hill"
(1)   22/   54A6A : ="Sunset Hill"       TitleCard_GHZ2:	equ "Sunset Hill"
(1)   23/   54A6A : ="Night Hill"        TitleCard_GHZ3:	equ "Night Hill"
(1)   24/   54A6A : ="Classic Hill"      TitleCard_GHZ4:	equ "Classic Hill"
(1)   25/   54A6A :                     
(1)   26/   54A6A : ="Zone"              TitleCard_Zone:	equ "Zone"
(1)   27/   54A6A : =$1                  TitleCard_UseLowerAct: equ 1	; 0 = ACT // 1 = Act
(1)   28/   54A6A :                     
(1)   29/   54A6A :                     ; ---------------------------------------------------------------------------
(1)   30/   54A6A :                     
(1)   31/   54A6A : ="Sonic Has"         TitleCard_SonicHas:	equ "Sonic Has"
(1)   32/   54A6A : ="Passed"            TitleCard_Passed:	equ "Passed"
(1)   33/   54A6A :                     
(1)   34/   54A6A : ="Special Stage"     TitleCard_SpecialStage:	 equ "Special Stage"
(1)   35/   54A6A : ="Chaos Emeralds"    TitleCard_ChaosEmeralds: equ "Chaos Emeralds"
(1)   36/   54A6A : ="Sonic Got Them..   TitleCard_GotThemAll:	 equ "Sonic Got Them All"
(1)   37/   54A6A :                     
(1)   38/   54A6A :                     ; ---------------------------------------------------------------------------
(1)   39/   54A6A :                     ; ===========================================================================
(1)   40/   54A6A :                     ; ---------------------------------------------------------------------------
(1)   41/   54A6A :                     ; Subroutine to dynamically load title card letters into VRAM.
(1)   42/   54A6A :                     ; Also see the related macro below.
(1)   43/   54A6A :                     ; ---------------------------------------------------------------------------
(1)   44/   54A6A :                     
(1)   45/   54A6A : =$4                  TTL_LetterTiles:	equ 4	; tile count for a single letter (16x16 sprite)
(1)   46/   54A6A : =$6                  TTL_NumberTiles:	equ 6	; tile count for an act number (16x24 sprite)
(1)   47/   54A6A : =$3                  TTL_ActTxtTiles:	equ 3	; tile count for the act text (8x24 sprite)
(1)   48/   54A6A : =$10                 TTL_OvalTiles:		equ 16	; tiles used by the blue oval (repurposed)
(1)   49/   54A6A : =$2                  TTL_SmallOvalTiles:	equ 2	; tiles used by the blue oval (repurposed)
(1)   50/   54A6A : =$8                  TTL_BonuTiles:		equ 8	; tiles used by the "BONU" results letters
(1)   51/   54A6A : =$3C                 SonicHasPassed_Tiles:	equ TTL_LetterTiles*(strlen(TitleCard_SonicHas) + strlen(TitleCard_Passed))
(1)   52/   54A6A :                     
(1)   53/   54A6A : =$51                 TTL_BONU:		equ TTL_OvalTiles+TTL_ActTxtTiles+SonicHasPassed_Tiles+2
(1)   54/   54A6A : =$59                 TTL_SmOval:		equ TTL_BONU+TTL_BonuTiles
(1)   55/   54A6A : =$7E                 TTL_SmOvalSSR:		equ TTL_OvalTiles+100+TTL_BonuTiles+TTL_SmallOvalTiles
(1)   56/   54A6A :                     
(1)   57/   54A6A : =$D00                TTL_Numbers:		equ ("Z"-"A"+1)*TTL_LetterTiles*tile_size
(1)   58/   54A6A : =$1D60               TTL_ActText:		equ ("z"-"A"+1)*TTL_LetterTiles*tile_size+(TTL_ActTxtTiles*TitleCard_UseLowerAct*tile_size)
(1)   59/   54A6A : =$1DC0               TTL_BlueOval:		equ ((("z"-"A"+1)*TTL_LetterTiles)+TTL_ActTxtTiles*2)*tile_size
(1)   60/   54A6A : =$1FC0               TTL_EOL:		equ (((("z"-"A"+1)*TTL_LetterTiles)+TTL_ActTxtTiles*2)+TTL_OvalTiles)*tile_size
