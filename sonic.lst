    4339/    91E8 :                     ; ===========================================================================
    4340/    91E8 :                     ; >>> Rings
    4341/    91E8 :                     		include	"_inc/RingManager.asm"
(1)    1/    91E8 :                     ; ===========================================================================
(1)    2/    91E8 :                     ; ----------------------------------------------------------------------------
(1)    3/    91E8 :                     ; Pseudo-object that manages where rings are placed onscreen as you move
(1)    4/    91E8 :                     ; through the level, and otherwise updates them.
(1)    5/    91E8 :                     ;
(1)    6/    91E8 :                     ; Taken from Sonic 2, upgraded to S3K equivalent (with further optimizations).
(1)    7/    91E8 :                     ;
(1)    8/    91E8 :                     ; v_ringstates_pointer = address within v_ringstates RAM of the first ring found within left screen boundary
(1)    9/    91E8 :                     ; v_ringwindow_start   = address in ROM ring layout of the first ring found within left screen boundary
(1)   10/    91E8 :                     ; v_ringwindow_end     = address in ROM ring layout of the first ring found beyond right screen boundary
(1)   11/    91E8 :                     ; v_ringanimqueue      = queue of recently collected rings storing pointers pointing inside v_ringstates
(1)   12/    91E8 :                     ; Note: v_ringstart_addr_ROM and v_ringstart_addr_RAM will both point to data of the same ring.
(1)   13/    91E8 :                     ;
(1)   14/    91E8 :                     ; Each ring stored in ROM is 4 bytes, two per X/Y-axis [XXXX YYYY].
(1)   15/    91E8 :                     ; Each ring stored in v_ringstates is 2 bytes:
(1)   16/    91E8 :                     ; - 0000 => Uncollected rings. They use one frame, which is dynamically altered by the animated art in VRAM.
(1)   17/    91E8 :                     ; - 0604 => (Or any other positive values) Recently collected rings set to play the sparkle animation.
(1)   18/    91E8 :                     ; - FFFF => Collected and gone ring ("destroyed"). Gets set after sparkle animation finished playing.
(1)   19/    91E8 :                     ; The format for the sparkle animation is [TTFF]: TT = timer counting down each frame, FF = frame ID incrementing.
(1)   20/    91E8 :                     ; ----------------------------------------------------------------------------
(1)   21/    91E8 :                     
(1)   22/    91E8 : =$1                  EnableAttractRings:		equ 1	; attract rings if Sonic has a shield (v_shield, since we have no lightning shields)
(1)   23/    91E8 : =$1                  SmoothRingsCompatibility:	equ 1	; compatibility with smooth rings (i.e. force to ring frame ID 0)
