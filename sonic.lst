    4384/    B3DC :                     ; ===========================================================================
    4385/    B3DC :                     ; Subroutines to run, render, and update objects
    4386/    B3DC :                     		include	"_inc/ExecuteObjects.asm"
(1)    1/    B3DC :                     ; ---------------------------------------------------------------------------
(1)    2/    B3DC :                     ; Object code execution subroutine
(1)    3/    B3DC :                     ; 
(1)    4/    B3DC :                     ; output:
(1)    5/    B3DC :                     ;	d7.l = OST index of last object (must not be changed by any object)
(1)    6/    B3DC :                     ;	a0 = address of OST of last object
(1)    7/    B3DC :                     ; 
(1)    8/    B3DC :                     ;	uses d0.l, a1 (objects may use other registers)
(1)    9/    B3DC :                     ; ---------------------------------------------------------------------------
(1)   10/    B3DC :                     
(1)   11/    B3DC :                     ExecuteObjects:
(1)   12/    B3DC : 41F8 D000           		lea	(v_objspace).w,a0		; set address for object RAM
(1)   13/    B3E0 : 7E7F                		moveq	#(v_objspace_end-v_objspace)/object_size-1,d7 ; $80 objects - 1
(1)   14/    B3E2 : 7000                		moveq	#0,d0				; clear d0
(1)   15/    B3E4 : 0C38 0006 D024      		cmpi.b	#6,(v_player+obRoutine).w	; is Sonic dying?
(1)   16/    B3EA : 641A                		bhs.s	.sonic_dead			; if yes, branch to alternate logic
(1)   17/    B3EC :                     
(1)   18/    B3EC :                     ; loc_D348:
(1)   19/    B3EC :                     .run_object:
(1)   20/    B3EC : 1010                		move.b	(a0),d0				; load object ID from RAM
(1)   21/    B3EE : 670C                		beq.s	.next_object			; if ID is 0, this is an empty object slot, branch
(1)   22/    B3F0 : D040                		add.w	d0,d0				; quadruple for...
(1)   23/    B3F2 : D040                		add.w	d0,d0				; ...long-based indexing
(1)   24/    B3F4 : 227B 002C           		movea.l	Obj_Index-4(pc,d0.w),a1		; find relevant object pointer (minus -4 because entries skip ID 00)
(1)   25/    B3F8 : 4E91                		jsr	(a1)				; run the object's code
(1)   26/    B3FA : 7000                		moveq	#0,d0				; clear d0 for next loop
(1)   27/    B3FC :                     
(1)   28/    B3FC :                     	; loc_D358:
(1)   29/    B3FC :                     	.next_object:
(1)   30/    B3FC : 41E8 0040           		lea	object_size(a0),a0		; increase a0 to go to next object entry ($40 bytes)
(1)   31/    B400 : 51CF FFEA           		dbf	d7,.run_object			; loop until all objects have been executed
(1)   32/    B404 : 4E75                		rts					; return
(1)   33/    B406 :                     ; ===========================================================================
(1)   34/    B406 :                     
(1)   35/    B406 :                     ; Separate logic while Sonic is dying, used to freeze level objects in place
(1)   36/    B406 :                     ; while still executing reserved objects normally (mainly Sonic himself).
(1)   37/    B406 :                     
(1)   38/    B406 :                     ; loc_D362:
(1)   39/    B406 :                     .sonic_dead:
(1)   40/    B406 : 7E1F                		moveq	#(v_lvlobjspace-v_objspace)/object_size-1,d7 ; run first 32 objects normally (reserved objects like Sonic)
(1)   41/    B408 : 61E2                		bsr.s	.run_object			; execute those objects and return here
(1)   42/    B40A :                     
(1)   43/    B40A : 7E5F                		moveq	#(v_lvlobjend-v_lvlobjspace)/object_size-1,d7 ; run the remaining 96 objects in display-only mode
(1)   44/    B40C :                     ; loc_D368:
(1)   45/    B40C :                     .display_object:
(1)   46/    B40C : 7000                		moveq	#0,d0				; clear d0
(1)   47/    B40E : 1010                		move.b	obID(a0),d0			; load object ID from RAM
(1)   48/    B410 : 670A                		beq.s	.next_object_displayonly	; if ID is 0, this is an empty object slot, branch
(1)   49/    B412 : 4A28 0001           		tst.b	obRender(a0)			; was object on-screen as Sonic died?
(1)   50/    B416 : 6A04                		bpl.s	.next_object_displayonly	; if not, branch
(1)   51/    B418 : 6100 0280           		bsr.w	DisplaySprite			; keep displaying the object as Sonic dies but don't execute it
(1)   52/    B41C :                     
(1)   53/    B41C :                     	; loc_D378:
(1)   54/    B41C :                     	.next_object_displayonly:
(1)   55/    B41C : 41E8 0040           		lea	object_size(a0),a0		; increase a0 to go to next object entry ($40 bytes)
(1)   56/    B420 : 51CF FFEA           		dbf	d7,.display_object		; loop until all objects have been executed
(1)   57/    B424 : 4E75                		rts					; return
(1)   58/    B426 :                     ; End of function ExecuteObjects
