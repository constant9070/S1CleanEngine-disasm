(1)    7/   138CA : 1038 FE10           		move.b	(v_zone).w,d0				; get current zone ID
(1)    8/   138CE : ED48                		lsl.w	#6,d0					; multiply by $40 (4 acts per zone * $10 bytes per act)
(1)    9/   138D0 : 3F00                		move.w	d0,-(sp)				; backup d0 to stack
(1)   10/   138D2 : 7000                		moveq	#0,d0					; clear d0
(1)   11/   138D4 : 1038 FE11           		move.b	(v_act).w,d0				; get current act number
(1)   12/   138D8 : E948                		lsl.w	#4,d0					; multiply by $10 (bytes for one level header)
(1)   13/   138DA : D05F                		add.w	(sp)+,d0				; restore d0 from stack and add to get index
(1)   14/   138DC : 45FB 0004           		lea	LevelHeaders(pc,d0.w),a2		; load level header for current zone/act into a2
