(2)  147/    5F24 : 6404                		bhs.s	.return					; if yes, branch
(2)  148/    5F26 : 323C 0028           		move.w	#(ExtraWidth+16)/2,d1				; keep the wide view's left edge inside the level
(2)  150/    5F2A :                     	.return:
(2)  151/    5F2A : 4E75                		rts
