(1)   73/    C198 :                     		include	"_incObj/sub RememberState.asm"	; check if offscreen: display sprite if no, delete if yes
(2)    1/    C198 :                     ; ---------------------------------------------------------------------------
(2)    2/    C198 :                     ; Subroutine to check if an object has gone off screen:
(2)    3/    C198 :                     ; - If it hasn't, queue the sprite for display.
(2)    4/    C198 :                     ; - If it has, try to find the relevant entry in the respawn table to clear
(2)    5/    C198 :                     ;   the respawn block flag (i.e. remember its state), and delete the object.
(2)    6/    C198 :                     ; ---------------------------------------------------------------------------
(2)    7/    C198 :                     
(2)    8/    C198 :                     RememberState:
(2)    9/    C198 : (MACRO)              		out_of_range.w	.offscreen		; check if object is off-screen, branch if so
(2)    9/    C198 : 3028 0008                           move.w  obX(a0),d0      ; get object position
(2)    9/    C19C : 0240 FF80                           andi.w  #$FF80,d0       ; round down to nearest $80
(2)    9/    C1A0 : 3238 F700                           move.w  (v_screenposx).w,d1 ; get screen position
(2)    9/    C1A4 : 0441 0080                           subi.w  #128,d1
(2)    9/    C1A8 : 0241 FF80                           andi.w  #$FF80,d1
(2)    9/    C1AC : 9041                                sub.w   d1,d0           ; approx distance between object and screen
(2)    9/    C1AE : 0C40 0280                           cmpi.w  #128+320+192,d0
(2)    9/    C1B2 : 6200 0006                           bhi.w   .offscreen
(2)   10/    C1B6 : 6000 F082           		bra.w	DisplaySprite			; object is on-screen, display sprite
