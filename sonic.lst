(2)   48/   67C30 :                     ; SMPS2ASM uses nMaxPSG for songs from S1/S2 drivers.
(2)   49/   67C30 :                     ; nMaxPSG1 and nMaxPSG2 are used only for songs from S3/S&K/S3D drivers.
(2)   50/   67C30 :                     ; The use of psgdelta is intended to undo the effects of PSGPitchConvert
(2)   51/   67C30 :                     ; and ensure that the ending note is indeed the maximum PSG frequency.
(2)   53/   67C30 : =$C6                 nMaxPSG				EQU nA5
(2)   54/   67C30 : =$D2                 nMaxPSG1			EQU nA5+psgdelta
(2)   55/   67C30 : =$D2                 nMaxPSG2			EQU nA5+psgdelta
(2)   61/   67C30 :                     ; ---------------------------------------------------------------------------
(2)   62/   67C30 :                     ; PSG volume envelope equates
(2)   65/   67C30 : =$1..$6              			enum		fTone_01=$01,fTone_02,fTone_03,fTone_04,fTone_05,fTone_06
(2)   66/   67C30 : =$7..$9              			nextenum	fTone_07,fTone_08,fTone_09
(2)   86/   67C30 :                     ; ---------------------------------------------------------------------------
(2)   87/   67C30 :                     ; DAC Equates
(2)   90/   67C30 : =$81..$83            			enum		dKick=$81,dSnare,dTimpani
(2)   91/   67C30 : =$88..$8B            			enum		dHiTimpani=$88,dMidTimpani,dLowTimpani,dVLowTimpani
(2)  169/   67C30 :                     ; ---------------------------------------------------------------------------
(2)  170/   67C30 :                     ; Channel IDs for SFX
(2)  171/   67C30 : =$80                 cPSG1				EQU $80
(2)  172/   67C30 : =$A0                 cPSG2				EQU $A0
(2)  173/   67C30 : =$C0                 cPSG3				EQU $C0
(2)  174/   67C30 : =$E0                 cNoise				EQU $E0	; Not for use in S3/S&K/S3D
(2)  175/   67C30 : =$2                  cFM3				EQU $02
(2)  176/   67C30 : =$4                  cFM4				EQU $04
(2)  177/   67C30 : =$5                  cFM5				EQU $05
(2)  178/   67C30 : =$6                  cFM6				EQU $06	; Only in S3/S&K/S3D, overrides DAC
(2)  179/   67C30 :                     ; ---------------------------------------------------------------------------
(2)  180/   67C30 :                     ; Conversion macros and functions
(2)  181/   67C30 :                     
(2)  182/   67C30 :                     conv0To256  function n,((n==0)<<8)|n
(2)  183/   67C30 :                     s2TempotoS1 function n,(((768-n)>>1)/(256-n))&$FF
(2)  184/   67C30 :                     s2TempotoS3 function n,($100-((n==0)|n))&$FF
(2)  185/   67C30 :                     s1TempotoS2 function n,((((conv0To256(n)-1)<<8)+(conv0To256(n)>>1))/conv0To256(n))&$FF
(2)  186/   67C30 :                     s1TempotoS3 function n,s2TempotoS3(s1TempotoS2(n))
(2)  187/   67C30 :                     s3TempotoS1 function n,s2TempotoS1(s2TempotoS3(n))
(2)  188/   67C30 :                     s3TempotoS2 function n,s2TempotoS3(n)
(2)  189/   67C30 :                     
(2)  190/   67C30 :                     convertMainTempoMod macro mod
(2)  191/   67C30 :                     	if ((SourceDriver>=3)&&(SonicDriverVer>=3))||(SonicDriverVer==SourceDriver)
(2)  192/   67C30 :                     		dc.b	mod
(2)  193/   67C30 :                     	elseif SourceDriver==1
(2)  194/   67C30 :                     		if mod==1
(2)  195/   67C30 :                     			fatal "Invalid main tempo of 1 in song from Sonic 1"
(2)  196/   67C30 :                     		endif
(2)  197/   67C30 :                     		if SonicDriverVer==2
(2)  198/   67C30 :                     			dc.b	s1TempotoS2(mod)
(2)  199/   67C30 :                     		else;if SonicDriverVer>=3
(2)  200/   67C30 :                     			dc.b	s1TempotoS3(mod)
(2)  201/   67C30 :                     		endif
(2)  202/   67C30 :                     	elseif SourceDriver==2
(2)  203/   67C30 :                     		if mod==0
(2)  204/   67C30 :                     			fatal "Invalid main tempo of 0 in song from Sonic 2"
(2)  205/   67C30 :                     		endif
(2)  206/   67C30 :                     		if SonicDriverVer==1
(2)  207/   67C30 :                     			dc.b	s2TempotoS1(mod)
(2)  208/   67C30 :                     		else;if SonicDriverVer>=3
(2)  209/   67C30 :                     			dc.b	s2TempotoS3(mod)
(2)  210/   67C30 :                     		endif
(2)  211/   67C30 :                     	else;if SourceDriver>=3
(2)  212/   67C30 :                     		if mod==0
(2)  213/   67C30 :                     			message "Performing approximate conversion of Sonic 3 main tempo modifier of 0"
(2)  214/   67C30 :                     		endif
(2)  215/   67C30 :                     		if SonicDriverVer==1
(2)  216/   67C30 :                     			dc.b	s3TempotoS1(mod)
(2)  217/   67C30 :                     		else;if SonicDriverVer==2
(2)  218/   67C30 :                     			dc.b	s3TempotoS2(mod)
(2)  219/   67C30 :                     		endif
(2)  220/   67C30 :                     	endif
(2)  221/   67C30 :                     	endm
(2)  222/   67C30 :                     
(2)  223/   67C30 :                     ; PSG conversion to S3/S&K/S3D drivers require a tone shift of 12 semi-tones.
(2)  224/   67C30 :                     PSGPitchConvert macro pitch
(2)  225/   67C30 :                     	if (SonicDriverVer>=3)&&(SourceDriver<3)
(2)  226/   67C30 :                     		dc.b	(pitch+psgdelta)&$FF
(2)  227/   67C30 :                     	elseif (SonicDriverVer<3)&&(SourceDriver>=3)
(2)  228/   67C30 :                     		dc.b	(pitch-psgdelta)&$FF
(2)  229/   67C30 :                     	else
(2)  230/   67C30 :                     		dc.b	pitch
(2)  231/   67C30 :                     	endif
(2)  232/   67C30 :                     	endm
(2)  233/   67C30 :                     
(2)  234/   67C30 :                     CheckedChannelPointer macro loc
(2)  235/   67C30 :                     	if SonicDriverVer<>1
(2)  236/   67C30 :                     		dc.w	z80_ptr(loc)
(2)  237/   67C30 :                     	else
(2)  238/   67C30 :                     		if (MOMPASS=1)&&(DEFINED(loc))
(2)  239/   67C30 :                     			fatal "Tracks for Sonic 1 songs must come after the start of the song"
(2)  240/   67C30 :                     		endif
(2)  241/   67C30 :                     		dc.w	loc-songStart
(2)  242/   67C30 :                     	endif
(2)  243/   67C30 :                     	endm
(2)  244/   67C30 :                     ; ---------------------------------------------------------------------------
(2)  245/   67C30 :                     ; Header Macros
(2)  246/   67C30 :                     smpsHeaderStartSong macro ver, sourcesmps2asmver
(2)  247/   67C30 :                     
(2)  248/   67C30 :                     SourceDriver set ver
(2)  249/   67C30 :                     
(2)  250/   67C30 :                     	if ("sourcesmps2asmver"<>"")
(2)  251/   67C30 :                     		set SourceSMPS2ASM,sourcesmps2asmver
(2)  252/   67C30 :                     	else
(2)  253/   67C30 :                     		set SourceSMPS2ASM,0
(2)  254/   67C30 :                     	endif
(2)  255/   67C30 :                     
(2)  256/   67C30 :                     songStart set *
(2)  257/   67C30 :                     
(2)  258/   67C30 :                     	if MOMPASS=1
(2)  259/   67C30 :                     		if SMPS2ASMVer < SourceSMPS2ASM
(2)  260/   67C30 :                     			message "Song at 0x\{songStart} was made for a newer version of SMPS2ASM (this is version \{SMPS2ASMVer}, but song wants at least version \{SourceSMPS2ASM})."
(2)  261/   67C30 :                     		endif
(2)  262/   67C30 :                     	endif
(2)  263/   67C30 :                     
(2)  264/   67C30 :                     	endm
(2)  265/   67C30 :                     
(2)  266/   67C30 :                     smpsHeaderVoiceNull macro
(2)  267/   67C30 :                     	if songStart<>*
(2)  268/   67C30 :                     		fatal "Missing smpsHeaderStartSong"
(2)  269/   67C30 :                     	endif
(2)  270/   67C30 :                     	dc.w	$0000
(2)  271/   67C30 :                     	endm
(2)  272/   67C30 :                     
(2)  273/   67C30 :                     ; Header - Set up Voice Location
(2)  274/   67C30 :                     ; Common to music and SFX
(2)  275/   67C30 :                     smpsHeaderVoice macro loc
(2)  276/   67C30 :                     	if songStart<>*
(2)  277/   67C30 :                     		fatal "Missing smpsHeaderStartSong"
(2)  278/   67C30 :                     	endif
(2)  279/   67C30 :                     	if SonicDriverVer<>1
(2)  280/   67C30 :                     		dc.w	z80_ptr(loc)
(2)  281/   67C30 :                     	else
(2)  282/   67C30 :                     		if (MOMPASS=1)&&(DEFINED(loc))
(2)  283/   67C30 :                     			fatal "Voice banks for Sonic 1 songs must come after the start of the song"
(2)  284/   67C30 :                     		endif
(2)  285/   67C30 :                     		dc.w	loc-songStart
(2)  286/   67C30 :                     	endif
(2)  287/   67C30 :                     	endm
(2)  288/   67C30 :                     
(2)  289/   67C30 :                     ; Header - Set up Voice Location as S3's Universal Voice Bank
(2)  290/   67C30 :                     ; Common to music and SFX
(2)  291/   67C30 :                     smpsHeaderVoiceUVB macro
(2)  292/   67C30 :                     	if songStart<>*
(2)  293/   67C30 :                     		fatal "Missing smpsHeaderStartSong"
(2)  294/   67C30 :                     	endif
(2)  295/   67C30 :                     	if SonicDriverVer>=5
(2)  296/   67C30 :                     		dc.w	z80_ptr(z80_UniVoiceBank)
(2)  297/   67C30 :                     	elseif SonicDriverVer>=3
(2)  298/   67C30 :                     		dc.w	little_endian(z80_UniVoiceBank)
(2)  299/   67C30 :                     	else
(2)  300/   67C30 :                     		fatal "Universal Voice Bank does not exist in Sonic 1 or Sonic 2 drivers"
(2)  301/   67C30 :                     	endif
(2)  302/   67C30 :                     	endm
(2)  303/   67C30 :                     
(2)  304/   67C30 :                     ; Header macros for music (not for SFX)
(2)  305/   67C30 :                     ; Header - Set up Channel Usage
(2)  306/   67C30 :                     smpsHeaderChan macro fm,psg
(2)  307/   67C30 :                     	dc.b	fm,psg
(2)  308/   67C30 :                     	endm
(2)  309/   67C30 :                     
(2)  310/   67C30 :                     ; Header - Set up Tempo
(2)  311/   67C30 :                     smpsHeaderTempo macro div,mod
(2)  312/   67C30 :                     	dc.b	div
(2)  313/   67C30 :                     	convertMainTempoMod mod
(2)  314/   67C30 :                     	endm
(2)  315/   67C30 :                     
(2)  316/   67C30 :                     ; Header - Set up DAC Channel
(2)  317/   67C30 :                     smpsHeaderDAC macro loc,pitch,vol
(2)  318/   67C30 :                     	CheckedChannelPointer loc
(2)  319/   67C30 :                     	if ("pitch"<>"")
(2)  320/   67C30 :                     		dc.b	pitch
(2)  321/   67C30 :                     		if ("vol"<>"")
(2)  322/   67C30 :                     			dc.b	vol
(2)  323/   67C30 :                     		else
(2)  324/   67C30 :                     			dc.b	$00
(2)  325/   67C30 :                     		endif
(2)  326/   67C30 :                     	else
(2)  327/   67C30 :                     		dc.w	$00
(2)  328/   67C30 :                     	endif
(2)  329/   67C30 :                     	endm
(2)  330/   67C30 :                     
(2)  331/   67C30 :                     ; Header - Set up FM Channel
(2)  332/   67C30 :                     smpsHeaderFM macro loc,pitch,vol
(2)  333/   67C30 :                     	CheckedChannelPointer loc
(2)  334/   67C30 :                     	dc.b	pitch,vol
(2)  335/   67C30 :                     	endm
(2)  336/   67C30 :                     
(2)  337/   67C30 :                     ; Header - Set up PSG Channel
(2)  338/   67C30 :                     smpsHeaderPSG macro loc,pitch,vol,mod,voice
(2)  339/   67C30 :                     	CheckedChannelPointer loc
(2)  340/   67C30 :                     	PSGPitchConvert pitch
(2)  341/   67C30 :                     	dc.b	vol
(2)  342/   67C30 :                     	; Frequency envelope
(2)  343/   67C30 :                     	if (SonicDriverVer>=3) && (SourceDriver<3)
(2)  344/   67C30 :                     		; In SMPS 68k Type 1, this byte is skipped and can contain garbage.
(2)  345/   67C30 :                     		; Sonic 2's Oil Ocean Zone and Ending themes set this byte to a non-zero value which
(2)  346/   67C30 :                     		; other drivers may try to process as valid data, so manually force it to 0 here.
(2)  347/   67C30 :                     		dc.b	0
(2)  348/   67C30 :                     	else
(2)  349/   67C30 :                     		if (MOMPASS==1) && (SonicDriverVer<3) && (SourceDriver>=3) && (mod<>0)
(2)  350/   67C30 :                     			message "This track header specifies a frequency envelope, but this driver does not support them."			
(2)  351/   67C30 :                     		endif
(2)  352/   67C30 :                     		dc.b	mod
(2)  353/   67C30 :                     	endif
(2)  354/   67C30 :                     	; Volume envelope
(2)  355/   67C30 :                     	dc.b	voice
(2)  356/   67C30 :                     	endm
(2)  357/   67C30 :                     
(2)  358/   67C30 :                     ; Header macros for SFX (not for music)
(2)  359/   67C30 :                     ; Header - Set up Tempo
(2)  360/   67C30 :                     smpsHeaderTempoSFX macro div
(2)  361/   67C30 :                     	dc.b	div
(2)  362/   67C30 :                     	endm
(2)  363/   67C30 :                     
(2)  364/   67C30 :                     ; Header - Set up Channel Usage
(2)  365/   67C30 :                     smpsHeaderChanSFX macro chan
(2)  366/   67C30 :                     	dc.b	chan
(2)  367/   67C30 :                     	endm
(2)  368/   67C30 :                     
(2)  369/   67C30 :                     ; Header - Set up FM Channel
(2)  370/   67C30 :                     smpsHeaderSFXChannel macro chanid,loc,pitch,vol
(2)  371/   67C30 :                     	if (SonicDriverVer>=3)&&(chanid==cNoise)
(2)  372/   67C30 :                     		fatal "Using channel ID of cNoise ($E0) in Sonic 3 driver is dangerous. Fix the song so that it turns into a noise channel instead."
(2)  373/   67C30 :                     	elseif (SonicDriverVer<3)&&(chanid==cFM6)
(2)  374/   67C30 :                     		fatal "Using channel ID of FM6 ($06) in Sonic 1 or Sonic 2 drivers is unsupported. Change it to another channel."
(2)  375/   67C30 :                     	endif
(2)  376/   67C30 :                     	dc.b	$80,chanid
(2)  377/   67C30 :                     	CheckedChannelPointer loc
(2)  378/   67C30 :                     	if (chanid&$80)<>0
(2)  379/   67C30 :                     		PSGPitchConvert pitch
(2)  380/   67C30 :                     	else
(2)  381/   67C30 :                     		dc.b	pitch
(2)  382/   67C30 :                     	endif
(2)  383/   67C30 :                     	dc.b	vol
(2)  384/   67C30 :                     	endm
(2)  385/   67C30 :                     ; ---------------------------------------------------------------------------
(2)  386/   67C30 :                     ; Co-ord Flag Macros and Equates
(2)  387/   67C30 :                     ; E0xx - Panning, AMS, FMS
(2)  388/   67C30 :                     smpsPan macro direction,amsfms
(2)  389/   67C30 :                     panNone set $00
(2)  390/   67C30 :                     panRight set $40
(2)  391/   67C30 :                     panLeft set $80
(2)  392/   67C30 :                     panCentre set $C0
(2)  393/   67C30 :                     panCenter set $C0 ; silly Americans :U
(2)  394/   67C30 :                     	dc.b $E0,direction+amsfms
(2)  395/   67C30 :                     	endm
(2)  396/   67C30 :                     
(2)  397/   67C30 :                     ; E1xx - Set channel detune to val
(2)  398/   67C30 :                     smpsDetune macro val
(2)  399/   67C30 :                     	dc.b	$E1,val
(2)  400/   67C30 :                     	endm
(2)  401/   67C30 :                     
(2)  402/   67C30 :                     ; E2xx - Used for setting a variable which can be read by the game, for synchronisation. Ristar does this.
(2)  403/   67C30 :                     smpsNop macro val
(2)  404/   67C30 :                     	if (SonicDriverVer>=3) && ((val==$FF) || (val==$29))
(2)  405/   67C30 :                     		warning "Values $FF and $29 are reserved in S3K's driver; use a different value or remove this command."
(2)  406/   67C30 :                     	endif
(2)  407/   67C30 :                     	dc.b	$E2,val
(2)  408/   67C30 :                     	endm
(2)  409/   67C30 :                     
(2)  410/   67C30 :                     ; Return (used after smpsCall)
(2)  411/   67C30 :                     smpsReturn macro val
(2)  412/   67C30 :                     	if SonicDriverVer>=3
(2)  413/   67C30 :                     		dc.b	$F9
(2)  414/   67C30 :                     	else
(2)  415/   67C30 :                     		dc.b	$E3
(2)  416/   67C30 :                     	endif
(2)  417/   67C30 :                     	endm
(2)  418/   67C30 :                     
(2)  419/   67C30 :                     ; Fade in previous song (ie. 1-Up)
(2)  420/   67C30 :                     smpsFade macro val
(2)  421/   67C30 :                     	if SonicDriverVer>=3
(2)  422/   67C30 :                     		dc.b	$E2
(2)  423/   67C30 :                     		if ("val"<>"")
(2)  424/   67C30 :                     			dc.b	val
(2)  425/   67C30 :                     		else
(2)  426/   67C30 :                     			dc.b	$FF
(2)  427/   67C30 :                     		endif
(2)  428/   67C30 :                     		if SourceDriver<3
(2)  429/   67C30 :                     			smpsStop
(2)  430/   67C30 :                     		endif
(2)  431/   67C30 :                     	elseif (SourceDriver>=3) && ("val"<>"") && ("val"<>"$FF")
(2)  432/   67C30 :                     		; This is actually a communication byte, not a fade.
(2)  433/   67C30 :                     		smpsNop	val
(2)  434/   67C30 :                     	else
(2)  435/   67C30 :                     		dc.b	$E4
(2)  436/   67C30 :                     	endif
(2)  437/   67C30 :                     	endm
(2)  438/   67C30 :                     
(2)  439/   67C30 :                     ; E5xx - Set channel tempo divider to xx
(2)  440/   67C30 :                     smpsChanTempoDiv macro val
(2)  441/   67C30 :                     	if SonicDriverVer>=5
(2)  442/   67C30 :                     		; New flag unique to Flamewing's modified S&K driver
(2)  443/   67C30 :                     		dc.b	$FF,$08,val
(2)  444/   67C30 :                     	elseif SonicDriverVer==3
(2)  445/   67C30 :                     		fatal "Coord. Flag to set tempo divider of a single channel does not exist in S3 driver. Use Flamewing's modified S&K sound driver instead."
(2)  446/   67C30 :                     	else
(2)  447/   67C30 :                     		dc.b	$E5,val
(2)  448/   67C30 :                     	endif
(2)  449/   67C30 :                     	endm
(2)  450/   67C30 :                     
(2)  451/   67C30 :                     ; E6xx - Alter Volume by xx
(2)  452/   67C30 :                     smpsAlterVol macro val
(2)  453/   67C30 :                     	dc.b	$E6,val
(2)  454/   67C30 :                     	endm
(2)  455/   67C30 :                     
(2)  456/   67C30 :                     ; E7 - Prevent attack of next note
(2)  457/   67C30 : =$E7                 smpsNoAttack	EQU $E7
(2)  458/   67C30 :                     
(2)  459/   67C30 :                     ; E8xx - Set note fill to xx
(2)  460/   67C30 :                     smpsNoteFill macro val
(2)  461/   67C30 :                     	if (SonicDriverVer>=5)&&(SourceDriver<3)
(2)  462/   67C30 :                     		; Unique to Flamewing's modified driver
(2)  463/   67C30 :                     		dc.b	$FF,$0A,val
(2)  464/   67C30 :                     	else
(2)  465/   67C30 :                     		if (SonicDriverVer>=3)&&(SourceDriver<3)
(2)  466/   67C30 :                     			message "Note fill will not work as intended unless you divide the fill value by the tempo divider or complain to Flamewing to add an appropriate coordination flag for it."
(2)  467/   67C30 :                     		elseif (SonicDriverVer<3)&&(SourceDriver>=3)
(2)  468/   67C30 :                     			message "Note fill will not work as intended unless you multiply the fill value by the tempo divider or complain to Flamewing to add an appropriate coordination flag for it."
(2)  469/   67C30 :                     		endif
(2)  470/   67C30 :                     		dc.b	$E8,val
(2)  471/   67C30 :                     	endif
(2)  472/   67C30 :                     	endm
(2)  473/   67C30 :                     
(2)  474/   67C30 :                     ; Add xx to channel pitch
(2)  475/   67C30 :                     smpsChangeTransposition macro val
(2)  476/   67C30 :                     	if SonicDriverVer>=3
(2)  477/   67C30 :                     		dc.b	$FB,val
(2)  478/   67C30 :                     	else
(2)  479/   67C30 :                     		dc.b	$E9,val
(2)  480/   67C30 :                     	endif
(2)  481/   67C30 :                     	endm
(2)  482/   67C30 :                     
(2)  483/   67C30 :                     ; Set music tempo modifier to xx
(2)  484/   67C30 :                     smpsSetTempoMod macro mod
(2)  485/   67C30 :                     	if SonicDriverVer>=3
(2)  486/   67C30 :                     		dc.b	$FF,$00
(2)  487/   67C30 :                     	else
(2)  488/   67C30 :                     		dc.b	$EA
(2)  489/   67C30 :                     	endif
(2)  490/   67C30 :                     	convertMainTempoMod mod
(2)  491/   67C30 :                     	endm
(2)  492/   67C30 :                     
(2)  493/   67C30 :                     ; Set music tempo divider to xx
(2)  494/   67C30 :                     smpsSetTempoDiv macro val
(2)  495/   67C30 :                     	if SonicDriverVer>=3
(2)  496/   67C30 :                     		dc.b	$FF,$04,val
(2)  497/   67C30 :                     	else
(2)  498/   67C30 :                     		dc.b	$EB,val
(2)  499/   67C30 :                     	endif
(2)  500/   67C30 :                     	endm
(2)  501/   67C30 :                     
(2)  502/   67C30 :                     ; ECxx - Set Volume to xx
(2)  503/   67C30 :                     smpsSetVol macro val
(2)  504/   67C30 :                     	if SonicDriverVer>=3
(2)  505/   67C30 :                     		dc.b	$E4,val
(2)  506/   67C30 :                     	else
(2)  507/   67C30 :                     		fatal "Coord. Flag to set volume (instead of volume attenuation) does not exist in S1 or S2 drivers. Complain to Flamewing to add it."
(2)  508/   67C30 :                     	endif
(2)  509/   67C30 :                     	endm
(2)  510/   67C30 :                     
(2)  511/   67C30 :                     ; Works on all drivers
(2)  512/   67C30 :                     smpsPSGAlterVol macro vol
(2)  513/   67C30 :                     	dc.b	$EC,vol
(2)  514/   67C30 :                     	endm
(2)  515/   67C30 :                     
(2)  516/   67C30 :                     smpsPSGAlterVolS2 macro vol
(2)  517/   67C30 :                     	; Sonic 2's driver allows the FM command to be used on PSG channels, but others do not.
(2)  518/   67C30 :                     	if SonicDriverVer==2
(2)  519/   67C30 :                     		smpsAlterVol vol
(2)  520/   67C30 :                     	else
(2)  521/   67C30 :                     		smpsPSGAlterVol vol
(2)  522/   67C30 :                     	endif
(2)  523/   67C30 :                     	endm
(2)  524/   67C30 :                     
(2)  525/   67C30 :                     ; Clears pushing sound flag in S1
(2)  526/   67C30 :                     smpsClearPush macro
(2)  527/   67C30 :                     	if SonicDriverVer==1
(2)  528/   67C30 :                     		dc.b	$ED
(2)  529/   67C30 :                     	else
(2)  530/   67C30 :                     		fatal "Coord. Flag to clear S1 push block flag does not exist in S2 or S3 drivers. Complain to Flamewing to add it."
(2)  531/   67C30 :                     	endif
(2)  532/   67C30 :                     	endm
(2)  533/   67C30 :                     
(2)  534/   67C30 :                     ; Stops special SFX (S1 only) and restarts overridden music track
(2)  535/   67C30 :                     smpsStopSpecial macro
(2)  536/   67C30 :                     	if SonicDriverVer==1
(2)  537/   67C30 :                     		dc.b	$EE
(2)  538/   67C30 :                     	else
(2)  539/   67C30 :                     		message "Coord. Flag to stop special SFX does not exist in S2 or S3 drivers. Complain to Flamewing to add it. With adequate caution, smpsStop can do this job."
(2)  540/   67C30 :                     		smpsStop
(2)  541/   67C30 :                     	endif
(2)  542/   67C30 :                     	endm
(2)  543/   67C30 :                     
(2)  544/   67C30 :                     ; EFxx[yy] - Set Voice of FM channel to xx; xx < 0 means yy present
(2)  545/   67C30 :                     smpsFMvoice macro voice,songID
(2)  546/   67C30 :                     	if (SonicDriverVer>=3)&&("songID"<>"")
(2)  547/   67C30 :                     		dc.b	$EF,voice|$80,songID+$81
(2)  548/   67C30 :                     	else
(2)  549/   67C30 :                     		dc.b	$EF,voice
(2)  550/   67C30 :                     	endif
(2)  551/   67C30 :                     	endm
(2)  552/   67C30 :                     
(2)  553/   67C30 :                     ; F0wwxxyyzz - Modulation - ww: wait time - xx: modulation speed - yy: change per step - zz: number of steps
(2)  554/   67C30 :                     smpsModSet macro wait,speed,change,step
(2)  555/   67C30 :                     	dc.b	$F0
(2)  556/   67C30 :                     	if (SonicDriverVer>=3)&&(SourceDriver<3)
(2)  557/   67C30 :                     		dc.b	wait+1,speed,change,((step+1) * speed) & $FF
(2)  558/   67C30 :                     	elseif (SonicDriverVer<3)&&(SourceDriver>=3)
(2)  559/   67C30 :                     		dc.b	wait-1,speed,change,conv0To256(step)/conv0To256(speed)-1
(2)  560/   67C30 :                     	else
(2)  561/   67C30 :                     		dc.b	wait,speed,change,step
(2)  562/   67C30 :                     	endif
(2)  563/   67C30 :                     	;dc.b	speed,change,step
(2)  564/   67C30 :                     	endm
(2)  565/   67C30 :                     
(2)  566/   67C30 :                     ; Turn on Modulation
(2)  567/   67C30 :                     smpsModOn macro type
(2)  568/   67C30 :                     	if SonicDriverVer>=3
(2)  569/   67C30 :                     		if "type"<>""
(2)  570/   67C30 :                     			dc.b	$F4,type
(2)  571/   67C30 :                     		else
(2)  572/   67C30 :                     			dc.b	$F4,$80
(2)  573/   67C30 :                     		endif
(2)  574/   67C30 :                     	else
(2)  575/   67C30 :                     		dc.b	$F1
(2)  576/   67C30 :                     	endif
(2)  577/   67C30 :                     	endm
(2)  578/   67C30 :                     
(2)  579/   67C30 :                     ; F2 - End of channel
(2)  580/   67C30 :                     smpsStop macro
(2)  581/   67C30 :                     	dc.b	$F2
(2)  582/   67C30 :                     	endm
(2)  583/   67C30 :                     
(2)  584/   67C30 :                     ; F3xx - PSG waveform to xx
(2)  585/   67C30 :                     smpsPSGform macro form
(2)  586/   67C30 :                     	dc.b	$F3,form
(2)  587/   67C30 :                     	endm
(2)  588/   67C30 :                     
(2)  589/   67C30 :                     ; Turn off Modulation
(2)  590/   67C30 :                     smpsModOff macro
(2)  591/   67C30 :                     	if SonicDriverVer>=3
(2)  592/   67C30 :                     		dc.b	$FA
(2)  593/   67C30 :                     	else
(2)  594/   67C30 :                     		dc.b	$F4
(2)  595/   67C30 :                     	endif
(2)  596/   67C30 :                     	endm
(2)  597/   67C30 :                     
(2)  598/   67C30 :                     ; F5xx - PSG voice to xx
(2)  599/   67C30 :                     smpsPSGvoice macro voice
(2)  600/   67C30 :                     	dc.b	$F5,voice
(2)  601/   67C30 :                     	endm
(2)  602/   67C30 :                     
(2)  603/   67C30 :                     ; F6xxxx - Jump to xxxx
(2)  604/   67C30 :                     smpsJump macro loc
(2)  605/   67C30 :                     	dc.b	$F6
(2)  606/   67C30 :                     	if SonicDriverVer<>1
(2)  607/   67C30 :                     		dc.w	z80_ptr(loc)
(2)  608/   67C30 :                     	else
(2)  609/   67C30 :                     		dc.w	loc-*-1
(2)  610/   67C30 :                     	endif
(2)  611/   67C30 :                     	endm
(2)  612/   67C30 :                     
(2)  613/   67C30 :                     ; F7xxyyzzzz - Loop back to zzzz yy times, xx being the loop index for loop recursion fixing
(2)  614/   67C30 :                     smpsLoop macro index,loops,loc
(2)  615/   67C30 :                     	dc.b	$F7
(2)  616/   67C30 :                     	dc.b	index,loops
(2)  617/   67C30 :                     	if SonicDriverVer<>1
(2)  618/   67C30 :                     		dc.w	z80_ptr(loc)
(2)  619/   67C30 :                     	else
(2)  620/   67C30 :                     		dc.w	loc-*-1
(2)  621/   67C30 :                     	endif
(2)  622/   67C30 :                     	endm
(2)  623/   67C30 :                     
(2)  624/   67C30 :                     ; F8xxxx - Call pattern at xxxx, saving return point
(2)  625/   67C30 :                     smpsCall macro loc
(2)  626/   67C30 :                     	dc.b	$F8
(2)  627/   67C30 :                     	if SonicDriverVer<>1
(2)  628/   67C30 :                     		dc.w	z80_ptr(loc)
(2)  629/   67C30 :                     	else
(2)  630/   67C30 :                     		dc.w	loc-*-1
(2)  631/   67C30 :                     	endif
(2)  632/   67C30 :                     	endm
(2)  633/   67C30 :                     ; ---------------------------------------------------------------------------
(2)  634/   67C30 :                     ; Alter Volume
(2)  635/   67C30 :                     smpsFMAlterVol macro val1,val2
(2)  636/   67C30 :                     	if ("val2"<>"")
(2)  637/   67C30 :                     		; S3K's nerfed 'PSG & FM volume' command with broken PSG support.
(2)  638/   67C30 :                     		; The first value is completely unused, while the second is for FM tracks.
(2)  639/   67C30 :                     		if (SonicDriverVer>=3)
(2)  640/   67C30 :                     			dc.b	$E5,val1,val2
(2)  641/   67C30 :                     		else
(2)  642/   67C30 :                     			dc.b	$E6,val2
(2)  643/   67C30 :                     		endif
(2)  644/   67C30 :                     	else
(2)  645/   67C30 :                     		; Normal, sane command.
(2)  646/   67C30 :                     		dc.b	$E6,val1
(2)  647/   67C30 :                     	endif
(2)  648/   67C30 :                     	endm
