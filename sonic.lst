(1)  849/    628E : D86B 0004           		add.w	4(a3),d4				; add Screen Y position
(1)  850/    6292 : DA53                		add.w	(a3),d5					; add Screen X position
(1)  851/    6294 : 0244 00F0           		andi.w	#$F0,d4					; keep in range of plane Y size ($100) in multiples of 16 pixels (block size)
(1)  852/    6298 : 0245 01F0           		andi.w	#$1F0,d5				; keep in range of plane X size ($200) in multiples of 16 pixels (block size)
(1)  853/    629C : E94C                		lsl.w	#4,d4					; multiply Y by 16 (multiples of $100)
(1)  854/    629E : E44D                		lsr.w	#2,d5					; divide X by 4 (multiples of 4)
(1)  855/    62A0 : D845                		add.w	d5,d4					; fuse X to Y
(1)  856/    62A2 : 7002                		moveq	#2,d0					; prepare VDP setting $8000+ address
(1)  857/    62A4 : 4840                		swap	d0					; send to upper word
(1)  858/    62A6 : 3004                		move.w	d4,d0					; load calculated plane position
(1)  859/    62A8 : 4E75                		rts						; return (d0 contains VDP control port address)
(1)  860/    62AA :                     ; End of function Calc_VRAM_Pos_PlaneZ
