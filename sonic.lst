(2)  791/   4B9B8 :                     smpsVcFeedback macro val
(2)  792/   4B9B8 :                     vcFeedback eval val
(2)  793/   4B9B8 :                     	endm
(2)  794/   4B9B8 :                     
(2)  795/   4B9B8 :                     ; Voices - Algorithm
(2)  796/   4B9B8 :                     smpsVcAlgorithm macro val
(2)  797/   4B9B8 :                     vcAlgorithm eval val
(2)  798/   4B9B8 :                     	endm
(2)  799/   4B9B8 :                     
(2)  800/   4B9B8 :                     smpsVcUnusedBits macro val,d1r1,d1r2,d1r3,d1r4
(2)  801/   4B9B8 :                     vcUnusedBits eval val
(2)  802/   4B9B8 :                     	if ("d1r1"<>"")&&("d1r2"<>"")&&("d1r3"<>"")&&("d1r4"<>"")
(2)  803/   4B9B8 :                     		eval vcD1R1Unk,d1r1<<5
(2)  804/   4B9B8 :                     		eval vcD1R2Unk,d1r2<<5
(2)  805/   4B9B8 :                     		eval vcD1R3Unk,d1r3<<5
(2)  806/   4B9B8 :                     		eval vcD1R4Unk,d1r4<<5
(2)  807/   4B9B8 :                     	else
(2)  808/   4B9B8 :                     		eval vcD1R1Unk,0
(2)  809/   4B9B8 :                     		eval vcD1R2Unk,0
(2)  810/   4B9B8 :                     		eval vcD1R3Unk,0
(2)  811/   4B9B8 :                     		eval vcD1R4Unk,0
(2)  812/   4B9B8 :                     	endif
