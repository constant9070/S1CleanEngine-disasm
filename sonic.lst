(1)  244/       0 :                     		cmpi.w	#128+320+192+ExtraWidth,d0
(1)  245/       0 :                     		bls.s	.noOffscreenXDelete			; if object is still in range, don't do anything
(1)  246/       0 :                     		respawn_entry.ATTRIBUTE exit			; try to fetch this object's respawn entry, exit if there is none
(1)  247/       0 :                     		bclr	#7,(a2)					; clear respawn table entry, so object can be loaded again
(1)  248/       0 :                     		bra.ATTRIBUTE	exit				; branch to exit (to delete the object)
(1)  249/       0 :                     .noOffscreenXDelete:
(1)  250/       0 :                     		endm
