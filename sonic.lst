(1)   34/    AFA6 :                     
(1)   35/    AFA6 :                     ; Separate logic while Sonic is dying, used to freeze level objects in place
(1)   36/    AFA6 :                     ; while still executing reserved objects normally (mainly Sonic himself).
(1)   37/    AFA6 :                     
(1)   38/    AFA6 :                     ; loc_D362:
(1)   39/    AFA6 :                     .sonic_dead:
(1)   40/    AFA6 : 7E1F                		moveq	#(v_lvlobjspace-v_objspace)/object_size-1,d7 ; run first 32 objects normally (reserved objects like Sonic)
(1)   41/    AFA8 : 61E2                		bsr.s	.run_object			; execute those objects and return here
(1)   42/    AFAA :                     
(1)   43/    AFAA : 7E5F                		moveq	#(v_lvlobjend-v_lvlobjspace)/object_size-1,d7 ; run the remaining 96 objects in display-only mode
(1)   44/    AFAC :                     ; loc_D368:
(1)   45/    AFAC :                     .display_object:
(1)   46/    AFAC : 7000                		moveq	#0,d0				; clear d0
(1)   47/    AFAE : 1010                		move.b	obID(a0),d0			; load object ID from RAM
(1)   48/    AFB0 : 670A                		beq.s	.next_object_displayonly	; if ID is 0, this is an empty object slot, branch
(1)   49/    AFB2 : 4A28 0001           		tst.b	obRender(a0)			; was object on-screen as Sonic died?
(1)   50/    AFB6 : 6A04                		bpl.s	.next_object_displayonly	; if not, branch
(1)   51/    AFB8 : 6100 0280           		bsr.w	DisplaySprite			; keep displaying the object as Sonic dies but don't execute it
(1)   52/    AFBC :                     
(1)   53/    AFBC :                     	; loc_D378:
(1)   54/    AFBC :                     	.next_object_displayonly:
(1)   55/    AFBC : 41E8 0040           		lea	object_size(a0),a0		; increase a0 to go to next object entry ($40 bytes)
(1)   56/    AFC0 : 51CF FFEA           		dbf	d7,.display_object		; loop until all objects have been executed
(1)   57/    AFC4 : 4E75                		rts					; return
