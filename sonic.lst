(1)   71/    FCCE :                     .processColumnLoop2:
(1)   72/    FCCE : E348                		lsl.w	#1,d0
(1)   73/    FCD0 : 6402                		bhs.s	.pixelNotSolid2
(1)   74/    FCD2 : 5302                		subq.b	#1,d2
(1)   75/    FCD4 :                     .pixelNotSolid2:
(1)   76/    FCD4 : 51C9 FFF8           		dbf	d1,.processColumnLoop2
(1)   77/    FCD8 : 6006                		bra.s	.columnProcessed
(1)   78/    FCDA :                     ; ---------------------------------------------------------------------------
(1)   79/    FCDA :                     
(1)   80/    FCDA :                     .entireColumnSolid:
(1)   81/    FCDA : 303C 0010           		move.w	#$10,d0
(1)   82/    FCDE :                     .noCollision:
