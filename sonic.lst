    1542/    1DA4 :                     	include	"_inc/Palette Fading.asm" ; includes "PaletteFadeIn", "PaletteFadeOut", "PaletteWhiteIn", and "PaletteWhiteOut"
(1)    1/    1DA4 :                     ; ===========================================================================
(1)    2/    1DA4 :                     ; ---- Palette fading subroutines input format, shared by all variations ----
(1)    3/    1DA4 :                     ;
(1)    4/    1DA4 :                     ; v_pfade_start = Start position in palette. One word per color. Examples:
(1)    5/    1DA4 :                     ;                 $00: palette line 1, first color
(1)    6/    1DA4 :                     ;                 $20: palette line 2, first color
(1)    7/    1DA4 :                     ;                 $42: palette line 3, second color
(1)    8/    1DA4 :                     ; 
(1)    9/    1DA4 :                     ; v_pfade_size  = Number of colors to affect, minus 1. Examples:
(1)   10/    1DA4 :                     ;                 $0F: 16 colors (one palette line)
(1)   11/    1DA4 :                     ;                 $1F: 32 colors (two palette lines)
(1)   12/    1DA4 :                     ;                 $3F: is the entire palette (four palette lines)
(1)   13/    1DA4 :                     ; 
(1)   14/    1DA4 :                     ; v_pfade_start and v_pfade_size are back to back in RAM, so they usually
(1)   15/    1DA4 :                     ; get set together as a single word write to v_pfade_start. The most common
(1)   16/    1DA4 :                     ; setting is $003F for "the entire palette", which is why it has a shorthand.
(1)   17/    1DA4 :                     ; 
(1)   18/    1DA4 :                     ; One more note about RGB: the Mega Drive stores the color values backwards,
(1)   19/    1DA4 :                     ; meaning that one color word has the format BGR (blue-green-red).
(1)   20/    1DA4 :                     ; ===========================================================================
(1)   21/    1DA4 :                     
(1)   22/    1DA4 :                     
(1)   23/    1DA4 :                     ; ===========================================================================
(1)   24/    1DA4 :                     ; ---------------------------------------------------------------------------
(1)   25/    1DA4 :                     ; Subroutine to fade in from black
