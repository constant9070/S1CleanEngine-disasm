(1)  266/   118D4 :                     ; Subroutine to	find a free slot in the Special Stage sprite update list,
(1)  267/   118D4 :                     ; used to animate blocks collected/touched by Sonic.
(1)  268/   118D4 :                     ; ---------------------------------------------------------------------------
(1)  269/   118D4 :                     
(1)  270/   118D4 :                     ; SS_RemoveCollectedItem: <-- old misnomer
(1)  271/   118D4 :                     SS_FindFreeAnimationSlot:
(1)  272/   118D4 : 45F9 00FF 4400      		lea	(v_ss_animations).l,a2			; address of sprite update list
(1)  273/   118DA : 303C 001F           		move.w	#(v_ss_animations_end-v_ss_animations)/8-1,d0 ; up to $20 slots
(1)  274/   118DE :                     
(1)  275/   118DE :                     	.loop:
(1)  276/   118DE : 4A12                		tst.b	(a2)					; is slot free?
(1)  277/   118E0 : 6706                		beq.s	.return					; if yes, exit with it
(1)  278/   118E2 : 504A                		addq.w	#8,a2					; go to next slot
(1)  279/   118E4 : 51C8 FFF8           		dbf	d0,.loop				; try again
(1)  280/   118E8 :                     
(1)  281/   118E8 :                     	.return:
(1)  282/   118E8 : 4E75                		rts						; return with slot in a2
(1)  283/   118EA :                     ; End of function SS_FindFreeAnimationSlot
