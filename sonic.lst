(2)  814/   67C30 :                     
(2)  815/   67C30 :                     ; Voices - Detune
(2)  816/   67C30 :                     smpsVcDetune macro op1,op2,op3,op4
(2)  817/   67C30 :                     	eval vcDT1,op1
(2)  818/   67C30 :                     	eval vcDT2,op2
(2)  819/   67C30 :                     	eval vcDT3,op3
(2)  820/   67C30 :                     	eval vcDT4,op4
(2)  821/   67C30 :                     	endm
(2)  822/   67C30 :                     
(2)  823/   67C30 :                     ; Voices - Coarse-Frequency
(2)  824/   67C30 :                     smpsVcCoarseFreq macro op1,op2,op3,op4
(2)  825/   67C30 :                     	eval vcCF1,op1
(2)  826/   67C30 :                     	eval vcCF2,op2
(2)  827/   67C30 :                     	eval vcCF3,op3
(2)  828/   67C30 :                     	eval vcCF4,op4
(2)  829/   67C30 :                     	endm
(2)  830/   67C30 :                     
(2)  831/   67C30 :                     ; Voices - Rate Scale
(2)  832/   67C30 :                     smpsVcRateScale macro op1,op2,op3,op4
(2)  833/   67C30 :                     	eval vcRS1,op1
(2)  834/   67C30 :                     	eval vcRS2,op2
(2)  835/   67C30 :                     	eval vcRS3,op3
(2)  836/   67C30 :                     	eval vcRS4,op4
(2)  837/   67C30 :                     	endm
(2)  838/   67C30 :                     
(2)  839/   67C30 :                     ; Voices - Attack Rate
(2)  840/   67C30 :                     smpsVcAttackRate macro op1,op2,op3,op4
(2)  841/   67C30 :                     	eval vcAR1,op1
(2)  842/   67C30 :                     	eval vcAR2,op2
(2)  843/   67C30 :                     	eval vcAR3,op3
(2)  844/   67C30 :                     	eval vcAR4,op4
(2)  845/   67C30 :                     	endm
(2)  846/   67C30 :                     
(2)  847/   67C30 :                     ; Voices - Amplitude Modulation
(2)  848/   67C30 :                     ; The original SMPS2ASM erroneously assumed the 6th and 7th bits
(2)  849/   67C30 :                     ; were the Amplitude Modulation.
(2)  850/   67C30 :                     ; According to several docs, however, it's actually the high bit.
(2)  851/   67C30 :                     smpsVcAmpMod macro op1,op2,op3,op4
(2)  852/   67C30 :                     	if SourceSMPS2ASM==0
(2)  853/   67C30 :                     		eval vcAM1,op1<<5
(2)  854/   67C30 :                     		eval vcAM2,op2<<5
(2)  855/   67C30 :                     		eval vcAM3,op3<<5
(2)  856/   67C30 :                     		eval vcAM4,op4<<5
(2)  857/   67C30 :                     	else
(2)  858/   67C30 :                     		eval vcAM1,op1<<7
(2)  859/   67C30 :                     		eval vcAM2,op2<<7
(2)  860/   67C30 :                     		eval vcAM3,op3<<7
(2)  861/   67C30 :                     		eval vcAM4,op4<<7
(2)  862/   67C30 :                     	endif
(2)  863/   67C30 :                     	endm
(2)  864/   67C30 :                     
(2)  865/   67C30 :                     ; Voices - First Decay Rate
(2)  866/   67C30 :                     smpsVcDecayRate1 macro op1,op2,op3,op4
(2)  867/   67C30 :                     	eval vcD1R1,op1
(2)  868/   67C30 :                     	eval vcD1R2,op2
(2)  869/   67C30 :                     	eval vcD1R3,op3
(2)  870/   67C30 :                     	eval vcD1R4,op4
(2)  871/   67C30 :                     	endm
(2)  872/   67C30 :                     
(2)  873/   67C30 :                     ; Voices - Second Decay Rate
(2)  874/   67C30 :                     smpsVcDecayRate2 macro op1,op2,op3,op4
(2)  875/   67C30 :                     	eval vcD2R1,op1
(2)  876/   67C30 :                     	eval vcD2R2,op2
(2)  877/   67C30 :                     	eval vcD2R3,op3
(2)  878/   67C30 :                     	eval vcD2R4,op4
(2)  879/   67C30 :                     	endm
(2)  880/   67C30 :                     
(2)  881/   67C30 :                     ; Voices - Decay Level
(2)  882/   67C30 :                     smpsVcDecayLevel macro op1,op2,op3,op4
(2)  883/   67C30 :                     	eval vcDL1,op1
(2)  884/   67C30 :                     	eval vcDL2,op2
(2)  885/   67C30 :                     	eval vcDL3,op3
(2)  886/   67C30 :                     	eval vcDL4,op4
(2)  887/   67C30 :                     	endm
(2)  888/   67C30 :                     
(2)  889/   67C30 :                     ; Voices - Release Rate
(2)  890/   67C30 :                     smpsVcReleaseRate macro op1,op2,op3,op4
(2)  891/   67C30 :                     	eval vcRR1,op1
(2)  892/   67C30 :                     	eval vcRR2,op2
(2)  893/   67C30 :                     	eval vcRR3,op3
(2)  894/   67C30 :                     	eval vcRR4,op4
(2)  895/   67C30 :                     	endm
(2)  896/   67C30 :                     
(2)  897/   67C30 :                     smpsNotZ80 function cpu,(cpu<>128)&&(cpu<>32988)
(2)  898/   67C30 :                     
(2)  899/   67C30 :                     smpsDcb macro
(2)  900/   67C30 :                     		if smpsNotZ80(MOMCPU)
(2)  901/   67C30 :                     			dc.b ALLARGS
(2)  902/   67C30 :                     		else
(2)  903/   67C30 :                     			db ALLARGS
(2)  904/   67C30 :                     		endif
(2)  905/   67C30 :                     	endm
(2)  906/   67C30 :                     
(2)  907/   67C30 :                     ; Voices - Total Level
(2)  908/   67C30 :                     ; The original SMPS2ASM decides TL high bits automatically,
(2)  909/   67C30 :                     ; but later versions leave it up to the user.
(2)  910/   67C30 :                     ; Alternatively, if we're converting an SMPS 68k song to SMPS Z80,
(2)  911/   67C30 :                     ; then we *want* the TL bits to match the algorithm, because SMPS 68k
(2)  912/   67C30 :                     ; prefers the algorithm over the TL bits, ignoring the latter, while
(2)  913/   67C30 :                     ; SMPS Z80 does the opposite.
(2)  914/   67C30 :                     ; Unfortunately, there's nothing we can do if we're trying to convert
(2)  915/   67C30 :                     ; an SMPS Z80 song to SMPS 68k. It will ignore the bits no matter
(2)  916/   67C30 :                     ; what we do, so we just print a warning.
(2)  917/   67C30 :                     smpsVcTotalLevel macro op1,op2,op3,op4
(2)  918/   67C30 :                     	eval vcTL1,op1
(2)  919/   67C30 :                     	eval vcTL2,op2
(2)  920/   67C30 :                     	eval vcTL3,op3
(2)  921/   67C30 :                     	eval vcTL4,op4
(2)  922/   67C30 :                     	smpsDcb	(vcUnusedBits<<6)+(vcFeedback<<3)+vcAlgorithm
(2)  923/   67C30 :                     ;   0     1     2     3     4     5     6     7
(2)  924/   67C30 :                     ;%1000,%1000,%1000,%1000,%1010,%1110,%1110,%1111
(2)  925/   67C30 :                     	if SourceSMPS2ASM==0
(2)  926/   67C30 :                     		eval vcTLMask4,((vcAlgorithm==7)<<7)
(2)  927/   67C30 :                     		eval vcTLMask3,((vcAlgorithm>=4)<<7)
(2)  928/   67C30 :                     		eval vcTLMask2,((vcAlgorithm>=5)<<7)
(2)  929/   67C30 :                     		eval vcTLMask1,128
(2)  930/   67C30 :                     	else
(2)  931/   67C30 :                     		eval vcTLMask4,0
(2)  932/   67C30 :                     		eval vcTLMask3,0
(2)  933/   67C30 :                     		eval vcTLMask2,0
(2)  934/   67C30 :                     		eval vcTLMask1,0
(2)  935/   67C30 :                     	endif
(2)  936/   67C30 :                     
(2)  937/   67C30 :                     	if (SonicDriverVer>=3)&&(SourceDriver<3)
(2)  938/   67C30 :                     		eval vcTLMask4,((vcAlgorithm==7)<<7)
(2)  939/   67C30 :                     		eval vcTLMask3,((vcAlgorithm>=4)<<7)
(2)  940/   67C30 :                     		eval vcTLMask2,((vcAlgorithm>=5)<<7)
(2)  941/   67C30 :                     		eval vcTLMask1,128
(2)  942/   67C30 :                     		eval vcTL1,vcTL1&127
(2)  943/   67C30 :                     		eval vcTL2,vcTL2&127
(2)  944/   67C30 :                     		eval vcTL3,vcTL3&127
(2)  945/   67C30 :                     		eval vcTL4,vcTL4&127
(2)  946/   67C30 :                     	elseif (SonicDriverVer<3)&&(SourceDriver>=3)&&((((vcTL1|vcTLMask1)&128)<>128)||(((vcTL2|vcTLMask2)&128)<>((vcAlgorithm>=5)<<7))||(((vcTL3|vcTLMask3)&128)<>((vcAlgorithm>=4)<<7))||(((vcTL4|vcTLMask4)&128)<>((vcAlgorithm==7)<<7)))
(2)  947/   67C30 :                     		if MOMPASS=1
(2)  948/   67C30 :                     			message "Voice at 0x\{*} has TL bits that do not match its algorithm setting. This voice will not work in S1/S2 drivers."
(2)  949/   67C30 :                     		endif
(2)  950/   67C30 :                     	endif
(2)  951/   67C30 :                     
(2)  952/   67C30 :                     	if SonicDriverVer==2
(2)  953/   67C30 :                     		smpsDcb	(vcDT4<<4)+vcCF4       ,(vcDT2<<4)+vcCF2       ,(vcDT3<<4)+vcCF3       ,(vcDT1<<4)+vcCF1
(2)  954/   67C30 :                     		smpsDcb	(vcRS4<<6)+vcAR4       ,(vcRS2<<6)+vcAR2       ,(vcRS3<<6)+vcAR3       ,(vcRS1<<6)+vcAR1
(2)  955/   67C30 :                     		smpsDcb	vcAM4|vcD1R4|vcD1R4Unk ,vcAM2|vcD1R2|vcD1R2Unk ,vcAM3|vcD1R3|vcD1R3Unk ,vcAM1|vcD1R1|vcD1R1Unk
(2)  956/   67C30 :                     		smpsDcb	vcD2R4                 ,vcD2R2                 ,vcD2R3                 ,vcD2R1
(2)  957/   67C30 :                     		smpsDcb	(vcDL4<<4)+vcRR4       ,(vcDL2<<4)+vcRR2       ,(vcDL3<<4)+vcRR3       ,(vcDL1<<4)+vcRR1
(2)  958/   67C30 :                     		smpsDcb	vcTL4|vcTLMask4        ,vcTL2|vcTLMask2        ,vcTL3|vcTLMask3        ,vcTL1|vcTLMask1
(2)  959/   67C30 :                     	else
(2)  960/   67C30 :                     		smpsDcb	(vcDT4<<4)+vcCF4       ,(vcDT3<<4)+vcCF3       ,(vcDT2<<4)+vcCF2       ,(vcDT1<<4)+vcCF1
(2)  961/   67C30 :                     		smpsDcb	(vcRS4<<6)+vcAR4       ,(vcRS3<<6)+vcAR3       ,(vcRS2<<6)+vcAR2       ,(vcRS1<<6)+vcAR1
(2)  962/   67C30 :                     		smpsDcb	vcAM4|vcD1R4|vcD1R4Unk ,vcAM3|vcD1R3|vcD1R3Unk ,vcAM2|vcD1R2|vcD1R2Unk ,vcAM1|vcD1R1|vcD1R1Unk
(2)  963/   67C30 :                     		smpsDcb	vcD2R4                 ,vcD2R3                 ,vcD2R2                 ,vcD2R1
(2)  964/   67C30 :                     		smpsDcb	(vcDL4<<4)+vcRR4       ,(vcDL3<<4)+vcRR3       ,(vcDL2<<4)+vcRR2       ,(vcDL1<<4)+vcRR1
(2)  965/   67C30 :                     		smpsDcb	vcTL4|vcTLMask4        ,vcTL3|vcTLMask3        ,vcTL2|vcTLMask2        ,vcTL1|vcTLMask1
(2)  966/   67C30 :                     	endif
(2)  967/   67C30 :                     	endm
(2)  968/   67C30 :                     
(2)  969/   67C30 :                     
(1) 2633/   67C30 :                     
(1) 2634/   67C30 :                     ; ---------------------------------------------------------------------------
(1) 2635/   67C30 :                     ; Music data
(1) 2636/   67C30 :                     ; ---------------------------------------------------------------------------
(1) 2637/   67C30 :                     Music81:	include "sound/music/Mus81 - GHZ.asm"
(2)    1/   67C30 :                     Mus81_GHZ_Header:
(2)    2/   67C30 : (MACRO)              	smpsHeaderStartSong 1
