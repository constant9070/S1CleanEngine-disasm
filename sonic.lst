    1110/    1066 :                     ; Subroutine to read joypad input for P1 and P2 controllers and write to RAM.
    1111/    1066 :                     ; Extended to support 6-button controllers for both controller ports.
    1112/    1066 :                     ; ---------------------------------------------------------------------------
    1113/    1066 :                     
    1114/    1066 :                     ReadJoypads:
    1115/    1066 : 43F9 00A1 0003      		lea	(port_1_data).l,a1		; set to read first joypad port
    1116/    106C : 41F8 F604           		lea	(v_jpadhold1).w,a0		; address where P1 joypad states are written to
    1117/    1070 : 611A                		bsr.s	.read_3btn			; read standard 3-button inputs for P1
    1118/    1072 : 4A10                		tst.b	(a0)				; is P1 using a 6-button controller?
    1119/    1074 : 6A02                		bpl.s	.readP2				; if not, branch
    1120/    1076 : 613E                		bsr.s	.read_6btn			; read additional 6-button inputs for P1
    1121/    1078 :                     
    1122/    1078 :                     	.readP2:
    1123/    1078 : 43F9 00A1 0005      		lea	(port_2_data).l,a1		; set to read second joypad port
    1124/    107E : 41F8 F608           		lea	(v_jpadhold_p2).w,a0		; address where P2 joypad states are written to
    1125/    1082 : 6108                		bsr.s	.read_3btn			; read standard 3-button inputs for P2
    1126/    1084 : 4A10                		tst.b	(a0)				; is P2 using a 6-button controller?
    1127/    1086 : 6A02                		bpl.s	.return				; if not, branch
    1128/    1088 : 612C                		bsr.s	.read_6btn			; read additional 6-button inputs for P2
    1129/    108A :                     
    1130/    108A :                     	.return:
    1131/    108A : 4E75                		rts					; return
    1132/    108C :                     ; ---------------------------------------------------------------------------
    1133/    108C :                     
    1134/    108C :                     .read_3btn:
    1135/    108C :                     		; 3-Button inputs (SACBRLDU)
    1136/    108C : (MACRO)              		PollTH	1				; 1st TH poll (hi)
    1136/    108C : 12BC 0040                                   move.b  #$40,(a1)               ; read D-Pad, B, and C input (hi poll)
    1136/    1090 : 4E71                                nop                                     ; wait a bit after polling
    1136/    1092 : 4E71                                nop                                     ; (bus synchronization)
    1137/    1094 : 703F                		moveq	#%00111111,d0			; clear all other inputs from the hi-poll (for sanity)
    1138/    1096 : C011                		and.b	(a1),d0				; write D-Pad, B, and C input states to d0
    1139/    1098 : (MACRO)              		PollTH	0				; 2nd TH poll (lo)
    1139/    1098 : 12BC 0000                                   move.b  #0,(a1)                 ; read A and Start input (lo poll)
    1139/    109C : 4E71                                nop                                     ; wait a bit after polling
    1139/    109E : 4E71                                nop                                     ; (bus synchronization)
    1140/    10A0 : 7230                		moveq	#%00110000,d1			; clear all other inputs from the lo-poll (up and down)
    1141/    10A2 : C211                		and.b	(a1),d1				; write A and Start input states to d1
    1142/    10A4 : E509                		lsl.b	#2,d1				; move A and Start to highest bits
    1143/    10A6 : 8001                		or.b	d1,d0				; merge both poll results into d0
    1144/    10A8 :                     		; write result to v_jpadhold/v_jpadpress
    1145/    10A8 :                     
    1146/    10A8 :                     	.toJpadRam:
    1147/    10A8 : 4600                		not.b	d0				; flip bits so that 0=released and 1=pressed
    1148/    10AA : 1210                		move.b	(a0),d1				; get buttons held the previous frame
    1149/    10AC : 10C0                		move.b	d0,(a0)+			; write new HELD buttons
    1150/    10AE : B101                		eor.b	d0,d1				; xor with buttons held this frame
    1151/    10B0 : C200                		and.b	d0,d1				; find buttons pressed this frame
    1152/    10B2 : 10C1                		move.b	d1,(a0)+			; write new PRESSED buttons
    1153/    10B4 : 4E75                		rts					; return
    1154/    10B6 :                     ; ---------------------------------------------------------------------------
    1155/    10B6 :                     
    1156/    10B6 :                     .read_6btn:
    1157/    10B6 :                     		; 6-button inputs (0000MXYZ)
    1158/    10B6 : (MACRO)              		PollTH	1				; 3rd TH poll (hi)
    1158/    10B6 : 12BC 0040                                   move.b  #$40,(a1)               ; read D-Pad, B, and C input (hi poll)
    1158/    10BA : 4E71                                nop                                     ; wait a bit after polling
    1158/    10BC : 4E71                                nop                                     ; (bus synchronization)
    1159/    10BE : (MACRO)              		PollTH	0				; 4th TH poll (lo)
    1159/    10BE : 12BC 0000                                   move.b  #0,(a1)                 ; read A and Start input (lo poll)
    1159/    10C2 : 4E71                                nop                                     ; wait a bit after polling
    1159/    10C4 : 4E71                                nop                                     ; (bus synchronization)
    1160/    10C6 : (MACRO)              		PollTH	1				; 5th TH poll (hi)
    1160/    10C6 : 12BC 0040                                   move.b  #$40,(a1)               ; read D-Pad, B, and C input (hi poll)
    1160/    10CA : 4E71                                nop                                     ; wait a bit after polling
    1160/    10CC : 4E71                                nop                                     ; (bus synchronization)
    1161/    10CE : (MACRO)              		PollTH	0				; 6th TH poll (lo)
    1161/    10CE : 12BC 0000                                   move.b  #0,(a1)                 ; read A and Start input (lo poll)
    1161/    10D2 : 4E71                                nop                                     ; wait a bit after polling
    1161/    10D4 : 4E71                                nop                                     ; (bus synchronization)
    1162/    10D6 : (MACRO)              		PollTH	1				; 7th TH poll (hi, extra buttons are returned now)
    1162/    10D6 : 12BC 0040                                   move.b  #$40,(a1)               ; read D-Pad, B, and C input (hi poll)
    1162/    10DA : 4E71                                nop                                     ; wait a bit after polling
    1162/    10DC : 4E71                                nop                                     ; (bus synchronization)
    1163/    10DE : 700F                		moveq	#%00001111,d0			; clear all other inputs from the poll
    1164/    10E0 : C011                		and.b	(a1),d0				; write MODE, X, Y, Z input states to d0
    1165/    10E2 : 60C4                		bra.s	.toJpadRam			; write result to v_jpadhold_6btn/v_jpadpress_6btn
    1166/    10E4 :                     ; End of function ReadJoypads
