(1)  260/    A630 :                     SSRC_Main:	; Routine 0
(1)  261/    A630 : 2248                		movea.l	a0,a1					; set this root object to become the first emerald
(1)  262/    A632 :                     
(1)  263/    A632 : 45F9 0000 A624      		lea	(SSRC_PosData).l,a2			; load emerald X-position data
(1)  264/    A638 : 7400                		moveq	#0,d2					; start at first entry in v_emldlist
(1)  265/    A63A : 7200                		moveq	#0,d1					; clear d1 (v_emeralds is a byte, we need a word)
(1)  266/    A63C : 1238 FE57           		move.b	(v_emeralds).w,d1			; d1 = number of collected emeralds to display
(1)  267/    A640 : 5301                		subq.b	#1,d1					; subtract 1 for dbf
(1)  268/    A642 : 6500 0C2A           		bcs.w	DeleteObject				; if you have no emeralds, delete emerald object
(1)  269/    A646 :                     
(1)  270/    A646 :                     SSRC_Loop:
(1)  271/    A646 : (MACRO)              		_move.b	#id_SSRChaos,obID(a1)			; load next chaos emerald object
(1)  271/    A646 :  (MACRO-2)                           insn2op move.b, #id_SSRChaos,obID(a1)
(1)  271/    A646 : 137C 007F 0001                              !move.b   #id_SSRChaos,1+obID(a1)
(1)  271/    A64B :                                             !org    *-1
(1)  271/    A64B : 00                                          !dc.b   0
(1)  272/    A64C : 335A 0008           		move.w	(a2)+,obX(a1)				; get next x-position from SSRC_PosData
(1)  273/    A650 : 337C 00F0 000A      		move.w	#$F0,obScreenY(a1)			; set fixed y-position
(1)  274/    A656 :                     
(1)  275/    A656 : 47F8 FE58           		lea	(v_emldlist).w,a3			; check which emeralds you have
(1)  276/    A65A : 1633 2000           		move.b	(a3,d2.w),d3				; get next entry from array of collected emeralds
(1)  277/    A65E : 1343 001A           		move.b	d3,obFrame(a1)				; set that emerald's frame
(1)  278/    A662 : 1343 001C           		move.b	d3,obAnim(a1)				; set that emerald's animation
(1)  279/    A666 : 5202                		addq.b	#1,d2					; go to next entry in v_emldlist
(1)  280/    A668 :                     
