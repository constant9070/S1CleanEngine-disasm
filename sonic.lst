(2)  761/   4B9B8 :                     		smpsFMICommand $88,$0F
(2)  762/   4B9B8 :                     		smpsFMICommand $8C,$0F
(2)  763/   4B9B8 :                     	else
(2)  764/   4B9B8 :                     		dc.b	$F9
(2)  765/   4B9B8 :                     	endif
(2)  766/   4B9B8 :                     	endm
