    1770/    2A62 : 4AB8 F680           		tst.l	(v_plc_buffer).w			; are any PLC jobs queued?
    1771/    2A66 : 6716                		beq.s	.wait					; if not, branch
    1772/    2A68 : 4A38 F6FB           		tst.b	(v_plc_Busy).w				; has PLC DMA missed the previous frame?
    1773/    2A6C : 6610                		bne.s	.wait					; if yes, don't advance PLC this frame
    1774/    2A6E : 6100 EF1E           		bsr.w	ExecutePLC				; decompress the next PLC entry and queue it for DMA
    1775/    2A72 : 4A38 F62A           		tst.b	(v_vblank_routine).w			; has VBlank interrupt occurred while PLC was running?
    1776/    2A76 : 6606                		bne.s	.wait					; if not, branch
    1777/    2A78 : 50F8 F6FB           		st.b	(v_plc_Busy).w				; otherwise, set flag that next frame should skip PLC (flush DMA)
    1778/    2A7C : 4E75                		rts
    1779/    2A7E :                     .wait:
    1780/    2A7E : 4A38 F62A           		tst.b	(v_vblank_routine).w			; has VBlank routine finished?
    1781/    2A82 : 66FA                		bne.s	.wait					; if not, loop until it has
    1782/    2A84 :                     
    1783/    2A84 : 51F8 F6FB           		sf.b	(v_plc_Busy).w				; clear DMA busy flag
    1784/    2A88 : 4E75                		rts						; resume normal operation
    1785/    2A8A :                     ; End of function WaitForVBlank
