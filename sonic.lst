(1)    2/    AF7C :                     ; Object code execution subroutine
(1)    3/    AF7C :                     ; 
(1)    4/    AF7C :                     ; output:
(1)    5/    AF7C :                     ;	d7.l = OST index of last object (must not be changed by any object)
(1)    6/    AF7C :                     ;	a0 = address of OST of last object
(1)    7/    AF7C :                     ; 
(1)    8/    AF7C :                     ;	uses d0.l, a1 (objects may use other registers)
(1)    9/    AF7C :                     ; ---------------------------------------------------------------------------
(1)   10/    AF7C :                     
(1)   11/    AF7C :                     ExecuteObjects:
(1)   12/    AF7C : 41F8 D000           		lea	(v_objspace).w,a0		; set address for object RAM
(1)   13/    AF80 : 7E7F                		moveq	#(v_objspace_end-v_objspace)/object_size-1,d7 ; $80 objects - 1
(1)   14/    AF82 : 7000                		moveq	#0,d0				; clear d0
(1)   15/    AF84 : 0C38 0006 D024      		cmpi.b	#6,(v_player+obRoutine).w	; is Sonic dying?
(1)   16/    AF8A : 641A                		bhs.s	.sonic_dead			; if yes, branch to alternate logic
(1)   17/    AF8C :                     
(1)   18/    AF8C :                     ; loc_D348:
(1)   19/    AF8C :                     .run_object:
(1)   20/    AF8C : 1010                		move.b	(a0),d0				; load object ID from RAM
(1)   21/    AF8E : 670C                		beq.s	.next_object			; if ID is 0, this is an empty object slot, branch
(1)   22/    AF90 : D040                		add.w	d0,d0				; quadruple for...
(1)   23/    AF92 : D040                		add.w	d0,d0				; ...long-based indexing
