    1077/    1192 :                     ; Subroutine to read joypad input for P1 and P2 controllers and write to RAM.
    1078/    1192 :                     ; Extended to support 6-button controllers for both controller ports.
    1079/    1192 :                     ; ---------------------------------------------------------------------------
    1080/    1192 :                     
    1081/    1192 :                     ReadJoypads:
    1082/    1192 : 43F9 00A1 0003      		lea	(port_1_data).l,a1		; set to read first joypad port
    1083/    1198 : 41F8 F604           		lea	(v_jpadhold1).w,a0		; address where P1 joypad states are written to
    1084/    119C : 611A                		bsr.s	.read_3btn			; read standard 3-button inputs for P1
    1085/    119E : 4A10                		tst.b	(a0)				; is P1 using a 6-button controller?
    1086/    11A0 : 6A02                		bpl.s	.readP2				; if not, branch
    1087/    11A2 : 613E                		bsr.s	.read_6btn			; read additional 6-button inputs for P1
    1088/    11A4 :                     
    1089/    11A4 :                     	.readP2:
    1090/    11A4 : 43F9 00A1 0005      		lea	(port_2_data).l,a1		; set to read second joypad port
