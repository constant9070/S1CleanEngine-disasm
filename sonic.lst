    3721/    4C08 :                     
    3722/    4C08 : 0C78 0090 D008      		cmpi.w	#(320/2)-16,(v_player+obX).w	; has Sonic passed $90 on the X-axis (from the right)?
    3723/    4C0E : 6462                		bhs.s	End_MoveSonExit			; if not, branch
    3724/    4C10 :                     
    3725/    4C10 : 5438 F7D7           		addq.b	#2,(v_sonicend).w		; advance ending cutscene routine number
    3726/    4C14 : 11FC 0001 F7CC      		move.b	#1,(f_lockctrl).w		; lock player's controls (redundant, already locked)
    3727/    4C1A : 31FC 0800 F602      		move.w	#(btnR<<8),(v_jpadhold2).w	; simulate holding down the right D-Pad button to trigger skidding animation
    3728/    4C20 : 4E75                		rts					; return
