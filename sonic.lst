(2)  816/   4B9B8 :                     smpsVcDetune macro op1,op2,op3,op4
(2)  817/   4B9B8 :                     	eval vcDT1,op1
(2)  818/   4B9B8 :                     	eval vcDT2,op2
(2)  819/   4B9B8 :                     	eval vcDT3,op3
(2)  820/   4B9B8 :                     	eval vcDT4,op4
(2)  821/   4B9B8 :                     	endm
(2)  822/   4B9B8 :                     
