(1)   21/    2D58 : 3802                		move.w	d2,d4					; reload Y
(1)   22/    2D5A :                     
(1)   23/    2D5A : 4A43                		tst.w	d3					; check X polarity
(1)   24/    2D5C : 6A00 0004           		bpl.w	.posX					; if it's already positive, branch
