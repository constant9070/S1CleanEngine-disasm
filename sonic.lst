(1)  411/    144A :                     
(1)  412/    144A :                     LoadDynPLC:
(1)  413/    144A : 0240 00FF           		andi.w	#$FF,d0					; mask out anything except the input frame
(1)  414/    144E : D040                		add.w	d0,d0					; double ID (for word-based indexing)
(1)  415/    1450 : D4F2 0000           		adda.w	(a2,d0.w),a2				; find current DPLC entry
(1)  416/    1454 : 7A00                		moveq	#0,d5					; clear d5
(1)  417/    1456 : 1A1A                		move.b	(a2)+,d5				; get number of tasks in this DPLC entry
(1)  418/    1458 : 5345                		subq.w	#1,d5					; subtract 1 from number of tasks (will be the loop count)
(1)  419/    145A : 6B00 002A           		bmi.w	.end					; if it underflowed, this is an empty entry, nothing to do
(1)  420/    145E :                     		
(1)  421/    145E :                     	.loop:
(1)  422/    145E : 161A                		move.b	(a2)+,d3				; get first byte of DPLC task
(1)  423/    1460 : 1F03                		move.b	d3,-(sp)				; move it to stack (bytes shift sp by 2)
(1)  424/    1462 : 7200                		moveq	#0,d1					; clear d1
(1)  425/    1464 : 321F                		move.w	(sp)+,d1				; move it from stack to upper byte of d1
(1)  426/    1466 : 121A                		move.b	(a2)+,d1				; get second byte of DPLC task
(1)  427/    1468 : 0243 00F0           		andi.w	#$F0,d3					; only look at upper nybble of first byte
(1)  428/    146C : 0643 0010           		addi.w	#$10,d3					; add 1 to that nybble
(1)  429/    1470 : 0241 0FFF           		andi.w	#$FFF,d1				; mask out that nybble in the other part
(1)  430/    1474 : EB89                		lsl.l	#5,d1					; multiply by $20 (tile_size)
(1)  431/    1476 : D286                		add.l	d6,d1					; add art location
(1)  432/    1478 : 3404                		move.w	d4,d2					; set target VRAM location
(1)  433/    147A : D843                		add.w	d3,d4					; advance VRAM pointer
(1)  434/    147C : D843                		add.w	d3,d4					; (twice, for word-based tiles)
(1)  435/    147E : 6100 FD06           		bsr.w	QueueDMATransfer			; load DMA request into queue (also known as "DMA_68KtoVRAM")
(1)  436/    1482 : 51CD FFDA           		dbf	d5,.loop				; repeat for number of entries
(1)  437/    1486 :                     		
(1)  438/    1486 :                     	.end:
(1)  439/    1486 : 4E75                		rts						; return
