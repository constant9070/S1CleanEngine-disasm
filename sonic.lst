(1)  273/       0 :                     out_of_range:	macro exit,pos,bmicheck
(1)  274/       0 :                     	if ("pos"<>"")
(1)  275/       0 :                     		move.w	pos,d0		; get object position (if specified as not obX)
(1)  276/       0 :                     	else
(1)  277/       0 :                     		move.w	obX(a0),d0	; get object position
(1)  278/       0 :                     	endif
(1)  279/       0 :                     		andi.w	#$FF80,d0	; round down to nearest $80
(1)  280/       0 :                     		move.w	(v_screenposx).w,d1 ; get screen position
