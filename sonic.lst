    4511/   13B74 :                     	; Nem_SegaLogo has a bunch of padding before it that differs between revisions:
    4512/   13B74 :                     	; - in rev00, it starts at $1DC00, which amounts to $EE bytes
    4513/   13B74 :                     	; - in rev01/rev02, it starts at $1E700, which amounts to $48E bytes
    4514/   13B74 :                     	; From a technical standpoint, this padding serves no purpose.
    4516/   13B74 : (MACRO)              		align	$200
    4516/   13B74 :  (MACRO-2)                   cnop 0,$200
    4516/   13B74 :   (MACRO-3)                          org (*-1+($200)-((*-1+(-(0)))#($200)))
    4516/   13C00 :                                             !org (*-1+($200)-((*-1+(-(0)))#($200)))
