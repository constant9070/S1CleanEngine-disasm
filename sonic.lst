(1)  219/   54B86 :                     ; ---------------------------------------------------------------------------
(1)  220/   54B86 :                     ; ===========================================================================
(1)  221/   54B86 :                     ; ---------------------------------------------------------------------------
(1)  222/   54B86 :                     ; Macro to generate title card data dynamically:
(1)  223/   54B86 :                     ; sprite mappings, letter loading array, and ConData
(1)  224/   54B86 :                     ; ---------------------------------------------------------------------------
(1)  225/   54B86 :                     
(1)  226/   54B86 :                     maketitlecard:	macro textline,hideAct,specialTileOffset,{INTLABEL}
(1)  227/   54B86 :                     __LABEL__:	label *
(1)  228/   54B86 :                     
(1)  229/   54B86 :                     		; length check
(1)  230/   54B86 :                     		set len, strlen(textline)
(1)  231/   54B86 :                     		if len>20
(1)  232/   54B86 :                     			fatal "maximum length is 20 characters"
(1)  233/   54B86 :                     		endif
(1)  234/   54B86 :                     
(1)  235/   54B86 :                     		; calculate sprite count and width
(1)  236/   54B86 :                     		set useSmallSpaces, 0
(1)  237/   54B86 :                     		set sizeX, $00
(1)  238/   54B86 :                     		set spaces, 0
(1)  239/   54B86 :                     		set i, 0
(1)  240/   54B86 :                     		while (i<len)
(1)  241/   54B86 :                     			set char, substr(textline,i,1)
(1)  242/   54B86 :                     
(1)  243/   54B86 :                     			set sizeX, sizeX+$10
(1)  244/   54B86 :                     			if (char=' ')
(1)  245/   54B86 :                     				if (useSmallSpaces)
(1)  246/   54B86 :                     					set sizeX, sizeX-$08 ; small spaces are 8px smaller
(1)  247/   54B86 :                     				endif
(1)  248/   54B86 :                     				set spaces, spaces+1
(1)  249/   54B86 :                     			elseif (char='I')
(1)  250/   54B86 :                     				set sizeX, sizeX-8
(1)  251/   54B86 :                     			elseif (char>='a')&(char<='z')
(1)  252/   54B86 :                     				if (char='i')|(char='j')|(char='l')
(1)  253/   54B86 :                     					set sizeX, sizeX-7
(1)  254/   54B86 :                     				else
(1)  255/   54B86 :                     					set sizeX, sizeX-2
(1)  256/   54B86 :                     				endif
(1)  257/   54B86 :                     			endif
(1)  258/   54B86 :                     			set i, i+1
(1)  259/   54B86 :                     
(1)  260/   54B86 :                     			if ((sizeX>$FF)&(useSmallSpaces<>1))
(1)  261/   54B86 :                     				set useSmallSpaces, 1
