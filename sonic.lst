(1)   33/    B4D4 :                     ; ---------------------------------------------------------------------------
(1)   34/    B4D4 :                     ; Subroutine to check if an object is off screen
(1)   35/    B4D4 :                     ; More precise than above subroutine, taking width into account
(1)   36/    B4D4 :                     ;
(1)   37/    B4D4 :                     ; output:
(1)   38/    B4D4 :                     ;	d0 = 0 if on screen, 1 if off screen
