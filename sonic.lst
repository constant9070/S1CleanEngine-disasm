(2)  824/   4B9B8 :                     smpsVcCoarseFreq macro op1,op2,op3,op4
(2)  825/   4B9B8 :                     	eval vcCF1,op1
(2)  826/   4B9B8 :                     	eval vcCF2,op2
(2)  827/   4B9B8 :                     	eval vcCF3,op3
(2)  828/   4B9B8 :                     	eval vcCF4,op4
(2)  829/   4B9B8 :                     	endm
(2)  830/   4B9B8 :                     
(2)  831/   4B9B8 :                     ; Voices - Rate Scale
(2)  832/   4B9B8 :                     smpsVcRateScale macro op1,op2,op3,op4
(2)  833/   4B9B8 :                     	eval vcRS1,op1
(2)  834/   4B9B8 :                     	eval vcRS2,op2
(2)  835/   4B9B8 :                     	eval vcRS3,op3
(2)  836/   4B9B8 :                     	eval vcRS4,op4
(2)  837/   4B9B8 :                     	endm
(2)  838/   4B9B8 :                     
(2)  839/   4B9B8 :                     ; Voices - Attack Rate
(2)  840/   4B9B8 :                     smpsVcAttackRate macro op1,op2,op3,op4
(2)  841/   4B9B8 :                     	eval vcAR1,op1
(2)  842/   4B9B8 :                     	eval vcAR2,op2
(2)  843/   4B9B8 :                     	eval vcAR3,op3
(2)  844/   4B9B8 :                     	eval vcAR4,op4
(2)  845/   4B9B8 :                     	endm
(2)  846/   4B9B8 :                     
(2)  847/   4B9B8 :                     ; Voices - Amplitude Modulation
(2)  848/   4B9B8 :                     ; The original SMPS2ASM erroneously assumed the 6th and 7th bits
(2)  849/   4B9B8 :                     ; were the Amplitude Modulation.
(2)  850/   4B9B8 :                     ; According to several docs, however, it's actually the high bit.
(2)  851/   4B9B8 :                     smpsVcAmpMod macro op1,op2,op3,op4
(2)  852/   4B9B8 :                     	if SourceSMPS2ASM==0
(2)  853/   4B9B8 :                     		eval vcAM1,op1<<5
(2)  854/   4B9B8 :                     		eval vcAM2,op2<<5
(2)  855/   4B9B8 :                     		eval vcAM3,op3<<5
(2)  856/   4B9B8 :                     		eval vcAM4,op4<<5
(2)  857/   4B9B8 :                     	else
(2)  858/   4B9B8 :                     		eval vcAM1,op1<<7
(2)  859/   4B9B8 :                     		eval vcAM2,op2<<7
(2)  860/   4B9B8 :                     		eval vcAM3,op3<<7
(2)  861/   4B9B8 :                     		eval vcAM4,op4<<7
(2)  862/   4B9B8 :                     	endif
(2)  863/   4B9B8 :                     	endm
(2)  864/   4B9B8 :                     
(2)  865/   4B9B8 :                     ; Voices - First Decay Rate
(2)  866/   4B9B8 :                     smpsVcDecayRate1 macro op1,op2,op3,op4
(2)  867/   4B9B8 :                     	eval vcD1R1,op1
(2)  868/   4B9B8 :                     	eval vcD1R2,op2
(2)  869/   4B9B8 :                     	eval vcD1R3,op3
(2)  870/   4B9B8 :                     	eval vcD1R4,op4
(2)  871/   4B9B8 :                     	endm
(2)  872/   4B9B8 :                     
(2)  873/   4B9B8 :                     ; Voices - Second Decay Rate
(2)  874/   4B9B8 :                     smpsVcDecayRate2 macro op1,op2,op3,op4
(2)  875/   4B9B8 :                     	eval vcD2R1,op1
(2)  876/   4B9B8 :                     	eval vcD2R2,op2
(2)  877/   4B9B8 :                     	eval vcD2R3,op3
(2)  878/   4B9B8 :                     	eval vcD2R4,op4
(2)  879/   4B9B8 :                     	endm
(2)  880/   4B9B8 :                     
(2)  881/   4B9B8 :                     ; Voices - Decay Level
(2)  882/   4B9B8 :                     smpsVcDecayLevel macro op1,op2,op3,op4
(2)  883/   4B9B8 :                     	eval vcDL1,op1
(2)  884/   4B9B8 :                     	eval vcDL2,op2
(2)  885/   4B9B8 :                     	eval vcDL3,op3
(2)  886/   4B9B8 :                     	eval vcDL4,op4
(2)  887/   4B9B8 :                     	endm
(2)  888/   4B9B8 :                     
(2)  889/   4B9B8 :                     ; Voices - Release Rate
