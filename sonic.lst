(1)  602/   10C4C :                     ;	(a1).w = 16x16 tile number, x/yflip, solidness
(1)  603/   10C4C :                     ;	(a4).b = wall angle
(1)  604/   10C4C :                     ; 
(1)  605/   10C4C :                     ;	uses d0.w, d3.w, d4.w, d5.l, d6.w
