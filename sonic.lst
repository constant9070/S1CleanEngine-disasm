    1776/    2520 :                     ; >>> Subroutines for generic calculations
    1777/    2520 :                     	include	"_incObj/sub RandomNumber.asm"
(1)    1/    2520 :                     ; ---------------------------------------------------------------------------
(1)    2/    2520 :                     ; Subroutine to generate a pseudo-random number in d0
(1)    3/    2520 :                     ; ---------------------------------------------------------------------------
(1)    4/    2520 :                     
(1)    5/    2520 :                     RandomNumber:
(1)    6/    2520 : 2238 F636           		move.l	(v_random).w,d1			; load current pseudo random number
(1)    7/    2524 : 6606                		bne.s	.scramble			; if it's not 0, branch
(1)    8/    2526 : 223C 2A6D 365A      		move.l	#$2A6D365A,d1			; set initial/starting seed
(1)    9/    252C :                     
(1)   10/    252C :                     .scramble:
(1)   11/    252C : 2001                		move.l	d1,d0				; copy to d0
(1)   12/    252E : E581                		asl.l	#2,d1				; shift left two bits
(1)   13/    2530 : D280                		add.l	d0,d1				; add original to shifted
(1)   14/    2532 : E781                		asl.l	#3,d1				; shift left three more bits
(1)   15/    2534 : D280                		add.l	d0,d1				; add original again
(1)   16/    2536 : 3001                		move.w	d1,d0				; load lower word of shifted to original
(1)   17/    2538 : 4841                		swap	d1				; get upper word
(1)   18/    253A : D041                		add.w	d1,d0				; add upper to lower
(1)   19/    253C : 3200                		move.w	d0,d1				; save back to d1
(1)   20/    253E : 4841                		swap	d1				; swap upper and lower back
(1)   21/    2540 : 21C1 F636           		move.l	d1,(v_random).w			; save result for next time
(1)   22/    2544 : 4E75                		rts					; return (d0 contains pseudo-random number)
(1)   23/    2546 :                     ; End of function RandomNumber
(1)   24/    2546 :                     
