(1)   57/    B4F6 : 3028 000C           		move.w	obY(a0),d0			; get object's y-position
(1)   58/    B4FA : 9078 F704           		sub.w	(v_screenposy).w,d0		; subtract screen y-position
(1)   59/    B4FE : D041                		add.w	d1,d0				; add object height
(1)   60/    B500 : 6B0E                		bmi.s	.offscreen			; branch if object is off screen to the top
(1)   61/    B502 : D241                		add.w	d1,d1				; double height for undoing above addition and for bottom-side check
(1)   62/    B504 : 9041                		sub.w	d1,d0				; su object height
(1)   63/    B506 : 0C41 00E0           		cmpi.w	#224,d1				; is object on screen?
(1)   64/    B50A : 6C04                		bge.s	.offscreen			; if not, object is off screen to the bottom
(1)   72/    B50C :                     
(1)   73/    B50C : 7000                		moveq	#0,d0				; set Z-flag (object on screen)
(1)   74/    B50E : 4E75                		rts
