(1)  422/    954E :                     ; Subroutine to	make the sides of a monitor solid
(1)  423/    954E :                     ; 
(1)  424/    954E :                     ; input:
(1)  425/    954E :                     ;	d1 = width/2
(1)  426/    954E :                     ;	d2 = height/2
(1)  427/    954E :                     ; 
(1)  428/    954E :                     ; output:
(1)  429/    954E :                     ;	d0 = distance from side of monitor
(1)  430/    954E :                     ;	d1 = collision type: 0 = none; 1 = side collision; -1 = top/bottom collision
(1)  431/    954E :                     ;	d3 = distance from top of monitor
(1)  432/    954E :                     ; ---------------------------------------------------------------------------
(1)  433/    954E :                     
