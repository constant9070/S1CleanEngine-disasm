(2)  157/    5F34 : 6C04                		bge.s	.return					; if not, branch
(2)  158/    5F36 : 3238 F72A           		move.w	(v_limitright2).w,d1			; use the plain right boundary instead
(2)  159/    5F3A :                     	.return:
