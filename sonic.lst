(1)   15/   111F2 : 3428 0008           		move.w	obX(a0),d2				; load Sonic's x-axis position
(1)   16/   111F6 : 3628 000C           		move.w	obY(a0),d3				; load Sonic's y-axis position
(1)   17/   111FA : 5142                		subq.w	#sonic_react_width,d2			; d2 = X-position of Sonic's left edge
(1)   18/   111FC :                     
(1)   19/   111FC : 7A00                		moveq	#0,d5					; clear d5
(1)   20/   111FE : 1A28 0016           		move.b	obHeight(a0),d5				; load Sonic's height
(1)   21/   11202 : 5705                		subq.b	#3,d5					; shrink by 3px
(1)   22/   11204 : 9645                		sub.w	d5,d3					; d3 = Y-position of Sonic's top edge
(1)   23/   11206 :                     
(1)   25/   11206 : 0C28 0008 001C      		cmpi.b	#id_Duck,obAnim(a0)			; is Sonic in his ducking animation?
(1)   36/   1120C : 6606                		bne.s	.notducking				; if not, branch
(1)   37/   1120E : 0643 000C           		addi.w	#((sonic_height-3)-sonic_duck_height)*2,d3 ; adjust Y-position of Sonic's top edge when ducking
(1)   38/   11212 : 7A0A                		moveq	#sonic_duck_height,d5			; use alternate hitbox extent
(1)   39/   11214 :                     	.notducking:
