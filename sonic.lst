(2)   54/    9836 :                     ; Handle special animation flags ($FA-$FF)
(2)   55/    9836 :                     ; ---------------------------------------------------------------------------
(2)   56/    9836 :                     
(2)   57/    9836 :                     ; afEnd = return to beginning of animation (loop indefinitely)
(2)   58/    9836 :                     Anim_End_FF:
(2)   59/    9836 : 5200                		addq.b	#1,d0				; is the end flag = $FF?
(2)   60/    9838 : 660C                		bne.s	Anim_End_FE			; if not, branch
(2)   61/    983A : 117C 0000 001B      		move.b	#0,obAniFrame(a0)		; restart the animation from the beginning
(2)   62/    9840 : 1029 0001           		move.b	1(a1),d0			; read first frame ID in script
(2)   63/    9844 : 60CA                		bra.s	Anim_SetFrameAndFlipFlags	; display new frame
(2)   64/    9846 :                     ; ===========================================================================
(2)   65/    9846 :                     
(2)   66/    9846 :                     ; afBack = go back (specified number) of frames in animation script
(2)   67/    9846 :                     Anim_End_FE:
(2)   68/    9846 : 5200                		addq.b	#1,d0				; is the end flag = $FE?
(2)   69/    9848 : 6610                		bne.s	Anim_End_FD			; if not, branch
(2)   70/    984A : 1031 1002           		move.b	2(a1,d1.w),d0			; read the next byte in the script
(2)   71/    984E : 9128 001B           		sub.b	d0,obAniFrame(a0)		; decrement script index by that amount
(2)   72/    9852 : 9200                		sub.b	d0,d1				; jump back d0 bytes in the script
(2)   73/    9854 : 1031 1001           		move.b	1(a1,d1.w),d0			; read new frame ID in script
(2)   74/    9858 : 60B6                		bra.s	Anim_SetFrameAndFlipFlags	; display new frame
(2)   75/    985A :                     ; ===========================================================================
(2)   76/    985A :                     
(2)   77/    985A :                     ; afChange = change to a different animation
(2)   78/    985A :                     Anim_End_FD:
