(2)  797/   67C30 :                     vcAlgorithm eval val
(2)  798/   67C30 :                     	endm
(2)  799/   67C30 :                     
(2)  800/   67C30 :                     smpsVcUnusedBits macro val,d1r1,d1r2,d1r3,d1r4
(2)  801/   67C30 :                     vcUnusedBits eval val
(2)  802/   67C30 :                     	if ("d1r1"<>"")&&("d1r2"<>"")&&("d1r3"<>"")&&("d1r4"<>"")
(2)  803/   67C30 :                     		eval vcD1R1Unk,d1r1<<5
(2)  804/   67C30 :                     		eval vcD1R2Unk,d1r2<<5
(2)  805/   67C30 :                     		eval vcD1R3Unk,d1r3<<5
(2)  806/   67C30 :                     		eval vcD1R4Unk,d1r4<<5
(2)  807/   67C30 :                     	else
(2)  808/   67C30 :                     		eval vcD1R1Unk,0
(2)  809/   67C30 :                     		eval vcD1R2Unk,0
(2)  810/   67C30 :                     		eval vcD1R3Unk,0
(2)  811/   67C30 :                     		eval vcD1R4Unk,0
(2)  812/   67C30 :                     	endif
