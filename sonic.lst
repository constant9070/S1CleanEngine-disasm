(1)   84/    1E18 :                     ; ===========================================================================
(1)   85/    1E18 :                     
(1)   86/    1E18 :                     ; The fade-in logic increases one RGB value at a time until the target color
(1)   87/    1E18 :                     ; has been reached. Sonic 1 fades blue first, then green, then red, resulting
(1)   88/    1E18 :                     ; in the characteristic blue-tinted fade seen throughout the entire game.
(1)   89/    1E18 :                     ; A simultaneous RGB fade would appear more natural, but would also complete
(1)   90/    1E18 :                     ; much faster. This staggered approach may have been chosen to extend
(1)   91/    1E18 :                     ; the fade duration while giving it a distinct visual style.
(1)   92/    1E18 :                     
(1)   93/    1E18 :                     FadeIn_AddColor:
(1)   94/    1E18 : 3419                		move.w	(a1)+,d2				; get current target color (and advance index for next color)
(1)   95/    1E1A : 3610                		move.w	(a0),d3					; get current active color
(1)   96/    1E1C : B642                		cmp.w	d2,d3					; has active color already reached its target level?
(1)   97/    1E1E : 6720                		beq.s	.nextColor				; if yes, fade is done for this color
(1)   98/    1E20 :                     
(1)   99/    1E20 :                     	.addBlue:
(1)  100/    1E20 : 3203                		move.w	d3,d1					; get current active color
(1)  101/    1E22 : 0641 0200           		addi.w	#$200,d1				; increase blue value by one step
(1)  102/    1E26 : B242                		cmp.w	d2,d1					; has blue exceeded target level?
(1)  103/    1E28 : 6204                		bhi.s	.addGreen				; if yes, start fading in green
(1)  104/    1E2A : 30C1                		move.w	d1,(a0)+				; update active color
(1)  105/    1E2C : 4E75                		rts						; do not update green or red values until blue is done
(1)  106/    1E2E :                     ; ---------------------------------------------------------------------------
