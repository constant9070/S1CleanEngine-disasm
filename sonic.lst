    1021/    1114 :                     ; Subroutine to initialize joypads and check if either port is using
    1022/    1114 :                     ; a 6-button controller. MSB is set in v_jpadhold_6btn/v_jpadhold_6btn_p2
    1023/    1114 :                     ; if one has been detected.
    1024/    1114 :                     ; For reference, see: https://www.plutiedev.com/controllers#6-button
    1025/    1114 :                     ; ---------------------------------------------------------------------------
    1026/    1114 :                     
    1027/    1114 :                     ; Small helper macro that toggles the TH line and adds the required delay
    1028/    1114 :                     ; so the controller can output the correct button states. Defined as a macro
    1029/    1114 :                     ; to avoid repeating the same move/nop sequence over and over.
    1030/    1114 :                     PollTH	macro	hiPoll
    1031/    1114 :                     		if hiPoll>0
    1032/    1114 :                     			move.b	#$40,(a1)		; read D-Pad, B, and C input (hi poll)
    1033/    1114 :                     		else
    1034/    1114 :                     			move.b	#0,(a1)			; read A and Start input (lo poll)
    1035/    1114 :                     		endif
    1036/    1114 :                     		nop					; wait a bit after polling
    1037/    1114 :                     		nop					; (bus synchronization)
    1038/    1114 :                     	endm
    1039/    1114 :                     
