(1)  254/   12AF4 : 6602                		bne.s	.loadTiles				; if so, get to work
(1)  255/   12AF6 : 4E75                		rts						; nothing to do
(1)  256/   12AF8 :                     ; ---------------------------------------------------------------------------
(1)  257/   12AF8 :                     
(1)  258/   12AF8 :                     	.loadTiles:
