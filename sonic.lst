    4998/   54018 :                     ; ---------------------------------------------------------------------------
    4999/   54018 :                     
    5000/   54018 :                     	; SoundDriver starts at $71990 in all revisions, which amounts
    5001/   54018 :                     	; to $62A bytes of padding for rev00 and $63C for rev01/rev02.
    5002/   54018 :                     	; It appears to be placed in such a way that the sound driver
    5003/   54018 :                     	; ends right on the $80000 mark in the ROM in all revisions.
    5004/   54018 :                     	; From a technical standpoint, this padding serves no purpose.
    5006/   54018 :                     		; ProjectSonic1TwoEight requires $416 bytes of additional
    5007/   54018 :                     		; padding to have the sound driver aligned to the same
    5008/   54018 :                     		; position as the original game ($71990).
    5012/   54018 : (MACRO)              			dcb.b	$63C+$416,$FF
    5012/   54018 : FFFF FFFF FFFF              dc.b    [$63C+$416]$FF
