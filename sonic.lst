(1)  202/    1186 :                     		endif
(1)  203/    1186 :                     		if ((length)&1)<>0
(1)  204/    1186 :                     			fatal "DMA an odd number of bytes $\{length}!"
(1)  205/    1186 :                     		endif
(1)  206/    1186 :                     		if (length)==0
(1)  207/    1186 :                     			fatal "DMA transferring 0 bytes (becomes a 128kB transfer). If you really mean it, pass 128kB instead."
(1)  208/    1186 :                     		endif
(1)  209/    1186 :                     		if (((src)+(length)-1)>>17)<>((src)>>17)
(1)  210/    1186 :                     			fatal "DMA crosses a 128kB boundary. You should either split the DMA manually or align the source adequately."
(1)  211/    1186 :                     		endif
(1)  212/    1186 :                     	endif
