(1)    1/    7530 :                     ; ===========================================================================
(1)    2/    7530 :                     ; ---------------------------------------------------------------------------
(1)    3/    7530 :                     ; Subroutine to	update Sonic's position when standing on a platform.
(1)    4/    7530 :                     ; Also matches his X-position for moving platforms.
(1)    5/    7530 :                     ;
(1)    6/    7530 :                     ; input:
(1)    7/    7530 :                     ;	d2.w = platform X-position of previous frame
(1)    8/    7530 :                     ;	d3.w = platform height (MoveWithPlatform_CustomHeight only)
(1)    9/    7530 :                     ; ---------------------------------------------------------------------------
(1)   10/    7530 :                     
(1)   11/    7530 :                     MvSonicOnPtfm:	; custom platform height (in d3)
(1)   12/    7530 : 43F8 D000           		lea	(v_player).w,a1				; get Sonic object
(1)   13/    7534 : 3028 000C           		move.w	obY(a0),d0				; get Y-position of platform
(1)   14/    7538 : 9043                		sub.w	d3,d0					; subtract input height from platform Y-position
(1)   15/    753A : 600C                		bra.s	MoveWithPlatform			; skip over
(1)   16/    753C :                     ; ===========================================================================
(1)   17/    753C :                     
(1)   18/    753C :                     MvSonicOnPtfm2:	; assume platform height (fixed to 9px)
(1)   19/    753C : 43F8 D000           		lea	(v_player).w,a1				; get Sonic object
(1)   20/    7540 : 3028 000C           		move.w	obY(a0),d0				; get Y-position of platform
(1)   21/    7544 : 0440 0009           		subi.w	#9,d0					; subtract assumed height of 9px from platform Y-position
(1)   22/    7548 :                     ; ---------------------------------------------------------------------------
(1)   23/    7548 :                     
(1)   24/    7548 :                     ; MvSonic2:
(1)   25/    7548 :                     MoveWithPlatform:
(1)   26/    7548 : 4A38 F7C8           		tst.b	(f_playerctrl).w			; is object interaction disabled?
(1)   27/    754C : 6B22                		bmi.s	.return					; if yes, branch
(1)   28/    754E : 0C38 0006 D024      		cmpi.b	#6,(v_player+obRoutine).w		; is Sonic dying?
(1)   29/    7554 : 641A                		bhs.s	.return					; if yes, branch
(1)   30/    7556 : 4A78 FE08           		tst.w	(v_debuguse).w				; is debug mode in use?
(1)   31/    755A : 6614                		bne.s	.return					; if yes, branch
(1)   32/    755C :                     
(1)   33/    755C : 7200                		moveq	#0,d1					; clear d1
(1)   34/    755E : 1229 0016           		move.b	obHeight(a1),d1				; get Sonic's current height
(1)   35/    7562 : 9041                		sub.w	d1,d0					; d1 = Y-position so Sonic's feet are on the platform
(1)   36/    7564 : 3340 000C           		move.w	d0,obY(a1)				; set that as Sonic's new Y-position
(1)   37/    7568 :                     
(1)   38/    7568 : 9468 0008           		sub.w	obX(a0),d2				; d2 = X-delta of platform since last frame
(1)   39/    756C : 9569 0008           		sub.w	d2,obX(a1)				; update Sonic's X-position to move with the platform
