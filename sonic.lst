    1092/    11AE : 6108                		bsr.s	.read_3btn			; read standard 3-button inputs for P2
    1093/    11B0 : 4A10                		tst.b	(a0)				; is P2 using a 6-button controller?
    1094/    11B2 : 6A02                		bpl.s	.return				; if not, branch
    1095/    11B4 : 612C                		bsr.s	.read_6btn			; read additional 6-button inputs for P2
    1096/    11B6 :                     
    1097/    11B6 :                     	.return:
    1098/    11B6 : 4E75                		rts					; return
    1099/    11B8 :                     ; ---------------------------------------------------------------------------
    1100/    11B8 :                     
    1101/    11B8 :                     .read_3btn:
    1102/    11B8 :                     		; 3-Button inputs (SACBRLDU)
    1103/    11B8 : (MACRO)              		PollTH	1				; 1st TH poll (hi)
    1103/    11B8 : 12BC 0040                                   move.b  #$40,(a1)               ; read D-Pad, B, and C input (hi poll)
    1103/    11BC : 4E71                                nop                                     ; wait a bit after polling
    1103/    11BE : 4E71                                nop                                     ; (bus synchronization)
    1104/    11C0 : 703F                		moveq	#%00111111,d0			; clear all other inputs from the hi-poll (for sanity)
    1105/    11C2 : C011                		and.b	(a1),d0				; write D-Pad, B, and C input states to d0
    1106/    11C4 : (MACRO)              		PollTH	0				; 2nd TH poll (lo)
    1106/    11C4 : 12BC 0000                                   move.b  #0,(a1)                 ; read A and Start input (lo poll)
    1106/    11C8 : 4E71                                nop                                     ; wait a bit after polling
    1106/    11CA : 4E71                                nop                                     ; (bus synchronization)
    1107/    11CC : 7230                		moveq	#%00110000,d1			; clear all other inputs from the lo-poll (up and down)
    1108/    11CE : C211                		and.b	(a1),d1				; write A and Start input states to d1
    1109/    11D0 : E509                		lsl.b	#2,d1				; move A and Start to highest bits
    1110/    11D2 : 8001                		or.b	d1,d0				; merge both poll results into d0
    1111/    11D4 :                     		; write result to v_jpadhold/v_jpadpress
    1112/    11D4 :                     
    1113/    11D4 :                     	.toJpadRam:
    1114/    11D4 : 4600                		not.b	d0				; flip bits so that 0=released and 1=pressed
    1115/    11D6 : 1210                		move.b	(a0),d1				; get buttons held the previous frame
    1116/    11D8 : 10C0                		move.b	d0,(a0)+			; write new HELD buttons
    1117/    11DA : B101                		eor.b	d0,d1				; xor with buttons held this frame
    1118/    11DC : C200                		and.b	d0,d1				; find buttons pressed this frame
    1119/    11DE : 10C1                		move.b	d1,(a0)+			; write new PRESSED buttons
    1120/    11E0 : 4E75                		rts					; return
    1121/    11E2 :                     ; ---------------------------------------------------------------------------
    1122/    11E2 :                     
    1123/    11E2 :                     .read_6btn:
    1124/    11E2 :                     		; 6-button inputs (0000MXYZ)
    1125/    11E2 : (MACRO)              		PollTH	1				; 3rd TH poll (hi)
    1125/    11E2 : 12BC 0040                                   move.b  #$40,(a1)               ; read D-Pad, B, and C input (hi poll)
    1125/    11E6 : 4E71                                nop                                     ; wait a bit after polling
    1125/    11E8 : 4E71                                nop                                     ; (bus synchronization)
    1126/    11EA : (MACRO)              		PollTH	0				; 4th TH poll (lo)
    1126/    11EA : 12BC 0000                                   move.b  #0,(a1)                 ; read A and Start input (lo poll)
    1126/    11EE : 4E71                                nop                                     ; wait a bit after polling
    1126/    11F0 : 4E71                                nop                                     ; (bus synchronization)
    1127/    11F2 : (MACRO)              		PollTH	1				; 5th TH poll (hi)
    1127/    11F2 : 12BC 0040                                   move.b  #$40,(a1)               ; read D-Pad, B, and C input (hi poll)
    1127/    11F6 : 4E71                                nop                                     ; wait a bit after polling
    1127/    11F8 : 4E71                                nop                                     ; (bus synchronization)
    1128/    11FA : (MACRO)              		PollTH	0				; 6th TH poll (lo)
    1128/    11FA : 12BC 0000                                   move.b  #0,(a1)                 ; read A and Start input (lo poll)
    1128/    11FE : 4E71                                nop                                     ; wait a bit after polling
    1128/    1200 : 4E71                                nop                                     ; (bus synchronization)
    1129/    1202 : (MACRO)              		PollTH	1				; 7th TH poll (hi, extra buttons are returned now)
    1129/    1202 : 12BC 0040                                   move.b  #$40,(a1)               ; read D-Pad, B, and C input (hi poll)
    1129/    1206 : 4E71                                nop                                     ; wait a bit after polling
    1129/    1208 : 4E71                                nop                                     ; (bus synchronization)
    1130/    120A : 700F                		moveq	#%00001111,d0			; clear all other inputs from the poll
    1131/    120C : C011                		and.b	(a1),d0				; write MODE, X, Y, Z input states to d0
    1132/    120E : 60C4                		bra.s	.toJpadRam			; write result to v_jpadhold_6btn/v_jpadpress_6btn
    1133/    1210 :                     ; End of function ReadJoypads
    1134/    1210 :                     ; ---------------------------------------------------------------------------
    1135/    1210 :                     ; ===========================================================================
    1136/    1210 :                     
    1137/    1210 :                     
    1138/    1210 :                     ; ===========================================================================
    1139/    1210 :                     ; ---------------------------------------------------------------------------
    1140/    1210 :                     ; Subroutine to setup the VDP with values used for the game itself
    1141/    1210 :                     ; ---------------------------------------------------------------------------
    1142/    1210 :                     
    1143/    1210 :                     VDPSetupGame:
    1144/    1210 : 41F9 00C0 0004      		lea	(vdp_control_port).l,a0		; load VDP control port
    1145/    1216 : 43F9 00C0 0000      		lea	(vdp_data_port).l,a1		; load VDP data port
    1146/    121C : 45F9 0000 128C      		lea	(VDPSetupArray).l,a2		; load address of register values
    1147/    1222 : 7E12                		moveq	#(VDPSetupArray_End-VDPSetupArray)/2-1,d7 ; set repeat times
    1148/    1224 :                     .setreg:
    1149/    1224 : 309A                		move.w	(a2)+,(a0)			; save register value to VDP
    1150/    1226 : 51CF FFFC           		dbf	d7,.setreg			; repeat until all register values have been sent
    1151/    122A :                     
    1152/    122A : 3039 0000 128E      		move.w	(VDPSetupArray+2).l,d0		; get second entry of VDPSetupArray
    1153/    1230 : 31C0 F60C           		move.w	d0,(v_vdp_buffer1).w		; buffer register $81 (used for enabling/disabling display)
    1154/    1234 :                     
    1155/    1234 : 31FC 8ADF F624      		move.w	#$8A00+223,(v_hblank_hreg).w	; HBlank every 224th scanline
    1156/    123A :                     
    1157/    123A : 7000                		moveq	#cBlack,d0			; set d0 to 0 (black)
    1158/    123C : 23FC C000 0000      		move.l	#$C0000000,(vdp_control_port).l	; set VDP to CRAM write
             1242 : 00C0 0004          
    1159/    1246 : 3E3C 003F           		move.w	#($80)/2-1,d7			; set repeat times to cover full CRAM
    1160/    124A :                     .clrCRAM:
    1161/    124A : 3280                		move.w	d0,(a1)				; clear colours
    1162/    124C : 51CF FFFC           		dbf	d7,.clrCRAM                     ; repeat until the entire palette is clear (black)
    1163/    1250 :                     
    1164/    1250 : 42B8 F616           		clr.l	(v_scrposy_vdp).w		; clear single vertical scroll buffer
    1165/    1254 : 42B8 F61A           		clr.l	(v_scrposx_vdp).w		; clear single horizontal scroll buffer
    1166/    1258 : 2F01                		move.l	d1,-(sp)			; store d1 data in the stack for now
    1167/    125A : (MACRO)              		fillVRAM	0,0,$10000		; clear the entirety of VRAM
    1167/    125A : 4BF9 00C0 0004                      lea     (vdp_control_port).l,a5
    1167/    1260 : 3ABC 8F01                           move.w  #$8F01,(a5) ; Set increment to 1, since DMA fill writes bytes
    1167/    1264 : 2ABC 94FF 93FF                      move.l  #$94000000+(((($10000)-(0)-1)&$FF00)<<8)+$9300+((($10000)-(0)-1)&$FF),(a5)
    1167/    126A : 3ABC 9780                           move.w  #$9780,(a5)
    1167/    126E : 2ABC 4000 0080                      move.l  #$40000080+(((0)&$3FFF)<<16)+(((0)&$C000)>>14),(a5)
    1167/    1274 : 33FC 0000 00C0                      move.w  #(0)|(0)<<8,(vdp_data_port).l
             127A : 0000             
    1167/    127C : 3215                .wait:          move.w  (a5),d1
    1167/    127E : 0801 0001                           btst    #1,d1
    1167/    1282 : 66F8                                bne.s   .wait
    1167/    1284 : 3ABC 8F02                           move.w  #$8F02,(a5) ; Set increment back to 2, since the VDP usually operates on words
    1168/    1288 : 221F                		move.l	(sp)+,d1			; reload d1 data back out of the stack
    1169/    128A : 4E75                		rts					; return
    1170/    128C :                     ; End of function VDPSetupGame
    1171/    128C :                     
    1172/    128C :                     ; ---------------------------------------------------------------------------
    1173/    128C :                     ; VDP register settings to use for the game. Do note that a handful of these
    1174/    128C :                     ; are getting rewritten for every game mode change, though the majority
    1175/    128C :                     ; will stay at their initial settings defined in this array.
    1176/    128C :                     ; ---------------------------------------------------------------------------
    1177/    128C :                     ; See here for details on VDP registers:
    1178/    128C :                     ; https://segaretro.org/Sega_Mega_Drive/VDP_registers
    1179/    128C :                     ; ---------------------------------------------------------------------------
    1180/    128C :                     
    1181/    128C :                     VDPSetupArray:
    1182/    128C : 8004                		dc.w $8000|%00000100			; 8-color mode
    1183/    128E : 8134                		dc.w $8100|%00110100			; vertical interrupts, DMA, Mega Drive display
    1184/    1290 : 8230                		dc.w $8200|(vram_fg>>10)		; foreground nametable address
    1185/    1292 : 8328                		dc.w $8300|($A000>>10)			; window nametable address
    1186/    1294 : 8407                		dc.w $8400|(vram_bg>>13)		; background nametable address
    1187/    1296 : 857C                		dc.w $8500|(vram_sprites>>9)		; sprite table address
    1188/    1298 : 8600                		dc.w $8600				; (unused, only relevant for 128KB VRAM mode)
    1189/    129A : 8700                		dc.w $8700|$00				; background colour (palette line 0, entry 0)
    1190/    129C : 8800                		dc.w $8800				; (unused, only relevant for Master System)
    1191/    129E : 8900                		dc.w $8900				; (unused, only relevant for Master System)
    1192/    12A0 : 8A00                		dc.w $8A00|$00				; horizontal interrupt register
    1193/    12A2 : 8B00                		dc.w $8B00|%00000000			; full-screen vertical scrolling
    1194/    12A4 : 8C81                		dc.w $8C00|%10000001			; 40-cell display mode
    1195/    12A6 : 8D3F                		dc.w $8D00|(vram_hscroll>>10)		; background H-scroll address
    1196/    12A8 : 8E00                		dc.w $8E00				; (unused, only relevant for 128KB VRAM mode)
    1197/    12AA : 8F02                		dc.w $8F00|$02				; VDP auto-increment size (2)
    1198/    12AC : 9001                		dc.w $9000|%00000001			; 64-cell H-scroll size
    1199/    12AE : 9100                		dc.w $9100				; window horizontal position
    1200/    12B0 : 9200                		dc.w $9200				; window vertical position
    1201/    12B2 :                     VDPSetupArray_End:
    1202/    12B2 :                     
    1203/    12B2 :                     
    1204/    12B2 :                     ; ===========================================================================
    1205/    12B2 :                     ; ---------------------------------------------------------------------------
    1206/    12B2 :                     ; Subroutine to clear the screen (plane mappings, sprites, and scroll data)
    1207/    12B2 :                     ; ---------------------------------------------------------------------------
    1208/    12B2 :                     
    1209/    12B2 :                     		include	"_inc/DMA-Queue.asm"
(1)    1/    12B2 :                     ; ---------------------------------------------------------------------------
(1)    2/    12B2 :                     ; MACRO ResetDMAQueue
(1)    3/    12B2 :                     ; Clears the DMA queue, discarding all previously-queued DMAs.
(1)    4/    12B2 :                     ; ---------------------------------------------------------------------------
(1)    5/    12B2 :                     ; ROUTINE Process_DMA_Queue / ProcessDMAQueue
(1)    6/    12B2 :                     ; Performs all queued DMA transfers and clears the DMA queue.
(1)    7/    12B2 :                     ;
(1)    8/    12B2 :                     ; Output:
(1)    9/    12B2 :                     ; 	a1,a5	trashed
(1)   10/    12B2 :                     ; ---------------------------------------------------------------------------
(1)   11/    12B2 :                     ; ROUTINE InitDMAQueue
(1)   12/    12B2 :                     ; Pre-initializes the DMA queue with VDP register numbers in alternating bytes.
(1)   13/    12B2 :                     ; Must be called before the queue is used, and the queue expects that only it
(1)   14/    12B2 :                     ; write to this region of RAM.
(1)   15/    12B2 :                     ;
(1)   16/    12B2 :                     ; Output:
(1)   17/    12B2 :                     ; 	a0,d0,d1	trashed
(1)   18/    12B2 :                     ; ---------------------------------------------------------------------------
(1)   19/    12B2 :                     ; ROUTINE Add_To_DMA_Queue / QueueDMATransfer
(1)   20/    12B2 :                     ; Queues a DMA with parameters given in registers.
(1)   21/    12B2 :                     ;
(1)   22/    12B2 :                     ; Options:
(1)   23/    12B2 :                     ; 	AssumeSourceAddressInBytes (default 1)
(1)   24/    12B2 :                     ; 	AssumeSourceAddressIsRAMSafe (default 0)
(1)   25/    12B2 :                     ; 	UseRAMSourceSafeDMA (default 1&(AssumeSourceAddressIsRAMSafe==0))
(1)   26/    12B2 :                     ; 	Use128kbSafeDMA (default 0)
(1)   27/    12B2 :                     ; 	UseVIntSafeDMA (default 0)
(1)   28/    12B2 :                     ; Input:
(1)   29/    12B2 :                     ; 	d1	Source address (in bytes, or in words if AssumeSourceAddressInBytes is
(1)   30/    12B2 :                     ; 		set to 0)
(1)   31/    12B2 :                     ; 	d2	Destination address
(1)   32/    12B2 :                     ; 	d3	Transfer length (in words)
(1)   33/    12B2 :                     ; Output:
(1)   34/    12B2 :                     ; 	d0,d1,d2,d3,a1	trashed
(1)   35/    12B2 :                     ;
(1)   36/    12B2 :                     ; With the default settings, runs in:
(1)   37/    12B2 :                     ; * 48(11/0) cycles if queue is full (DMA discarded)
(1)   38/    12B2 :                     ; * 184(29/9) cycles otherwise (DMA queued)
(1)   39/    12B2 :                     ;
(1)   40/    12B2 :                     ; With Use128kbSafeDMA = 1, runs in:
(1)   41/    12B2 :                     ; * 48(11/0) cycles if queue is full at the start (DMA discarded)
(1)   42/    12B2 :                     ; * 200(32/9) cycles if the DMA does not cross a 128kB boundary (DMA queued)
(1)   43/    12B2 :                     ; * 226(38/9) cycles if the DMA crosses a 128kB boundary, and the first piece
(1)   44/    12B2 :                     ;   fills the queue (second piece is discarded)
(1)   45/    12B2 :                     ; * 338(56/17) cycles if the DMA crosses a 128kB boundary, and the queue has
(1)   46/    12B2 :                     ;   space for both pieces (both pieces queued)
(1)   47/    12B2 :                     ;
(1)   48/    12B2 :                     ; Setting UseVIntSafeDMA to 1 adds 46(6/1) cycles to all times.
(1)   49/    12B2 :                     ;
(1)   50/    12B2 :                     ; Setting AssumeSourceAddressInBytes to 0 reduces all times by 10(1/0) cycles,
(1)   51/    12B2 :                     ; but only if the DMA is not entirely discarded. However, all callers must be
(1)   52/    12B2 :                     ; edited to make sure the adresss given is in the correct form; you can use
(1)   53/    12B2 :                     ; the dmaSource function for that, which also sanitizes RAM addresses.
(1)   54/    12B2 :                     ;
(1)   55/    12B2 :                     ; Setting AssumeSourceAddressIsRAMSafe to 1, or UseRAMSourceSafeDMA to 0,
(1)   56/    12B2 :                     ; reduces all times by 14(2/0) cycles, but only if the DMA is not entirely
(1)   57/    12B2 :                     ; discarded. However, all callers must be edited to make sure the adresss given
(1)   58/    12B2 :                     ; in the correct form.
(1)   59/    12B2 :                     ; ---------------------------------------------------------------------------
(1)   60/    12B2 :                     ; MACRO QueueStaticDMA
(1)   61/    12B2 :                     ; Directly queues a DMA on the spot. Requires all parameters to be known at
(1)   62/    12B2 :                     ; assembly time; that is, no registers. Gives assembly errors when the DMA
(1)   63/    12B2 :                     ; crosses a 128kB boundary, is at an odd ROM location, or is zero length.
(1)   64/    12B2 :                     ;
(1)   65/    12B2 :                     ; The destination parameter can be either:
(1)   66/    12B2 :                     ; * a VRAM address literal;
(1)   67/    12B2 :                     ; * a register initialized with `move.l	#vdpComm(dest,VRAM,DMA)`
(1)   68/    12B2 :                     ; * a register initialized with `vdpCommReg <reg>,VRAM,DMA`
(1)   69/    12B2 :                     ;
(1)   70/    12B2 :                     ; Options:
(1)   71/    12B2 :                     ; 	UseVIntSafeDMA (default 0)
(1)   72/    12B2 :                     ; Input:
(1)   73/    12B2 :                     ; 	Source address (in bytes), transfer length (in bytes), destination address
(1)   74/    12B2 :                     ; Output:
(1)   75/    12B2 :                     ; 	d0,a1	trashed; avoid using these for passing destination as a register
(1)   76/    12B2 :                     ;
(1)   77/    12B2 :                     ; With the default settings, runs in:
(1)   78/    12B2 :                     ; * 32(7/0) cycles if queue is full (DMA discarded)
(1)   79/    12B2 :                     ; * 122(21/8) cycles otherwise (DMA queued)
(1)   80/    12B2 :                     ; Passing a register as destination is faster by 8(2/0) when the DMA is queued,
(1)   81/    12B2 :                     ; but requires initializing the register elsewhere, which is probably slower.
(1)   82/    12B2 :                     ;
(1)   83/    12B2 :                     ; Setting UseVIntSafeDMA to 1 adds 46(6/1) cycles to both cases.
(1)   84/    12B2 :                     ; ===========================================================================
(1)   85/    12B2 :                     ; option: AssumeSourceAddressInBytes
(1)   86/    12B2 :                     ;
(1)   87/    12B2 :                     ; This option makes the function work as a drop-in replacement of the original
(1)   88/    12B2 :                     ; functions. If you modify all callers to supply a position in words instead of
(1)   89/    12B2 :                     ; bytes (i.e., divide source address by 2) you can set this to 0 to gain 10(1/0)
(1)   90/    12B2 : =$1                  AssumeSourceAddressInBytes = 1
(1)   91/    12B2 :                     ; ===========================================================================
(1)   92/    12B2 :                     ; option: AssumeSourceAddressIsRAMSafe
(1)   93/    12B2 :                     ;
(1)   94/    12B2 :                     ; This option (which is disabled by default) makes the DMA queue assume that the
(1)   95/    12B2 :                     ; source address is given to the function in a way that makes them safe to use
(1)   96/    12B2 :                     ; with RAM sources. You need to edit all callers to ensure this.
(1)   97/    12B2 :                     ; Enabling this option turns off UseRAMSourceSafeDMA, and saves 14(2/0).
(1)   98/    12B2 : =$0                  AssumeSourceAddressIsRAMSafe = 0
(1)   99/    12B2 :                     ; ===========================================================================
(1)  100/    12B2 :                     ; option: UseRAMSourceSafeDMA
(1)  101/    12B2 :                     ;
(1)  102/    12B2 :                     ; This option (which is enabled by default) makes source addresses in RAM safe
(1)  103/    12B2 :                     ; at the cost of 14(2/0). If you modify all callers so as to clear the top byte
(1)  104/    12B2 :                     ; of source addresses (i.e., by ANDing them with $FFFFFF).
(1)  105/    12B2 : =$1                  UseRAMSourceSafeDMA = 1&(AssumeSourceAddressIsRAMSafe==0)
(1)  106/    12B2 :                     ; ===========================================================================
(1)  107/    12B2 :                     ; option: Use128kbSafeDMA
(1)  108/    12B2 :                     ;
(1)  109/    12B2 :                     ; This option breaks DMA transfers that crosses a 128kB block into two. It is
(1)  110/    12B2 :                     ; disabled by default because you can simply align the art in ROM and avoid the
(1)  111/    12B2 :                     ; issue altogether. It is here so that you have a high-performance routine to do
(1)  112/    12B2 :                     ; the job in situations where you can't align it in ROM.
(1)  113/    12B2 : =$1                  Use128kbSafeDMA = 1
(1)  114/    12B2 :                     ; ===========================================================================
(1)  115/    12B2 :                     ; option UseVIntSafeDMA
(1)  116/    12B2 :                     ;
(1)  117/    12B2 :                     ; Option to mask interrupts while updating the DMA queue. This fixes many race
(1)  118/    12B2 :                     ; conditions in the DMA funcion, but it costs 46(6/1) cycles. The better way to
(1)  119/    12B2 :                     ; handle these race conditions would be to make unsafe callers (such as S3&K's
(1)  120/    12B2 :                     ; KosM decoder) prevent these by masking off interrupts before calling and then
(1)  121/    12B2 :                     ; restore interrupts after.
(1)  122/    12B2 : =$0                  UseVIntSafeDMA = 0
(1)  123/    12B2 :                     ; ===========================================================================
(1)  124/    12B2 :                     ; Convenience macros, for increased maintainability of the code.
(1)  126/    12B2 : =$27                 		equ	DMA,%100111
(1)  129/    12B2 : =$21                 		equ	VRAM,%100001
(1)  132/    12B2 :                     ; Like vdpComm, but starting from an address contained in a register
(1)  133/    12B2 : =$1                  vdpCommReg_defined = 1
(1)  134/    12B2 :                     vdpCommReg macro reg,type,rwd,clr
(1)  135/    12B2 :                     	lsl.l	#2,reg							; Move high bits into (word-swapped) position, accidentally moving everything else
(1)  136/    12B2 :                     	set .upperbits,(type&rwd)&3
(1)  137/    12B2 :                     	if .upperbits<>0
(1)  138/    12B2 :                     		addq.w	#.upperbits,reg				; Add upper access type bits
(1)  139/    12B2 :                     	endif
(1)  140/    12B2 :                     	ror.w	#2,reg							; Put upper access type bits into place, also moving all other bits into their correct (word-swapped) places
(1)  141/    12B2 :                     	swap	reg								; Put all bits in proper places
(1)  142/    12B2 :                     	if clr <> 0
(1)  143/    12B2 :                     		andi.w	#3,reg						; Strip whatever junk was in upper word of reg
(1)  144/    12B2 :                     	endif
(1)  145/    12B2 :                     	set .lowerbits,(type&rwd)&$FC
(1)  146/    12B2 :                     	if .lowerbits==$20
(1)  147/    12B2 :                     		tas.b	reg							; Add in the DMA flag -- tas fails on memory, but works on registers
(1)  148/    12B2 :                     	elseif .lowerbits<>0
(1)  149/    12B2 :                     		ori.w	#(.lowerbits<<2),reg		; Add in missing access type bits
(1)  150/    12B2 :                     	endif
(1)  151/    12B2 :                     	endm
(1)  153/    12B2 :                     ; ---------------------------------------------------------------------------
(1)  155/    12B2 : =$1                  intMacros_defined = 1
(1)  156/    12B2 :                     enableInts macro
(1)  157/    12B2 :                     	move	#$2300,sr
(1)  158/    12B2 :                     	endm
(1)  159/    12B2 :                     
(1)  160/    12B2 :                     disableInts macro
(1)  161/    12B2 :                     	move	#$2700,sr
(1)  162/    12B2 :                     	endm
(1)  164/    12B2 :                     ; ---------------------------------------------------------------------------
(1)  166/    12B2 : =$1                  DMAEntry_defined = 1
(1)  167/       0 :                     DMAEntry STRUCT DOTS
(1)  168/       0 : (MACRO)              Reg94:		ds.b	1
(1)  168/       0 :                                     !ds.b 1
(1)  169/       1 :                     Size:
(1)  170/       1 : (MACRO)              SizeH:		ds.b	1
(1)  170/       1 :                                     !ds.b 1
(1)  171/       2 : (MACRO)              Reg93:		ds.b	1
(1)  171/       2 :                                     !ds.b 1
(1)  172/       3 :                     Source:
(1)  173/       3 : (MACRO)              SizeL:		ds.b	1
(1)  173/       3 :                                     !ds.b 1
(1)  174/       4 : (MACRO)              Reg97:		ds.b	1
(1)  174/       4 :                                     !ds.b 1
(1)  175/       5 : (MACRO)              SrcH:		ds.b	1
(1)  175/       5 :                                     !ds.b 1
(1)  176/       6 : (MACRO)              Reg96:		ds.b	1
(1)  176/       6 :                                     !ds.b 1
(1)  177/       7 : (MACRO)              SrcM:		ds.b	1
(1)  177/       7 :                                     !ds.b 1
(1)  178/       8 : (MACRO)              Reg95:		ds.b	1
(1)  178/       8 :                                     !ds.b 1
(1)  179/       9 : (MACRO)              SrcL:		ds.b	1
(1)  179/       9 :                                     !ds.b 1
(1)  180/       A : (MACRO)              Command:	ds.l	1
(1)  180/       A :                                     !ds.l 1
(1)  181/    12B2 : =$E                  DMAEntry	ENDSTRUCT
(1)  183/    12B2 :                     ; ---------------------------------------------------------------------------
(1)  184/    12B2 : =$12                 QueueSlotCount = (VDP_Command_Buffer_Slot-VDP_Command_Buffer)/DMAEntry.len
(1)  185/    12B2 :                     ; ---------------------------------------------------------------------------
(1)  187/    12B2 : =$1                  		equ	DMAfunctions_defined,1
(1)  188/    12B2 :                     dmaSource function addr,((addr>>1)&$7FFFFF)
(1)  189/    12B2 :                     dmaLength function len,((len>>1)&$7FFF)
(1)  191/    12B2 :                     ; ---------------------------------------------------------------------------
