    3388/    40CE : 5338 FEC0           		subq.b	#1,(v_ani0_time).w		; has first timer reached 0?
    3389/    40D2 : 6A10                		bpl.s	Sync2				; if not, branch
    3390/    40D4 : 11FC 000B FEC0      		move.b	#12-1,(v_ani0_time).w		; reset first timer to 12 frames
    3391/    40DA : 5338 FEC1           		subq.b	#1,(v_ani0_frame).w		; go to next frame (backwards)
    3392/    40DE : 0238 0007 FEC1      		andi.b	#7,(v_ani0_frame).w 		; limit to frames 0-7
    3393/    40E4 :                     
    3394/    40E4 :                     ; Used for rings
    3395/    40E4 :                     Sync2:
    3396/    40E4 : 5338 FEC2           		subq.b	#1,(v_ani1_time).w
    3397/    40E8 : 6A10                		bpl.s	Sync3
