    3505/    494A :                     ; ===========================================================================
    3506/    494A :                     ; ---------------------------------------------------------------------------
    3507/    494A :                     ; Ending sequence in Green Hill Zone. This is essentially a stripped-down
    3508/    494A :                     ; copy-paste of regular levels with lots of hardcoding.
    3509/    494A :                     ; ---------------------------------------------------------------------------
    3510/    494A :                     
    3511/    494A :                     ; EndingSequence:
    3512/    494A :                     GM_Ending:
    3513/    494A :                     		; fading out from previous game mode
    3514/    494A : 103C 00FE           		move.b	#bgm_Stop,d0			; set stop music command
    3515/    494E : 6100 CD3A           		bsr.w	QueueSound2			; stop music
    3516/    4952 : 6100 D26E           		bsr.w	PaletteFadeOut			; fade-out previous game mode
    3517/    4956 :                     ; ---------------------------------------------------------------------------
    3518/    4956 :                     
    3519/    4956 :                     		; screen setup and loading patterns
    3520/    4956 : (MACRO)              		clearRAM v_objspace			; clear object RAM
    3520/    4956 : =$2000                               .length: := v_objspace_end-v_objspace
    3520/    4956 : 43F8 D000                           lea     (v_objspace).w,a1
    3520/    495A : 7000                                moveq   #0,d0
    3520/    495C : 323C 07FF                           move.w  #.length/4-1,d1
    3520/    4960 :                     
    3520/    4960 :                     .loop:
    3520/    4960 : 22C0                                move.l  d0,(a1)+
    3520/    4962 : 51C9 FFFC                           dbf     d1,.loop
    3520/    4966 :                     
    3520/    4966 :                     
    3521/    4966 : (MACRO)              		clearRAM v_misc_variables		; clear various miscellaneous RAM
    3521/    4966 : =$58                                 .length: := v_misc_variables_end-v_misc_variables
    3521/    4966 : 43F8 F628                           lea     (v_misc_variables).w,a1
    3521/    496A : 7000                                moveq   #0,d0
    3521/    496C : 323C 0015                           move.w  #.length/4-1,d1
    3521/    4970 :                     
    3521/    4970 :                     .loop:
    3521/    4970 : 22C0                                move.l  d0,(a1)+
    3521/    4972 : 51C9 FFFC                           dbf     d1,.loop
    3521/    4976 :                     
    3521/    4976 :                     
    3522/    4976 : (MACRO)              		clearRAM v_levelvariables		; clear level variables RAM (camera position, etc.)
    3522/    4976 : =$100                                .length: := v_levelvariables_end-v_levelvariables
    3522/    4976 : 43F8 F700                           lea     (v_levelvariables).w,a1
    3522/    497A : 7000                                moveq   #0,d0
    3522/    497C : 323C 003F                           move.w  #.length/4-1,d1
    3522/    4980 :                     
    3522/    4980 :                     .loop:
    3522/    4980 : 22C0                                move.l  d0,(a1)+
    3522/    4982 : 51C9 FFFC                           dbf     d1,.loop
    3522/    4986 :                     
    3522/    4986 :                     
    3523/    4986 : (MACRO)              		clearRAM v_timingandscreenvariables	; clear various timing and screen RAM (for animated tiles, etc.)
    3523/    4986 : =$120                                .length: := v_timingandscreenvariables_end-v_timingandscreenvariables
    3523/    4986 : 43F8 FE60                           lea     (v_timingandscreenvariables).w,a1
    3523/    498A : 7000                                moveq   #0,d0
    3523/    498C : 323C 0047                           move.w  #.length/4-1,d1
    3523/    4990 :                     
    3523/    4990 :                     .loop:
    3523/    4990 : 22C0                                move.l  d0,(a1)+
