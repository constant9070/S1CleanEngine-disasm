(1)    3/    C4CA :                     ; Solid	object subroutine (includes spikes, blocks, rocks etc)
(1)    4/    C4CA :                     ;
(1)    5/    C4CA :                     ; input:
(1)    6/    C4CA :                     ;	d1.w = object half width
(1)    7/    C4CA :                     ;	d2.w = object half height (initial collision)
(1)    8/    C4CA :                     ;	d3.w = object half height (when stood on object)
(1)    9/    C4CA :                     ;	d4.w = object x position (when stood on object)
(1)   10/    C4CA :                     ;
(1)   11/    C4CA :                     ; output:
(1)   12/    C4CA :                     ;	d3.w = y distance of Sonic from nearest top/bottom edge (-ve if on bottom)
(1)   13/    C4CA :                     ;	d4.l = collision type: 0 = none/no change; 1 = side collision; -1 = top/bottom collision
(1)   14/    C4CA :                     ;	d5.w = x distance of Sonic from nearest left/right edge
(1)   15/    C4CA :                     ;	a1 = address of OST of Sonic
