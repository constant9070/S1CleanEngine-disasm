(1)  815/    6280 : E94C                		lsl.w	#4,d4					; multiply Y by 16 (multiples of $100)
(1)  816/    6282 : E44D                		lsr.w	#2,d5					; divide X by 4 (multiples of 4)
(1)  817/    6284 : D845                		add.w	d5,d4					; fuse X to Y
(1)  818/    6286 : 7003                		moveq	#3,d0					; prepare VDP setting $C000+ address
(1)  819/    6288 : 4840                		swap	d0					; send to upper word
(1)  820/    628A : 3004                		move.w	d4,d0					; load calculated plane position
(1)  821/    628C : 4E75                		rts						; return (d0 contains VDP control port address)
