(1)    2/    FC56 :                     ; ---------------------------------------------------------------------------
(1)    3/    FC56 :                     ; Unused/dead subroutine that was likely used during development.
(1)    4/    FC56 :                     
(1)    5/    FC56 :                     ; This subroutine takes 'raw' bitmap-like collision block data as input and
(1)    6/    FC56 :                     ; converts it into the proper collision arrays (ColArray and ColArray2).
(1)    7/    FC56 :                     ; Pointers to said raw data are dummied out.
(1)    8/    FC56 :                     ; Curiously, an example of the original 'raw' data that this was intended
(1)    9/    FC56 :                     ; to process can be found in the J2ME version, in a file called 'blkcol.bct'.
(1)   10/    FC56 :                     ; ---------------------------------------------------------------------------
(1)   11/    FC56 : =$3CC42              RawColBlocks		equ CollArray1
(1)   12/    FC56 : =$3CC42              ConvRowColBlocks	equ CollArray1
(1)   13/    FC56 :                     ; ---------------------------------------------------------------------------
(1)   14/    FC56 :                     
(1)   15/    FC56 :                     ConvertCollisionArray:
(1)   16/    FC56 : 4E75                		rts
(1)   17/    FC58 :                     ; ---------------------------------------------------------------------------
(1)   18/    FC58 :                     
(1)   19/    FC58 :                     		; The raw format stores the collision data column by column for the normal collision array.
(1)   20/    FC58 :                     		; This makes a copy of the data, but stored row by row, for the rotated collision array.
(1)   21/    FC58 : 43F9 0003 CC42      		lea	(RawColBlocks).l,a1	; Source location of raw collision block data
(1)   22/    FC5E : 45F9 0003 CC42      		lea	(ConvRowColBlocks).l,a2	; Destination location for row-converted collision block data
(1)   23/    FC64 : 363C 00FF           		move.w	#$100-1,d3		; Number of blocks in collision data
(1)   24/    FC68 :                     .blockLoop:
(1)   25/    FC68 : 7A10                		moveq	#16,d5			; Start on the 16th bit (the leftmost pixel)
(1)   26/    FC6A : 343C 000F           		move.w	#16-1,d2		; Width of a block in pixels
(1)   27/    FC6E :                     .columnLoop:
(1)   28/    FC6E : 7800                		moveq	#0,d4
(1)   29/    FC70 : 323C 000F           		move.w	#16-1,d1		; Height of a block in pixels
(1)   30/    FC74 :                     .rowLoop:
(1)   31/    FC74 : 3019                		move.w	(a1)+,d0		; Get row of collision bits
(1)   32/    FC76 : EAA8                		lsr.l	d5,d0			; Push the selected bit of this row into the 'eXtend' flag
(1)   33/    FC78 : D944                		addx.w	d4,d4			; Shift d4 to the left, and insert the selected bit into bit 0
(1)   34/    FC7A : 51C9 FFF8           		dbf	d1,.rowLoop		; Loop for each row of pixels in a block
(1)   35/    FC7E : 34C4                		move.w	d4,(a2)+		; Store column of collision bits
(1)   36/    FC80 : 92FC 0020           		suba.w	#2*16,a1		; Back to the start of the block
(1)   37/    FC84 : 5345                		subq.w	#1,d5			; Get next bit in the row
(1)   38/    FC86 : 51CA FFE6           		dbf	d2,.columnLoop		; Loop for each column of pixels in a block
(1)   39/    FC8A : D2FC 0020           		adda.w	#2*16,a1		; Next block
(1)   40/    FC8E : 51CB FFD8           		dbf	d3,.blockLoop		; Loop for each block in the raw collision block data
(1)   41/    FC92 :                     		; This then converts the collision data into the final collision arrays
(1)   42/    FC92 : 43F9 0003 CC42      		lea	(ConvRowColBlocks).l,a1
(1)   43/    FC98 : 45F9 0003 DC42      		lea	(CollArray2).l,a2	; Convert the row-converted collision block data into final rotated collision array
(1)   44/    FC9E : 610C                		bsr.s	.convertArray
(1)   45/    FCA0 : 43F9 0003 CC42      		lea	(RawColBlocks).l,a1
(1)   46/    FCA6 : 45F9 0003 CC42      		lea	(CollArray1).l,a2	; Convert the raw collision block data into final normal collision array
(1)   47/    FCAC :                     .convertArray:
(1)   48/    FCAC : 363C 0FFF           		move.w	#$1000-1,d3		; Size of the collision array
(1)   49/    FCB0 :                     .processLoop:
(1)   50/    FCB0 : 7400                		moveq	#0,d2
(1)   51/    FCB2 : 323C 000F           		move.w	#$F,d1
(1)   52/    FCB6 : 3019                		move.w	(a1)+,d0		; Get current column of collision pixels
(1)   53/    FCB8 : 6724                		beq.s	.noCollision		; Branch if there's no collision in this column
(1)   54/    FCBA : 6B0C                		bmi.s	.topPixelSolid		; Branch if top pixel of collision is solid
(1)   55/    FCBC :                     		; Here we count, starting from the bottom, how many pixels tall
(1)   56/    FCBC :                     		; the collision in this column is.
(1)   57/    FCBC :                     .processColumnLoop1:
(1)   58/    FCBC : E248                		lsr.w	#1,d0
(1)   59/    FCBE : 6402                		bhs.s	.pixelNotSolid1
(1)   60/    FCC0 : 5202                		addq.b	#1,d2
(1)   61/    FCC2 :                     .pixelNotSolid1:
(1)   62/    FCC2 : 51C9 FFF8           		dbf	d1,.processColumnLoop1
(1)   63/    FCC6 : 6018                		bra.s	.columnProcessed
(1)   64/    FCC8 :                     ; ---------------------------------------------------------------------------
(1)   65/    FCC8 :                     
(1)   66/    FCC8 :                     .topPixelSolid:
(1)   67/    FCC8 : 0C40 FFFF           		cmpi.w	#$FFFF,d0		; Is entire column solid?
(1)   68/    FCCC : 670C                		beq.s	.entireColumnSolid	; Branch if so
(1)   69/    FCCE :                     		; Here we count, starting from the top, how many pixels tall
