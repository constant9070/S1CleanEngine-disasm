(1)  495/   54E72 : =$54E72              TTLCard_SSR_Chaos:      label *
(1)  495/   54E72 :                     
(1)  495/   54E72 :                                     ; length check
(1)  495/   54E72 : =$E                                  set len, strlen(TitleCard_ChaosEmeralds)
(1)  495/   54E72 :                     
(1)  495/   54E72 :                                     ; calculate sprite count and width
(1)  495/   54E72 : =$0                                  set useSmallSpaces, 0
(1)  495/   54E72 : =$0                                  set sizeX, $00
(1)  495/   54E72 : =$0                                  set spaces, 0
(1)  495/   54E72 : =$0                                  set i, 0
(1)  495/   54E72 :                                     while (i<len)
(1)  495/   54E72 :                                             set char, substr(TitleCard_ChaosEmeralds,i,1)
(1)  495/   54E72 :                     
(1)  495/   54E72 :                                             set sizeX, sizeX+$10
(1)  495/   54E72 :                                             if (char=' ')
(1)  495/   54E72 :                                                     if (useSmallSpaces)
(1)  495/   54E72 :                                                             set sizeX, sizeX-$08 ; small spaces are 8px smaller
(1)  495/   54E72 :                                                     endif
(1)  495/   54E72 :                                                     set spaces, spaces+1
(1)  495/   54E72 :                                             elseif (char='I')
(1)  495/   54E72 :                                                     set sizeX, sizeX-8
(1)  495/   54E72 :                                             elseif (char>='a')&(char<='z')
(1)  495/   54E72 :                                                     if (char='i')|(char='j')|(char='l')
(1)  495/   54E72 :                                                             set sizeX, sizeX-7
(1)  495/   54E72 :                                                     else
(1)  495/   54E72 :                                                             set sizeX, sizeX-2
(1)  495/   54E72 :                                                     endif
(1)  495/   54E72 :                                             endif
(1)  495/   54E72 :                                             set i, i+1
(1)  495/   54E72 :                     
(1)  495/   54E72 :                                             if ((sizeX>$FF)&(useSmallSpaces<>1))
(1)  495/   54E72 :                                                     set useSmallSpaces, 1
(1)  495/   54E72 :                                                     set sizeX, $00
(1)  495/   54E72 :                                                     set spaces, 0
(1)  495/   54E72 :                                                     set i, 0
(1)  495/   54E72 :                                                     ; retry with small spaces
(1)  495/   54E72 :                                             endif
(1)  495/   54E72 :                                     endm
