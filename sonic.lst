    1173/    10E4 :                     ; Subroutine to setup the VDP with values used for the game itself
    1174/    10E4 :                     ; ---------------------------------------------------------------------------
    1175/    10E4 :                     
    1176/    10E4 :                     VDPSetupGame:
    1177/    10E4 : 41F9 00C0 0004      		lea	(vdp_control_port).l,a0		; load VDP control port
    1178/    10EA : 43F9 00C0 0000      		lea	(vdp_data_port).l,a1		; load VDP data port
    1179/    10F0 : 45F9 0000 1160      		lea	(VDPSetupArray).l,a2		; load address of register values
    1180/    10F6 : 7E12                		moveq	#(VDPSetupArray_End-VDPSetupArray)/2-1,d7 ; set repeat times
    1181/    10F8 :                     .setreg:
    1182/    10F8 : 309A                		move.w	(a2)+,(a0)			; save register value to VDP
    1183/    10FA : 51CF FFFC           		dbf	d7,.setreg			; repeat until all register values have been sent
    1184/    10FE :                     
    1185/    10FE : 3039 0000 1162      		move.w	(VDPSetupArray+2).l,d0		; get second entry of VDPSetupArray
    1186/    1104 : 31C0 F60C           		move.w	d0,(v_vdp_buffer1).w		; buffer register $81 (used for enabling/disabling display)
    1187/    1108 :                     
    1188/    1108 : 31FC 8ADF F624      		move.w	#$8A00+223,(v_hblank_hreg).w	; HBlank every 224th scanline
    1189/    110E :                     
    1190/    110E : 7000                		moveq	#cBlack,d0			; set d0 to 0 (black)
    1191/    1110 : 23FC C000 0000      		move.l	#$C0000000,(vdp_control_port).l	; set VDP to CRAM write
             1116 : 00C0 0004          
    1192/    111A : 3E3C 003F           		move.w	#($80)/2-1,d7			; set repeat times to cover full CRAM
    1193/    111E :                     .clrCRAM:
    1194/    111E : 3280                		move.w	d0,(a1)				; clear colours
    1195/    1120 : 51CF FFFC           		dbf	d7,.clrCRAM                     ; repeat until the entire palette is clear (black)
    1196/    1124 :                     
    1197/    1124 : 42B8 F616           		clr.l	(v_scrposy_vdp).w		; clear single vertical scroll buffer
    1198/    1128 : 42B8 F61A           		clr.l	(v_scrposx_vdp).w		; clear single horizontal scroll buffer
    1199/    112C : 2F01                		move.l	d1,-(sp)			; store d1 data in the stack for now
    1200/    112E : (MACRO)              		fillVRAM	0,0,$10000		; clear the entirety of VRAM
    1200/    112E : 4BF9 00C0 0004                      lea     (vdp_control_port).l,a5
    1200/    1134 : 3ABC 8F01                           move.w  #$8F01,(a5) ; Set increment to 1, since DMA fill writes bytes
    1200/    1138 : 2ABC 94FF 93FF                      move.l  #$94000000+(((($10000)-(0)-1)&$FF00)<<8)+$9300+((($10000)-(0)-1)&$FF),(a5)
    1200/    113E : 3ABC 9780                           move.w  #$9780,(a5)
    1200/    1142 : 2ABC 4000 0080                      move.l  #$40000080+(((0)&$3FFF)<<16)+(((0)&$C000)>>14),(a5)
    1200/    1148 : 33FC 0000 00C0                      move.w  #(0)|(0)<<8,(vdp_data_port).l
             114E : 0000             
    1200/    1150 : 3215                .wait:          move.w  (a5),d1
    1200/    1152 : 0801 0001                           btst    #1,d1
    1200/    1156 : 66F8                                bne.s   .wait
    1200/    1158 : 3ABC 8F02                           move.w  #$8F02,(a5) ; Set increment back to 2, since the VDP usually operates on words
    1201/    115C : 221F                		move.l	(sp)+,d1			; reload d1 data back out of the stack
    1202/    115E : 4E75                		rts					; return
    1203/    1160 :                     ; End of function VDPSetupGame
    1204/    1160 :                     
    1205/    1160 :                     ; ---------------------------------------------------------------------------
    1206/    1160 :                     ; VDP register settings to use for the game. Do note that a handful of these
    1207/    1160 :                     ; are getting rewritten for every game mode change, though the majority
    1208/    1160 :                     ; will stay at their initial settings defined in this array.
    1209/    1160 :                     ; ---------------------------------------------------------------------------
    1210/    1160 :                     ; See here for details on VDP registers:
    1211/    1160 :                     ; https://segaretro.org/Sega_Mega_Drive/VDP_registers
    1212/    1160 :                     ; ---------------------------------------------------------------------------
    1213/    1160 :                     
    1214/    1160 :                     VDPSetupArray:
    1215/    1160 : 8004                		dc.w $8000|%00000100			; 8-color mode
    1216/    1162 : 8134                		dc.w $8100|%00110100			; vertical interrupts, DMA, Mega Drive display
    1217/    1164 : 8230                		dc.w $8200|(vram_fg>>10)		; foreground nametable address
    1218/    1166 : 8328                		dc.w $8300|($A000>>10)			; window nametable address
    1219/    1168 : 8407                		dc.w $8400|(vram_bg>>13)		; background nametable address
    1220/    116A : 857C                		dc.w $8500|(vram_sprites>>9)		; sprite table address
    1221/    116C : 8600                		dc.w $8600				; (unused, only relevant for 128KB VRAM mode)
    1222/    116E : 8700                		dc.w $8700|$00				; background colour (palette line 0, entry 0)
    1223/    1170 : 8800                		dc.w $8800				; (unused, only relevant for Master System)
    1224/    1172 : 8900                		dc.w $8900				; (unused, only relevant for Master System)
    1225/    1174 : 8A00                		dc.w $8A00|$00				; horizontal interrupt register
    1226/    1176 : 8B00                		dc.w $8B00|%00000000			; full-screen vertical scrolling
    1227/    1178 : 8C81                		dc.w $8C00|%10000001			; 40-cell display mode
    1228/    117A : 8D3F                		dc.w $8D00|(vram_hscroll>>10)		; background H-scroll address
    1229/    117C : 8E00                		dc.w $8E00				; (unused, only relevant for 128KB VRAM mode)
    1230/    117E : 8F02                		dc.w $8F00|$02				; VDP auto-increment size (2)
    1231/    1180 : 9001                		dc.w $9000|%00000001			; 64-cell H-scroll size
    1232/    1182 : 9100                		dc.w $9100				; window horizontal position
    1233/    1184 : 9200                		dc.w $9200				; window vertical position
    1234/    1186 :                     VDPSetupArray_End:
