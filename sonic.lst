    4221/   135F6 :                     
    4222/   135F6 :                     	; Nem_SegaLogo has a bunch of padding before it that differs between revisions:
    4223/   135F6 :                     	; - in rev00, it starts at $1DC00, which amounts to $EE bytes
    4224/   135F6 :                     	; - in rev01/rev02, it starts at $1E700, which amounts to $48E bytes
    4225/   135F6 :                     	; From a technical standpoint, this padding serves no purpose.
    4227/   135F6 : (MACRO)              		align	$200
    4227/   135F6 :  (MACRO-2)                   cnop 0,$200
    4227/   135F6 :   (MACRO-3)                          org (*-1+($200)-((*-1+(-(0)))#($200)))
    4227/   13600 :                                             !org (*-1+($200)-((*-1+(-(0)))#($200)))
    4229/   13600 : (MACRO)              			dcb.b	$300,$FF
