    3433/    413C :                     
    3434/    413C :                     SignpostArtLoad:
    3435/    413C : 4A78 FE08           		tst.w	(v_debuguse).w			; is debug mode being used?
    3436/    4140 : 6600 0030           		bne.w	.return				; if yes, do not lock screen or load art
    3437/    4144 : 0C38 0002 FE11      		cmpi.b	#act3,(v_act).w			; is this a third act?
    3438/    414A : 6726                		beq.s	.return				; if yes, don't load art (due to the boss fight)
    3439/    414C :                     
    3440/    414C : 3038 F700           		move.w	(v_screenposx).w,d0		; get current X-camera position
    3441/    4150 : 3238 F72A           		move.w	(v_limitright2).w,d1		; get right level boundary
    3442/    4154 : 0441 0100           		subi.w	#$100,d1			; check for $100 pixels before the right boundary
    3443/    4158 : B041                		cmp.w	d1,d0				; has Sonic reached the right edge of the level?
    3444/    415A : 6D16                		blt.s	.return				; if not, branch
    3445/    415C :                     
