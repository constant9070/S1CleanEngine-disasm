(1)  160/    B822 :                     ; ===========================================================================
(1)  161/    B822 :                     ; ---------------------------------------------------------------------------
(1)  162/    B822 :                     ; Macro for all BuildSpr_Draw functions, to visualize the differences between them.
(1)  163/    B822 :                     ; All four variants work on the same basic principle, only coming with
(1)  164/    B822 :                     ; modifications for the flipping.
(1)  165/    B822 :                     ; 
(1)  166/    B822 :                     ; input:
(1)  167/    B822 :                     ;	d1 = number of sprite pieces in mapping minus 1
(1)  168/    B822 :                     ;	d2 = base Y-position
(1)  169/    B822 :                     ;	d3 = base X-position
(1)  170/    B822 :                     ;	d5 = total rendered sprites so far (max 80)
(1)  171/    B822 :                     ;	a1 = pointer to starting sprite piece in sprite mappings (see breakdown above)
(1)  172/    B822 :                     ;	a2 = pointer to sprite link buffer (v_spritetablebuffer)
(1)  173/    B822 :                     ;	a3 = art tile / VRAM setting (obGfx)
(1)  174/    B822 :                     ;
(1)  175/    B822 :                     ; 	uses d0.w, d4.w
(1)  176/    B822 :                     ;
(1)  177/    B822 :                     ; Each sprite piece is exactly 5 bytes. See here for a breakdown:
(1)  178/    B822 :                     ; https://info.sonicretro.org/SCHG:Sonic_the_Hedgehog_(16-bit)/Object_Editing#Mappings_editing
(1)  179/    B822 :                     ; ---------------------------------------------------------------------------
(1)  180/    B822 :                     
(1)  181/    B822 :                     buildsprite:	macro xflip,yflip
(1)  182/    B822 :                     
(1)  183/    B822 :                     .loopSpritePieces:
(1)  184/    B822 :                     	; --- Sprite limit check ---
(1)  185/    B822 :                     		cmpi.b	#sprites_max,d5			; check sprite limit
(1)  186/    B822 :                     		beq.s	.return				; if all sprite slots are taken up, abort process
(1)  187/    B822 :                     
(1)  188/    B822 :                     	; --- Y-position ---
(1)  189/    B822 :                     		move.b	(a1)+,d0			; get relative Y-offset
(1)  190/    B822 :                     		if yflip
(1)  191/    B822 :                     			move.b	(a1),d4			; get dimensions of sprite piece
(1)  192/    B822 :                     			ext.w	d0
(1)  193/    B822 :                     			neg.w	d0
(1)  194/    B822 :                     			lsl.b	#3,d4
(1)  195/    B822 :                     			andi.w	#%11000,d4
(1)  196/    B822 :                     			addq.w	#8,d4
(1)  197/    B822 :                     			sub.w	d4,d0			; d0 = flipped Y-position
(1)  198/    B822 :                     		else
(1)  199/    B822 :                     			ext.w	d0
(1)  200/    B822 :                     		endif
(1)  201/    B822 :                     		add.w	d2,d0				; add base Y-position
(1)  202/    B822 :                     		move.w	d0,(a2)+			; write Y-position to buffer
(1)  203/    B822 :                     
(1)  204/    B822 :                     	; --- Sprite width/height ---
(1)  205/    B822 :                     		if xflip
(1)  206/    B822 :                     			move.b	(a1)+,d4		; get dimensions of sprite piece (WWHH) (backup for later)
(1)  207/    B822 :                     			move.b	d4,(a2)+		; write sprite width to buffer
(1)  208/    B822 :                     		else
(1)  209/    B822 :                     			move.b	(a1)+,(a2)+		; write sprite width to buffer
(1)  210/    B822 :                     		endif
(1)  211/    B822 :                     
(1)  212/    B822 :                     	; --- Sprite link ---
(1)  213/    B822 :                     		addq.b	#1,d5				; increase total sprites counter
(1)  214/    B822 :                     		move.b	d5,(a2)+			; write sprite link to buffer
(1)  215/    B822 :                     
(1)  216/    B822 :                     	; --- VRAM settings / art tile / flipping ---
(1)  217/    B822 :                     		move.b	(a1)+,d0			; get first half of VRAM settings
(1)  218/    B822 :                     		lsl.w	#8,d0
(1)  219/    B822 :                     		move.b	(a1)+,d0			; get second half of VRAM settings
(1)  220/    B822 :                     		add.w	a3,d0				; add base art tile offset of object
(1)  221/    B822 :                     		if xflip|yflip
(1)  222/    B822 :                     			eori.w	#xflip<<11|yflip<<12,d0	; toggle X-flip ($800) and/or Y-flip ($1000) in VDP
(1)  223/    B822 :                     		endif
(1)  224/    B822 :                     		move.w	d0,(a2)+			; write VRAM settings to buffer
(1)  225/    B822 :                     
(1)  226/    B822 :                     	; --- X-position ---
(1)  227/    B822 :                     		move.b	(a1)+,d0			; get relative X-offset
(1)  228/    B822 :                     		ext.w	d0
(1)  229/    B822 :                     		if xflip
(1)  230/    B822 :                     			neg.w	d0
(1)  231/    B822 :                     			add.b	d4,d4
(1)  232/    B822 :                     			andi.w	#%11000,d4
(1)  233/    B822 :                     			addq.w	#8,d4
(1)  234/    B822 :                     			sub.w	d4,d0			; d0 = flipped X-position
(1)  235/    B822 :                     		endif
(1)  236/    B822 :                     		add.w	d3,d0				; add X-position
(1)  237/    B822 :                     		andi.w	#$1FF,d0			; keep within 512px (screen wrap)
(1)  238/    B822 :                     		bne.s	.x				; if non-zero, branch
(1)  239/    B822 :                     		addq.w	#1,d0				; force zero X-position to non-zero (avoid unwanted sprite masking)
(1)  240/    B822 :                     	.x:	move.w	d0,(a2)+			; write X-position to buffer
(1)  241/    B822 :                     
(1)  242/    B822 :                     	; --- Loop for all pieces in mapping ---
(1)  243/    B822 :                     		dbf	d1,.loopSpritePieces
