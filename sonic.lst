(1)    1/    2D48 :                     ; ===========================================================================
(1)    2/    2D48 :                     ; ---------------------------------------------------------------------------
(1)    3/    2D48 :                     ; Subroutine calculate an arctangent of two input coordinates (i.e. the angle)
(1)    4/    2D48 :                     ; 
(1)    5/    2D48 :                     ; input:
(1)    6/    2D48 :                     ;	d1 = x-axis distance
(1)    7/    2D48 :                     ;	d2 = y-axis distance
(1)    8/    2D48 :                     ; 
(1)    9/    2D48 :                     ; output:
(1)   10/    2D48 :                     ;	d0 = angle
(1)   11/    2D48 :                     ; ---------------------------------------------------------------------------
(1)   12/    2D48 :                     
(1)   13/    2D48 :                     CalcAngle:
(1)   14/    2D48 : 48E7 1800           		movem.l	d3-d4,-(sp)				; store register data
(1)   15/    2D4C : 7600                		moveq	#0,d3					; clear registers
(1)   16/    2D4E : 7800                		moveq	#0,d4					; ''
(1)   17/    2D50 : 3601                		move.w	d1,d3					; copy X and Y distances
(1)   18/    2D52 : 3802                		move.w	d2,d4					; ''
(1)   19/    2D54 : 8843                		or.w	d3,d4					; fuse X and Y together
