(1)  864/    676E : E94C                		lsl.w	#4,d4					; multiply Y by 16 (multiples of $100)
(1)  865/    6770 : E44D                		lsr.w	#2,d5					; divide X by 4 (multiples of 4)
(1)  866/    6772 : D845                		add.w	d5,d4					; fuse X to Y
(1)  867/    6774 : 7002                		moveq	#2,d0					; prepare VDP setting $8000+ address
(1)  868/    6776 : 4840                		swap	d0					; send to upper word
(1)  869/    6778 : 3004                		move.w	d4,d0					; load calculated plane position
(1)  870/    677A : 4E75                		rts						; return (d0 contains VDP control port address)
