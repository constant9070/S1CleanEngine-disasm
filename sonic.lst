    2995/    3A98 :                     		; Check if *every* title card element has reached their target position.
    2996/    3A98 :                     		; Decompression is normally slow enough that every element is able
    2997/    3A98 :                     		; to reach their target position before it's finished, but if
    2998/    3A98 :                     		; decompression is upgraded with something faster, then the risk
    2999/    3A98 :                     		; of decompression finishing and exiting this loop before all of the title
    3000/    3A98 :                     		; card is finished moving into place is increased.
    3001/    3A98 : 41F8 D080           		lea	(v_titlecard).w,a0		; get title card elements
