(1)  164/    B1FC :                     
    4100/    B1FC :                     		include	"_incObj/sub ObjectFall & SpeedToPos.asm"
(1)    1/    B1FC :                     ; ===========================================================================
(1)    2/    B1FC :                     ; ---------------------------------------------------------------------------
(1)    3/    B1FC :                     ; Subroutine to make an object fall downwards, increasingly fast
(1)    4/    B1FC :                     ; ---------------------------------------------------------------------------
(1)    5/    B1FC : =$38                 gravity:	equ	$38				; gravity constant used by many objects
(1)    6/    B1FC :                     ; ---------------------------------------------------------------------------
(1)    7/    B1FC :                     
(1)    8/    B1FC :                     ObjectFall:
(1)    9/    B1FC : 4CA8 0005 0010      		movem.w	obVelX(a0),d0/d2			; load X and Y speed to d0/d2
(1)   10/    B202 : E180                		asl.l	#8,d0					; shift velocity to line up with the middle 16 bits of the 32-bit position
(1)   11/    B204 : D1A8 0008           		add.l	d0,obX(a0)				; add X speed to X position (note this affects the subpixel position)
(1)   12/    B208 : E182                		asl.l	#8,d2					; shift velocity to line up with the middle 16 bits of the 32-bit position
(1)   13/    B20A : D5A8 000C           		add.l	d2,obY(a0)				; add Y speed to Y position (note this affects the subpixel position)
(1)   14/    B20E : 0668 0038 0012      		add.w	#$38,obVelY(a0)				; increase vertical speed (apply gravity)
(1)   15/    B214 : 4E75                		rts
(1)   16/    B216 :                     ; End of function ObjectFall
(1)   17/    B216 :                     
(1)   18/    B216 :                     
(1)   19/    B216 :                     ; ===========================================================================
(1)   20/    B216 :                     ; ---------------------------------------------------------------------------
(1)   21/    B216 :                     ; Subroutine translating object speed to update object position.
(1)   22/    B216 :                     ; Identical to ObjectFall, but without applying gravity.
(1)   23/    B216 :                     ; ---------------------------------------------------------------------------
(1)   24/    B216 :                     
(1)   25/    B216 :                     SpeedToPos:
(1)   26/    B216 : 4CA8 0005 0010      		movem.w	obVelX(a0),d0/d2			; load X and Y speed to d0/d2
(1)   27/    B21C : E180                		asl.l	#8,d0					; shift velocity to line up with the middle 16 bits of the 32-bit position
(1)   28/    B21E : D1A8 0008           		add.l	d0,obX(a0)				; add X speed to X position (note this affects the subpixel position)
(1)   29/    B222 : E182                		asl.l	#8,d2					; shift velocity to line up with the middle 16 bits of the 32-bit position
(1)   30/    B224 : D5A8 000C           		add.l	d2,obY(a0)				; add Y speed to Y position (note this affects the subpixel position)
(1)   31/    B228 : 4E75                		rts
(1)   32/    B22A :                     ; End of function SpeedToPos
(1)   33/    B22A :                     
    4101/    B22A :                     		include	"_incObj/sub DisplaySprite.asm"
(1)    1/    B22A :                     ; precalculated sprite queue offsets, eight in total, $80 bytes each
(1)    2/    B22A : AC00                DSpr_Layers:	dc.w v_spritequeue+($80*0)
(1)    3/    B22C : AC80                		dc.w v_spritequeue+($80*1)
(1)    4/    B22E : AD00                		dc.w v_spritequeue+($80*2)
(1)    5/    B230 : AD80                		dc.w v_spritequeue+($80*3)
(1)    6/    B232 : AE00                		dc.w v_spritequeue+($80*4)
(1)    7/    B234 : AE80                		dc.w v_spritequeue+($80*5)
(1)    8/    B236 : AF00                		dc.w v_spritequeue+($80*6)
