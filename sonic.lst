(1)   39/   127A6 :                     		; Each byte in v_time is treated individually in the format "00 0M SS FF", and it's updated right-to-left:
(1)   40/   127A6 :                     		;   FF (v_timecent) = frame counter for one second (increments seconds after crossing 60 and resets to 00, used internally only)
(1)   41/   127A6 :                     		;   SS (v_timesec)  = seconds (increments minutes after crossing 60 and resets to 00)
(1)   42/   127A6 :                     		;   0M (v_timemin)  = minutes (can't ever go above 9 due to time overs, so high nibble is unused)
(1)   43/   127A6 :                     		;   00              = unused (although it could be used for a hypothetical "hours" counter)
(1)   44/   127A6 :                     
(1)   45/   127A6 : 43F8 FE22           		lea	(v_time).w,a1			; load current time as pointer
(1)   46/   127AA : 0C99 0009 3B3B      		cmpi.l	#(9*$10000)+(59*$100)+59,(a1)+	; is the time 9:59:59? (and advance pointer by 4)
(1)   47/   127B0 : 677C                		beq.s	TimeOver			; if yes, kill Sonic from a time over
(1)   48/   127B2 :                     
