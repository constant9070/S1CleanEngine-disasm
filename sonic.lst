(1)    9/   12CDA :                     ; ---------------------------------------------------------------------------
(1)   10/   12CDA :                     
(1)   11/   12CDA :                     .chkscore:
(1)   12/   12CDA : 4A38 FE1F           		tst.b	(f_scorecount).w		; does the score need updating?
(1)   13/   12CDE : 6712                		beq.s	.chkrings			; if not, branch
(1)   14/   12CE0 : 4238 FE1F           		clr.b	(f_scorecount).w		; clear update flag
(1)   15/   12CE4 :                     
